@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(OpenSSL 3.0)
if(@LINUXCNC_TRANSPORT_BUILD_GRPC@)
  find_dependency(Threads)
  find_dependency(PkgConfig)
  pkg_check_modules(TRANSPORT_GRPC REQUIRED IMPORTED_TARGET grpc++)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/linuxcnc-transport-targets.cmake")
check_required_components(linuxcnc-transport)
