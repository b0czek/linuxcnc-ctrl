loadrt trivkins coordinates=XYZ
loadrt motmod base_period_nsec=0 servo_period_nsec=1000000 traj_period_nsec=4000000 num_joints=3 num_spindles=2
loadrt mux2 count=1
addf mux2.0 servo-thread
addf motion-command-handler servo-thread
addf motion-controller servo-thread
net Xpos joint.0.motor-pos-cmd => joint.0.motor-pos-fb
net Ycmd joint.1.motor-pos-cmd => mux2.0.in0
net Yfb mux2.0.out => joint.1.motor-pos-fb
net Zpos joint.2.motor-pos-cmd => joint.2.motor-pos-fb
net estop-loop iocontrol.0.user-enable-out iocontrol.0.emc-enable-in
# Spindle 0 is released and its owner leaves at-speed false; spindle 1
# runs this program.
setp spindle.0.at-speed false
setp spindle.1.at-speed true
loadrt flipflop count=5
addf flipflop.0 servo-thread
addf flipflop.1 servo-thread
net amp-seen joint.1.amp-enable-out => flipflop.0.set
net other-home-seen joint.2.homing => flipflop.1.set
