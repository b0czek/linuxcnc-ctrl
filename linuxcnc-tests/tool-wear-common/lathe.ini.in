# A metric lathe shared by the tool wear and tool table tests.
# make-ini.sh writes each test's copy.

[EMC]
VERSION = 1.1
DEBUG = 0

[DISPLAY]
DISPLAY = ./test-ui.py
LATHE = 1

[RS274NGC]
PARAMETER_FILE = sim.var

[EMCMOT]
EMCMOT = motmod
COMM_TIMEOUT = 4.0
BASE_PERIOD = 0
SERVO_PERIOD = 1000000

[TASK]
TASK = milltask
CYCLE_TIME = 0.001

[HAL]
HALFILE = LIB:core_sim.hal

[TRAJ]
NO_FORCE_HOMING = 1
COORDINATES = X Z
LINEAR_UNITS = mm
ANGULAR_UNITS = degree
DEFAULT_LINEAR_VELOCITY = 30
MAX_LINEAR_VELOCITY = 100

[EMCIO]
TOOL_TABLE = tool.tbl
RANDOM_TOOLCHANGER = 0

[KINS]
KINEMATICS = trivkins
JOINTS = 3

[AXIS_X]
MIN_LIMIT = -300.0
MAX_LIMIT = 300.0
MAX_VELOCITY = 100
MAX_ACCELERATION = 1000.0

[JOINT_0]
TYPE = LINEAR
HOME = 0.0
MAX_VELOCITY = 100
MAX_ACCELERATION = 1000.0
MIN_LIMIT = -300.0
MAX_LIMIT = 300.0
FERROR = 1.0
MIN_FERROR = 0.25
HOME_SEQUENCE = 0

[AXIS_Z]
MIN_LIMIT = -300.0
MAX_LIMIT = 300.0
MAX_VELOCITY = 100
MAX_ACCELERATION = 1000.0

[JOINT_1]
# Y, not used on the lathe
TYPE = LINEAR
HOME = 0.0
MAX_VELOCITY = 100
MAX_ACCELERATION = 1000.0
HOME_SEQUENCE = 0

[JOINT_2]
TYPE = LINEAR
HOME = 0.0
MAX_VELOCITY = 100
MAX_ACCELERATION = 1000.0
MIN_LIMIT = -300.0
MAX_LIMIT = 300.0
FERROR = 1.0
MIN_FERROR = 0.25
HOME_SEQUENCE = 0
