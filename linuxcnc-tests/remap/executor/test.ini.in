[EMC]
VERSION = 1.1
DEBUG = 0x0

[DISPLAY]
DISPLAY = ./test-ui.py

[RS274NGC]
PARAMETER_FILE = sim.var
REMAP = M10 modalgroup=10 python=m10_execute
REMAP = M11 modalgroup=10 python=m11_execute
REMAP = M20 modalgroup=10 python=m20_transact
REMAP = M21 modalgroup=10 python=m21_non_hal

[PYTHON]
TOPLEVEL = toplevel.py
PATH_PREPEND = .
PATH_APPEND = @EMC2_HOME@/nc_files/remap_lib/python-stdglue/

[EMCMOT]
EMCMOT = motmod
COMM_TIMEOUT = 4.0
BASE_PERIOD = 0
SERVO_PERIOD = 1000000

[TASK]
TASK = milltask
CYCLE_TIME = 0.001

[HAL]
HALFILE = @EMC2_HOME@/tests/remap/remap-io/core_sim.hal

[TRAJ]
NO_FORCE_HOMING = 1
AXES = 3
COORDINATES = X Y Z
LINEAR_UNITS = mm
ANGULAR_UNITS = degree
DEFAULT_LINEAR_VELOCITY = 1
MAX_LINEAR_VELOCITY = 4

[EMCIO]
TOOL_TABLE = @EMC2_HOME@/tests/remap/remap-io/simpockets.tbl

[KINS]
KINEMATICS = trivkins
JOINTS = 3

[AXIS_X]
MIN_LIMIT = -40
MAX_LIMIT = 40
MAX_VELOCITY = 4
MAX_ACCELERATION = 1000

[JOINT_0]
TYPE = LINEAR
HOME = 0
MAX_VELOCITY = 4
MAX_ACCELERATION = 1000
MIN_LIMIT = -40
MAX_LIMIT = 40
FERROR = 0.05
MIN_FERROR = 0.01

[AXIS_Y]
MIN_LIMIT = -40
MAX_LIMIT = 40
MAX_VELOCITY = 4
MAX_ACCELERATION = 1000

[JOINT_1]
TYPE = LINEAR
HOME = 0
MAX_VELOCITY = 4
MAX_ACCELERATION = 1000
MIN_LIMIT = -40
MAX_LIMIT = 40
FERROR = 0.05
MIN_FERROR = 0.01

[AXIS_Z]
MIN_LIMIT = -40
MAX_LIMIT = 40
MAX_VELOCITY = 4
MAX_ACCELERATION = 1000

[JOINT_2]
TYPE = LINEAR
HOME = 0
MAX_VELOCITY = 4
MAX_ACCELERATION = 1000
MIN_LIMIT = -40
MAX_LIMIT = 40
FERROR = 0.05
MIN_FERROR = 0.01
