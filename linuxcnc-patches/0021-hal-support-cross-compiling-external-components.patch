diff --git a/docs/src/man/man1/halcompile.1.adoc b/docs/src/man/man1/halcompile.1.adoc
index 593be84..e688a75 100644
--- a/docs/src/man/man1/halcompile.1.adoc
+++ b/docs/src/man/man1/halcompile.1.adoc
@@ -74,6 +74,40 @@ Extra arguments passed to the C-compiler.
 *--extra-link-args*=_args_::
 Extra arguments passed to the linker.
 
+=== Cross-compilation options
+
+*--cross-prefix*=_prefix_::
+Use __prefix__**gcc**, __prefix__**ld** and __prefix__**objdump** to build.
+_prefix_ may include a directory, for example
+_/opt/sdk/bin/aarch64-linux-gnu-_. *--install* with this option requires
+*--sysroot*.
+*--sysroot*=_directory_::
+Compile and link against the target system in _directory_. LinuxCNC headers
+and libraries are taken from the target installation paths below
+_directory_. With *--install*, components are installed below *DESTDIR* when it
+is set in the environment, otherwise below _directory_. A run-in-place
+*Makefile.modinc* contains host paths, so when *halcompile* runs from a
+run-in-place build, *--modinc* must name the *Makefile.modinc* of the
+installed target LinuxCNC.
+*--cc*=_command_::
+C compiler. Overrides the compiler selected by *--cross-prefix*.
+*--ld*=_command_::
+Linker used for the relocatable link of realtime components. Overrides the
+linker selected by *--cross-prefix*.
+*--objdump*=_command_::
+*objdump* used to list exported realtime symbols. Overrides the one selected by
+*--cross-prefix*.
+*--make*=_command_::
+*make* program to run.
+*--modinc*=_file_::
+*Makefile.modinc* to build with instead of the one belonging to this
+*halcompile*.
+
+_command_ is the path of an executable, or a command with arguments, such as
+*--cc*="ccache aarch64-linux-gnu-gcc". Without these options, *halcompile*
+uses the compiler LinuxCNC was configured with and the host *ld* and
+*objdump*. *LD* and *OBJDUMP* in the environment are ignored.
+
 == DESCRIPTION
 
 *halcompile* performs many different functions:
diff --git a/src/Makefile.modinc.in b/src/Makefile.modinc.in
index 85bc79d..42db924 100644
--- a/src/Makefile.modinc.in
+++ b/src/Makefile.modinc.in
@@ -65,46 +65,92 @@ BUILDSYS = @BUILD_SYS@
 KERNELDIR := @KERNELDIR@
 CC := @CC@
 RTAI = @RTAI@
+prefix := @prefix@
+exec_prefix := @exec_prefix@
+EMC2_HOME=@EMC2_HOME@
+RUN_IN_PLACE=@RUN_IN_PLACE@
+# Only halcompile --sysroot selects a cross build; a SYSROOT exported by a
+# cross SDK environment must not turn a native build into one.
+ifneq ($(origin SYSROOT),command line)
+SYSROOT :=
+endif
+ifneq ($(SYSROOT),)
+ifeq ($(RUN_IN_PLACE),yes)
+$(error Cross compilation from a run-in-place build requires an installed target Makefile.modinc; pass --modinc=...)
+endif
+endif
 RTFLAGS = $(filter-out -ffast-math,@RTFLAGS@ @EXT_RTFLAGS@) -fno-fast-math $(call cc-option,-mieee-fp) -fno-unsafe-math-optimizations
-RTFLAGS := -O2 -Wall -Wextra -g -I. -I@RTDIR@/include $(RTFLAGS) -DRTAPI -D_GNU_SOURCE -Drealtime
+ifeq ($(SYSROOT),)
+ifeq ($(RUN_IN_PLACE),yes)
+RTAPI_INCLUDEDIR := @RTDIR@/include
+else
+RTAPI_INCLUDEDIR := @includedir@/linuxcnc
+endif
+else
+RTAPI_INCLUDEDIR := $(SYSROOT)@includedir@/linuxcnc
+endif
+ifeq ($(SYSROOT):$(RUN_IN_PLACE),:yes)
+HAL_INCLUDEDIR := $(EMC2_HOME)/include
+else
+HAL_INCLUDEDIR := $(RTAPI_INCLUDEDIR)
+endif
+RTFLAGS := -O2 -Wall -Wextra -g -I. -I"$(RTAPI_INCLUDEDIR)" $(RTFLAGS) -DRTAPI -D_GNU_SOURCE -Drealtime
 ifneq ($(KERNELRELEASE),)
 ifeq ($(RTARCH):$(RTAI):$(filter $(RTFLAGS),-msse),x86_64:3:)
 EXTRA_CFLAGS += -msse
 endif
 endif
 EXTRA_CFLAGS += -fno-builtin-sin -fno-builtin-cos -fno-builtin-sincos
-EMC2_HOME=@EMC2_HOME@
-RUN_IN_PLACE=@RUN_IN_PLACE@
 ifeq ($(RUN_IN_PLACE),yes)
-EXTRA_CFLAGS := $(RTFLAGS) -D__MODULE__ -I$(EMC2_HOME)/include
+EXTRA_CFLAGS := $(RTFLAGS) -D__MODULE__ -I"$(HAL_INCLUDEDIR)"
 RTLIBDIR := @EMC2_HOME@/rtlib
 LIBDIR := @EMC2_HOME@/lib
 else
-prefix := @prefix@
-EXTRA_CFLAGS := $(RTFLAGS) -D__MODULE__ -I@includedir@/linuxcnc
+EXTRA_CFLAGS := $(RTFLAGS) -D__MODULE__ -I"$(HAL_INCLUDEDIR)"
 RTLIBDIR := @EMC2_RTLIB_DIR@
 LIBDIR := @libdir@
 endif
+HAL_USER_BINDIR := @bindir@
+ifeq ($(SYSROOT),)
+HAL_USER_RPATH := $(LIBDIR)
+HAL_USER_SYSROOT :=
+else
+LIBDIR := $(SYSROOT)@libdir@
+HAL_USER_RPATH := @libdir@
+HAL_USER_SYSROOT := --sysroot="$(SYSROOT)"
+endif
 EXTRA_CFLAGS += -Wframe-larger-than=2560
+ifneq ($(SYSROOT),)
+EXTRA_CFLAGS += --sysroot="$(SYSROOT)"
+EXTRA_LDFLAGS += --sysroot="$(SYSROOT)"
+endif
 
 ifeq ($(BUILDSYS),kbuild)
 modules:
-	$(MAKE) KBUILD_EXTRA_SYMBOLS=$(RTLIBDIR)/Module.symvers -C $(KERNELDIR) SUBDIRS=`pwd` CC=$(CC) V=0 modules
+	$(MAKE) KBUILD_EXTRA_SYMBOLS="$(RTLIBDIR)/Module.symvers" -C "$(KERNELDIR)" SUBDIRS="$(CURDIR)" CC="$(CC)" V=0 modules
 
 clean:
 	rm *.ko *.mod.c *.o
 
 install:
-	cp $(patsubst %.o,%.ko,$(obj-m)) $(DESTDIR)$(RTLIBDIR)/
+	cp $(patsubst %.o,%.ko,$(obj-m)) "$(DESTDIR)$(RTLIBDIR)/"
 endif
 
 ifeq ($(BUILDSYS),uspace)
+# Like CC, use the build tools unless halcompile selects them explicitly;
+# an SDK environment may export target tools for an unrelated build.
+ifneq ($(origin LD),command line)
+LD := ld
+endif
+ifneq ($(origin OBJDUMP),command line)
+OBJDUMP := objdump
+endif
 EXTRA_CFLAGS += -DSIM -fPIC
 allmodules = $(patsubst %.o,%.so,$(obj-m))
 modules: $(allmodules)
 
 install: modules
-	cp $(allmodules) $(DESTDIR)$(RTLIBDIR)/
+	cp $(allmodules) "$(DESTDIR)$(RTLIBDIR)/"
 
 getobjs = $(if $(filter undefined, $(origin $(1)-objs)), $(1).o, $($(1)-objs))
 getsrcs = $(patsubst %.o,%.c,$(call getobjs,$(1)))
@@ -119,8 +165,8 @@ $(foreach mod,$(patsubst %.o,%,$(obj-m)),\
 .PHONY: %.so
 %.so:
 	$(ECHO) Linking $@
-	$(Q)ld -d -r -o $*.tmp $^
-	$(Q)objdump -w -j .rtapi_export -t $*.tmp \
+	$(Q)$(LD) -d -r -o $*.tmp $^
+	$(Q)$(OBJDUMP) -w -j .rtapi_export -t $*.tmp \
 	| awk 'BEGIN{print "{ global :"} /rtapi_exported_/{printf("%s;\n", substr($$6,16))} END{print "local : * ; };"}' \
 	> $*.ver
 	$(Q)$(CC) -shared -Wl,-Bsymbolic $(LDFLAGS) -Wl,--version-script,$*.ver -o $@ $^ -lm $(EXTRA_LDFLAGS)
@@ -130,4 +176,3 @@ endif
 ifeq ($(BUILDSYS),normal)
 $(error Makefile.modinc is only suitable for 'kbuild' kernels and 'uspace' systems)
 endif
