+def include_modinc(f, tempdir):
+    # Kbuild rereads this Makefile from the kernel tree, so the include
+    # must not depend on the current directory.
+    print("include %s" % make_path(os.path.join(tempdir, "Makefile.modinc")), file=f)
+    if cross_build():
+        print("ifeq ($(HAL_INCLUDEDIR),)", file=f)
+        print("$(error Makefile.modinc does not support cross compilation)", file=f)
