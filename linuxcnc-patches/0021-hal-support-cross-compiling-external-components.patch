+++ b/tests/halcompile/cross-tools/fake-make
@@ -0,0 +1,13 @@
+#!/bin/sh
+set -eu
+
+output=${HALCOMPILE_CROSS_TEST_OUTPUT:?}
+printf '%s\n' "$@" > "$output"
+while [ "$#" -gt 0 ]; do
+    if [ "$1" = -C ]; then
+        cd "$2"
+        break
+    fi
+    shift
+done
+touch cross_tools.so
diff --git a/tests/halcompile/cross-tools/modinc b/tests/halcompile/cross-tools/modinc
new file mode 100644
