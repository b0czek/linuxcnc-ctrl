diff --git a/tests/halcompile/cross-tools/test.sh b/tests/halcompile/cross-tools/test.sh
new file mode 100755
index 0000000000..e383e5ef36
--- /dev/null
+++ b/tests/halcompile/cross-tools/test.sh
@@ -0,0 +1,77 @@
+#!/bin/sh
+set -eu
+
+output=$PWD/make-arguments
+sysroot=$PWD/sysroot
+mkdir -p "$sysroot"
+HALCOMPILE_CROSS_TEST_OUTPUT=$output \
+halcompile --compile \
+    --make="$PWD/fake-make" \
+    --modinc="$PWD/modinc" \
+    --cross-prefix=aarch64-test-linux-gnu- \
+    --sysroot="$sysroot" \
+    cross_tools.comp
+
+grep -Fx -- "CC=aarch64-test-linux-gnu-gcc" "$output"
+grep -Fx -- "LD=aarch64-test-linux-gnu-ld" "$output"
+grep -Fx -- "OBJDUMP=aarch64-test-linux-gnu-objdump" "$output"
+grep -Fx -- "SYSROOT=$sysroot" "$output"
+test -f cross_tools.so
+
+HALCOMPILE_CROSS_TEST_OUTPUT=$output \
+halcompile --install \
+    --make="$PWD/fake-make" \
+    --modinc="$PWD/modinc" \
+    --cross-prefix=aarch64-test-linux-gnu- \
+    --sysroot="$sysroot" \
+    cross_tools.comp
+grep -Fx -- "DESTDIR=$sysroot" "$output"
+
+space_root=$(mktemp -d "$PWD/with space.XXXXXX")
+trap 'rm -rf -- "$space_root"' EXIT
+cp "$(halcompile --print-modinc)" "$space_root/Makefile.modinc"
+cp cross_tools.comp "$space_root/cross_tools.comp"
+for tool in gcc ld objdump; do
+    ln -s "$(command -v "$tool")" "$space_root/cross-$tool"
+done
+(
+    cd "$space_root"
+    halcompile --compile \
+        --modinc="$space_root/Makefile.modinc" \
+        --cross-prefix="$space_root/cross-" \
+        cross_tools.comp
+)
+test -s "$space_root/cross_tools.so"
+
+if halcompile --compile --sysroot="$sysroot" cross_tools.comp \
+        >"$space_root/rip-cross-output" 2>&1; then
+    echo "cross compilation unexpectedly accepted a run-in-place Makefile.modinc" >&2
+    exit 1
+fi
+grep -F 'requires an installed target Makefile.modinc' "$space_root/rip-cross-output"
+
+mkdir -p "$space_root/kernel dir" "$space_root/module dir"
+cat > "$space_root/kernel dir/Makefile" <<'EOF'
+modules:
+	@$(CC) --version > "$(CHECK_OUTPUT)"
+	@printf '%s\n' '$(KBUILD_EXTRA_SYMBOLS)' '$(SUBDIRS)' >> "$(CHECK_OUTPUT)"
+EOF
+(
+    cd "$space_root/module dir"
+    make -s -f "$space_root/Makefile.modinc" modules \
+        BUILDSYS=kbuild KERNELDIR="$space_root/kernel dir" \
+        RTLIBDIR="$space_root/rt lib" CC="'$space_root/cross-gcc'" \
+        CHECK_OUTPUT="$space_root/kbuild-output"
+)
+test -s "$space_root/kbuild-output"
+grep -Fx -- "$space_root/rt lib/Module.symvers" "$space_root/kbuild-output"
+grep -Fx -- "$space_root/module dir" "$space_root/kbuild-output"
+
+(
+    cd "$space_root"
+    halcompile --compile \
+        --modinc="$space_root/Makefile.modinc" \
+        --cc="env gcc" \
+        cross_tools.comp
+)
+test -s "$space_root/cross_tools.so"
