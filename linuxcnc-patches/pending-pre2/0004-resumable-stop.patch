-        emcmotStatus->atspeed_next_feed = emcmotCommand->wait_for_spindle_at_speed;
+        if (emcmotCommand->wait_for_spindle_at_speed !=
+                EMCMOT_SPINDLE_AT_SPEED_PRESERVE) {
+            emcmotStatus->atspeed_next_feed =
+                emcmotCommand->wait_for_spindle_at_speed;
+        }
 
        // check whether it's passed correctly
        if (!emcmotStatus->atspeed_next_feed){
