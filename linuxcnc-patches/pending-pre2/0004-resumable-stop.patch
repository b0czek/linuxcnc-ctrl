+#!/bin/bash -e
+
+set -o pipefail
+
+if nm -D -u "$EMC2_HOME/rtlib/motmod.so" | grep -q '[[:space:]]tpStop$'; then
+    echo "motmod unexpectedly requires the nonstandard tpStop symbol" >&2
+    exit 1
+fi
+
+scenarios=(
+    idle-rejected
+    ordinary
+    single-step
+    rapid-no-atspeed
+    paused-resume
+    paused-run
+    abort-empty
+    queued-g33
+    g33
+    fperrev
+    g76
+    rigid-tap
+    orientation
+    dwell
+    multi-spindle
+    css
+)
+
+scenario_log=$(mktemp)
+trap 'rm -f "$scenario_log"' EXIT
+
+for scenario in "${scenarios[@]}"; do
+    echo "Running resumable-stop scenario: $scenario"
+    : > "$scenario_log"
+    RESUMABLE_STOP_SCENARIO="$scenario" linuxcnc -r test.ini 2>&1 |
+        tee "$scenario_log"
+    if grep -Eq 'ruckig_plan_(position|velocity): invalid limits|Ruckig (velocity control )?planning failed' "$scenario_log"; then
+        echo "$scenario emitted a Ruckig invalid-limit or planning failure" >&2
+        exit 1
+    fi
+done
+echo "resumable stop scenarios complete"
