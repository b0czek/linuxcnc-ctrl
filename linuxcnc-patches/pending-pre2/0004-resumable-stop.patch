 	    emcmotStatus->stepping = 0;
+	    emcmotInternal->coord_tp.stopping = 0;
+	    emcmotInternal->coord_tp.stop_tc = 0;
 	    tpResume(&emcmotInternal->coord_tp);
 	    emcmotStatus->paused = 0;
+	    emcmotStatus->stopped = 0;
 	    break;
 
 	case EMCMOT_STEP:
@@ -1665,7 +1680,11 @@ void emcmotCommandHandler_locked(void *arg, long servo_period)
             }
             apply_spindle_limits(&emcmotStatus->spindle_status[n]);
