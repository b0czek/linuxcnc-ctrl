 	    } else if (GET_MOTION_COORD_FLAG()) {
+		emcmotInternal->coord_tp.stopping = 0;
+		emcmotInternal->coord_tp.stop_tc = 0;
+		emcmotStatus->stopped = 0;
 		tpAbort(&emcmotInternal->coord_tp);
 	    } else {
 		for (joint_num = 0; joint_num < ALL_JOINTS; joint_num++) {
@@ -1221,6 +1224,15 @@ void emcmotCommandHandler_locked(void *arg, long servo_period)
 	    emcmotStatus->paused = 1;
 	    break;
 
+	case EMCMOT_STOP:
+	    rtapi_print_msg(RTAPI_MSG_DBG, "STOP");
+	    emcmotInternal->coord_tp.stopping = 1;
+	    emcmotInternal->coord_tp.stop_tc = 0;
+	    tpPause(&emcmotInternal->coord_tp);
+	    emcmotStatus->paused = 1;
+	    emcmotStatus->stopped = 0;
+	    break;
+
 	case EMCMOT_REVERSE:
 	    /* run motion in reverse*/
 	    /* only allowed during a pause */
@@ -1240,8 +1252,11 @@ void emcmotCommandHandler_locked(void *arg, long servo_period)
 	    /* can happen at any time */
