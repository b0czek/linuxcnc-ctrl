new file mode 100755
index 0000000000..56f319c1fe
--- /dev/null
+++ b/tests/css-status/checkresult
@@ -0,0 +1,4 @@
+#!/bin/sh
+set -e
+
+grep -q '^CSS status scenario ok$' "$1"
