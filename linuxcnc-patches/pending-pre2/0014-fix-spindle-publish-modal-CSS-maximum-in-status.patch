index 0000000000..e244f001df
--- /dev/null
+++ b/tests/css-status/core_sim.hal
@@ -0,0 +1,10 @@
+loadrt trivkins
+loadrt motmod base_period_nsec=0 servo_period_nsec=1000000 num_joints=1 num_spindles=1
+
+addf motion-command-handler servo-thread
+addf motion-controller servo-thread
