+
+typedef struct rtmod_path {
+    char **dirs;
+    size_t count;
+} rtmod_path_t;
+
+/* Parse HAL_RTMOD_PATH (or use EMC2_RTLIB_DIR when env_path is NULL),
+   normalize duplicate trailing slashes, and enforce the compiled trust set. */
+int rtmod_path_init(rtmod_path_t *path, const char *env_path,
+                    char *error, size_t error_size);
+void rtmod_path_free(rtmod_path_t *path);
+
+/* Resolve name+MODULE_EXT.  core_module restricts lookup to EMC2_RTLIB_DIR. */
+int rtmod_path_resolve(const rtmod_path_t *path, const char *name,
+                       int core_module, char *result, size_t result_size,
+                       char *error, size_t error_size);
+
+int rtmod_name_valid(const char *name);
+int rtmod_path_is_trusted_file(const char *filename, char *module_name,
+                               size_t module_name_size);
+int rtmod_path_is_trusted_module(const char *name);
+
+#ifdef __cplusplus
+}
