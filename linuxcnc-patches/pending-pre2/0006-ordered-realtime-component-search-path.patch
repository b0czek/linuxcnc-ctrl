 AC_DEFINE_UNQUOTED([EMC2_DEFAULT_TOOLTABLE], "$DEFAULT_TOOLTABLE", [Default nml file])
 
+AC_ARG_WITH([extra-rtlib-dirs],
+    AS_HELP_STRING([--with-extra-rtlib-dirs=DIR[:DIR...]],
+                   [additional trusted realtime component directories]),
+    [EXTRA_RTLIB_DIRS="$withval"], [EXTRA_RTLIB_DIRS=""])
+if test -n "$EXTRA_RTLIB_DIRS"; then
+    old_IFS=$IFS
+    IFS=:
+    for rtlib_dir in $EXTRA_RTLIB_DIRS; do
+        case "$rtlib_dir" in
+            /*) ;;
+            *) AC_MSG_ERROR([--with-extra-rtlib-dirs entries must be non-empty absolute paths]) ;;
+        esac
+    done
+    IFS=$old_IFS
+    case "$EXTRA_RTLIB_DIRS" in *::*|:*|*:) AC_MSG_ERROR([--with-extra-rtlib-dirs contains an empty entry]) ;; esac
+fi
+AC_DEFINE_UNQUOTED([EMC2_EXTRA_RTLIB_DIRS], ["$EXTRA_RTLIB_DIRS"],
+                   [Additional trusted realtime component directories])
+AC_SUBST([EXTRA_RTLIB_DIRS])
+
 ##############################################################################
 # Subsection 3.4 - define default dirs, these get used in a lot of places    #
 # we decide based on RIP or install where stuff goes                         #
