+#!/bin/bash -e
+
+for scenario in success failure timeout abort; do
+    echo "Running executor remap scenario: ${scenario}"
+    EXECUTOR_SCENARIO="${scenario}" linuxcnc -r test.ini
+done
+
+echo "executor remap scenarios complete"
