+
 import emccanon
 from interpreter import *
 from emccanon import MESSAGE
@@ -40,6 +43,254 @@ def build_hal(self):
     except Exception as e:
         print(e)
 
+
+EXECUTOR_SUCCEEDED = "succeeded"
+EXECUTOR_FAILED = "failed"
+EXECUTOR_CANCELLED = "cancelled"
+EXECUTOR_TIMED_OUT = "timed-out"
+
+EXECUTOR_STATE_UNAVAILABLE = 0
+EXECUTOR_STATE_IDLE = 1
+EXECUTOR_STATE_ACCEPTED = 2
+EXECUTOR_STATE_RUNNING = 3
+EXECUTOR_STATE_SUCCEEDED = 4
+EXECUTOR_STATE_FAILED = 5
+EXECUTOR_STATE_CANCELLED = 6
+
+_EXECUTOR_DEFAULT_TIMEOUT = 10.0
+_EXECUTOR_POLL_INTERVAL = 0.01
+
+
+class ExecutorResponse:
+    """Transport-independent terminal result returned by an executor."""
+
+    def __init__(self, outcome, result=None, message=None):
+        self.outcome = outcome
+        self.result = result
+        self.message = message
+
+    @property
+    def succeeded(self):
+        return self.outcome == EXECUTOR_SUCCEEDED
+
+
+def _executor_timeout(timeout):
+    return ExecutorResponse(
+        EXECUTOR_TIMED_OUT,
+        message="timed out after %.3f seconds" % timeout,
+    )
+
+
+def executor_transact(
+    self,
+    endpoint,
+    request,
+    timeout=_EXECUTOR_DEFAULT_TIMEOUT,
+):
+    """Run one request and return its terminal response without judging it.
+
+    An endpoint's begin(request) method returns an operation with nonblocking
+    poll(), release(), and cancel() methods. poll() returns None while pending
+    and an ExecutorResponse at completion. The operation is released after any
+    terminal response and cancelled on timeout, interpreter error, or abort.
+    """
+
+    if not self.task:
+        return ExecutorResponse(EXECUTOR_SUCCEEDED)
+
+    try:
+        timeout = float(timeout)
+    except (TypeError, ValueError):
+        raise ValueError("executor timeout must be a number")
+    if not math.isfinite(timeout) or timeout <= 0.0:
+        raise ValueError("executor timeout must be finite and greater than zero")
+
+    operation = None
+    finalized = False
+    try:
+        operation = endpoint.begin(request)
+        deadline = time.monotonic() + timeout
+
+        while True:
+            remaining = deadline - time.monotonic()
+            if remaining <= 0.0:
+                finalized = True
+                operation.cancel()
+                return _executor_timeout(timeout)
+
+            response = operation.poll()
+            if response is not None:
+                if not isinstance(response, ExecutorResponse):
+                    raise TypeError(
+                        "executor poll() must return None or ExecutorResponse"
+                    )
+                if time.monotonic() >= deadline:
+                    finalized = True
+                    operation.cancel()
+                    return _executor_timeout(timeout)
+                finalized = True
+                operation.release()
+                return response
+
+            emccanon.DWELL(min(_EXECUTOR_POLL_INTERVAL, remaining))
+            yield INTERP_EXECUTE_FINISH
+    finally:
+        if operation is not None and not finalized:
+            finalized = True
+            operation.cancel()
+
+
+def executor_execute(
+    self,
+    endpoint,
+    request,
+    timeout=_EXECUTOR_DEFAULT_TIMEOUT,
+):
+    """Run one request and turn every non-success outcome into an error."""
+
+    endpoint_name = getattr(endpoint, "name", type(endpoint).__name__)
+    try:
+        response = yield from executor_transact(
+            self,
+            endpoint,
+            request,
+            timeout=timeout,
+        )
+    except Exception as error:
+        self.set_errormsg("executor '%s': %s" % (endpoint_name, error))
+        yield INTERP_ERROR
+        return
+
+    if response.succeeded:
+        return response
+
+    message = response.message
+    if not message:
+        message = "%s with result %s" % (response.outcome, response.result)
+    self.set_errormsg("executor '%s': %s" % (endpoint_name, message))
+    yield INTERP_ERROR
+
+
+class HalExecutor:
+    """HAL endpoint using pins added to a caller-owned component.
+
+    The caller is responsible for constructing the component before this
+    endpoint, retaining it, and calling ready() after all endpoints and custom
+    pins have been added.
+    """
+
+    def __init__(self, interpreter, name, component):
+        self.name = str(name)
+        self._component = component
+        self._prefix = "executor.%s." % self.name
+        self._active = False
+        self._active_request_id = 0
+        self._next_request_id = 1
+        self._enabled = bool(interpreter.task)
+
+        if not self._enabled:
+            return
+        if component is None:
+            raise ValueError("a task HalExecutor requires a HAL component")
+
+        import hal
+
+        component.newpin(self._prefix + "request-id", hal.HAL_U32, hal.HAL_OUT)
+        component.newpin(self._prefix + "opcode", hal.HAL_S32, hal.HAL_OUT)
+        component.newpin(self._prefix + "request", hal.HAL_BIT, hal.HAL_OUT)
+        component.newpin(self._prefix + "cancel", hal.HAL_BIT, hal.HAL_OUT)
+        component.newpin(self._prefix + "response-id", hal.HAL_U32, hal.HAL_IN)
+        component.newpin(self._prefix + "state", hal.HAL_S32, hal.HAL_IN)
+        component.newpin(self._prefix + "result", hal.HAL_S32, hal.HAL_IN)
+
+        component[self._prefix + "request-id"] = 0
+        component[self._prefix + "opcode"] = 0
+        component[self._prefix + "request"] = False
+        component[self._prefix + "cancel"] = False
+
+    def begin(self, request):
+        if not self._enabled:
+            raise RuntimeError("preview executor requests are not started")
+        if self._active:
+            raise RuntimeError("another request is already active")
+
+        try:
+            opcode = int(request)
+        except (TypeError, ValueError):
+            raise ValueError("HAL executor request must be an integer opcode")
+        if opcode < -2147483648 or opcode > 2147483647:
+            raise ValueError("HAL executor opcode is outside the s32 range")
+
+        request_id = self._next_request_id
+        self._next_request_id = (request_id + 1) & 0xFFFFFFFF
+        if self._next_request_id == 0:
+            self._next_request_id = 1
+
+        self._active = True
+        self._active_request_id = request_id
+        try:
+            self._component[self._prefix + "cancel"] = False
+            self._component[self._prefix + "request-id"] = request_id
+            self._component[self._prefix + "opcode"] = opcode
+            self._component[self._prefix + "request"] = True
+        except Exception:
+            self._active = False
+            self._active_request_id = 0
+            raise
+
+        return _HalExecutorOperation(self, request_id)
+
+    def _poll(self, request_id):
+        if int(self._component[self._prefix + "response-id"]) != request_id:
+            return None
+
+        state = int(self._component[self._prefix + "state"])
+        result = int(self._component[self._prefix + "result"])
+        if state == EXECUTOR_STATE_SUCCEEDED:
+            return ExecutorResponse(EXECUTOR_SUCCEEDED, result=result)
+        if state == EXECUTOR_STATE_FAILED:
+            return ExecutorResponse(EXECUTOR_FAILED, result=result)
+        if state == EXECUTOR_STATE_CANCELLED:
+            return ExecutorResponse(EXECUTOR_CANCELLED, result=result)
+        return ExecutorResponse(
+            EXECUTOR_FAILED,
+            result=result,
+            message="response %d used non-terminal state %d" % (request_id, state),
+        )
+
+    def _finish(self, request_id, cancel):
+        if not self._active or self._active_request_id != request_id:
+            return
+        if cancel:
+            self._component[self._prefix + "cancel"] = True
+        self._component[self._prefix + "request"] = False
+        self._active = False
+        self._active_request_id = 0
+
+
+class _HalExecutorOperation:
+    def __init__(self, endpoint, request_id):
+        self._endpoint = endpoint
+        self._request_id = request_id
+        self._closed = False
+
+    def poll(self):
+        if self._closed:
+            raise RuntimeError("executor operation is already closed")
+        return self._endpoint._poll(self._request_id)
+
+    def release(self):
+        if self._closed:
+            return
+        self._closed = True
+        self._endpoint._finish(self._request_id, cancel=False)
+
+    def cancel(self):
+        if self._closed:
+            return
+        self._closed = True
+        self._endpoint._finish(self._request_id, cancel=True)
+
 # REMAP=S   prolog=setspeed_prolog  ngc=setspeed epilog=setspeed_epilog
