 		    frame->pystuff.impl->py_return_type = RET_STOPITERATION;
 		    bp::handle_exception();
 		    PyErr_Clear();
+		    frame->pystuff.impl->generator_next = bp::object();
+		    frame->pystuff.impl->generator = bp::object();
 		    logPy("pycall: call generator - StopIteration exception");
 		    return INTERP_OK;
 		} else  {
@@ -194,6 +196,7 @@ int Interp::pycall(setup_pointer /*settings*/,
 
 		    // a generator was returned. This must have been the first time call to a handler
 		    // which contains a yield. Extract next() method.
+		    frame->pystuff.impl->generator = retval;
 		    frame->pystuff.impl->generator_next = bp::getattr(retval, "__next__");
 		    // and  call it for the first time.
 		    // Expect execution up to first 'yield INTERP_EXECUTE_FINISH'.
@@ -299,3 +302,24 @@ pycontext &pycontext::operator=(const pycontext &other) {
     impl = new pycontext_impl(*other.impl);
     return *this;
 }
+
+void pycontext::close_generator()
+{
+    if (!impl->generator.ptr() || impl->generator.ptr() == Py_None)
+        return;
+
+    try {
+        impl->generator.attr("close")();
+    } catch (bp::error_already_set &) {
+        std::string msg;
+        if (PyErr_Occurred())
+            msg = handle_pyerror();
+        bp::handle_exception();
+        PyErr_Clear();
+        fprintf(stderr, "error closing aborted Python remap generator: %s\n",
+                msg.c_str());
+    }
+
+    impl->generator_next = bp::object();
+    impl->generator = bp::object();
+}
