diff --git a/docs/src/remap/remap.adoc b/docs/src/remap/remap.adoc
index b263f1e959..5bb208e611 100644
--- a/docs/src/remap/remap.adoc
+++ b/docs/src/remap/remap.adoc
@@ -324,7 +324,7 @@ there is the somewhat easier way of <<remap:python-o-word-procs,calling Python f
 The argument specification (keyword `argspec`) describes required and optional words to be passed to an ngc procedure,
 as well as optional preconditions for that code to execute.
 
-An argspec consists of 0 or more characters of the class `[@A-KMNP-Za-kmnp-z^>]`.
+An argspec consists of 0 or more characters of the class `[$@A-KMNP-Za-kmnp-z^>]`.
 It can by empty (like `argspec=`).
 
 An empty argspec, or no argspec argument at all implies the remapped code does not receive any parameters from the block.
@@ -359,9 +359,17 @@ TIP: this helps with packaging existing NGC procedures as remapped codes.
 Existing procedures do expect positional parameters.
 With the `@` option, you can avoid rewriting them to refer to local named parameters.
 
+`$`::
+  Passes the block's optional spindle selector as the local named parameter `spindle`.
+  For a Python handler, the value is available as `words["spindle"]`.
+  If the block does not contain a `$` selector, the parameter is omitted.
+  The remap is responsible for deciding which spindle values it supports.
+
 `^`::
-  The `^` (caret) character specifies that the current spindle speed must be greater than zero (spindle running),
+  The `^` (caret) character specifies that the selected spindle speed must be greater than zero (spindle running),
   otherwise the code fails with an appropriate error message.
+  A `$` word on the block selects the spindle; without one, spindle 0 is used.
+  `$-1` is invalid with `^` because the precondition passes one spindle's speed as `s`.
 
 `>`::
   The `>` (greater-than) character specifies that the current feed must be greater than zero,
diff --git a/src/emc/rs274ngc/interp_remap.cc b/src/emc/rs274ngc/interp_remap.cc
index c33df5a316..b13bdc0a5e 100644
--- a/src/emc/rs274ngc/interp_remap.cc
+++ b/src/emc/rs274ngc/interp_remap.cc
@@ -206,6 +206,7 @@ int Interp::convert_remapped_code(block_pointer /*block*/,
 // 4. handle '>' as to require a positive feed.
 // 5. handle '^' as to require a positive speed.
 // 6. handle 'N' as to add the line number.
+// 7. handle '$' as an optional spindle selector.
 //
 // return INTERP_ERROR and propagate appropriate message if any errors so far
 // else return INTERP_OK
@@ -332,6 +333,10 @@ int Interp::add_parameters(setup_pointer settings,
 	case 'x' : PARAM('x',"x",block->x_flag,block->x_number); break;
 	case 'y' : PARAM('y',"y",block->y_flag,block->y_number); break;
 	case 'z' : PARAM('z',"z",block->z_flag,block->z_number); break;
+	case '$' :
+	    if (block->dollar_flag)
+		STORE("spindle", block->dollar_number);
+	    break;
 	case '-' : break; // ignore - backwards compatibility
 	default: ;
 	}
@@ -367,10 +372,12 @@ int Interp::add_parameters(setup_pointer settings,
     }
 
     // ^...require positive speed
-    // FIXME: How do we decide which spindle they want to use? (andypugh 17/7/16)
     if (required.find_first_of('^') != std::string::npos) {
-        if (settings->speed[0] > 0.0) {
-            STORE("s", settings->speed[0]);
+        const int spindle = block->dollar_flag ? block->dollar_number : 0;
+        CHKS((spindle < 0 || spindle >= settings->num_spindles),
+             _("Invalid spindle ($) number in remap speed precondition"));
+        if (settings->speed[spindle] > 0.0) {
+            STORE("s", settings->speed[spindle]);
         }
         else {
             tail += "S>0,";
@@ -461,7 +468,7 @@ int Interp::parse_remap(const char *inistring, int lineno)
 	}
 	if (!strncasecmp(kw,"argspec",kwlen)) {
 	    size_t pos = strspn (arg,
-				 "ABCDEFGHIJKLMNPQRSTUVWXYZabcdefghijklmnpqrstuvwxyz>^@");
+				 "ABCDEFGHIJKLMNPQRSTUVWXYZabcdefghijklmnpqrstuvwxyz>^@$");
 	    if (pos != strlen(arg)) {
 		Error("argspec: illegal word '%c' - %d:REMAP = %s",
 		      arg[pos],lineno,inistring);
