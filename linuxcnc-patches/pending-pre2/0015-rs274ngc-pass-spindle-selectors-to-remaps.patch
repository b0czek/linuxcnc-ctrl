diff --git a/tests/remap/dollar-argspec/m501.ngc b/tests/remap/dollar-argspec/m501.ngc
new file mode 100644
index 0000000000..e5495df885
--- /dev/null
+++ b/tests/remap/dollar-argspec/m501.ngc
@@ -0,0 +1,9 @@
+o<m501> sub
+o100 if [EXISTS[#<spindle>]]
+    (debug, NGC spindle=#<spindle>)
+o100 else
+    (debug, NGC spindle omitted)
+o100 endif
+o<m501> endsub
+m2
+%
diff --git a/tests/remap/dollar-argspec/m502.ngc b/tests/remap/dollar-argspec/m502.ngc
new file mode 100644
index 0000000000..600c9a95f4
--- /dev/null
+++ b/tests/remap/dollar-argspec/m502.ngc
@@ -0,0 +1,5 @@
+o<m502> sub
+(debug, positional n_args=#<n_args> P=#1 spindle=#2)
+o<m502> endsub
+m2
+%
diff --git a/tests/remap/dollar-argspec/remap.py b/tests/remap/dollar-argspec/remap.py
new file mode 100644
index 0000000000..95f0e7b8e9
--- /dev/null
+++ b/tests/remap/dollar-argspec/remap.py
@@ -0,0 +1,10 @@
+def m500(self, **words):
+    spindle = words.get("spindle", "omitted")
+    if spindle != "omitted":
+        spindle = int(spindle)
+    print("M500 Python P={} spindle={}".format(int(words["p"]), spindle))
+
+
+def m503(self, **words):
+    spindle = int(words.get("spindle", 0))
+    print("M503 Python spindle={} speed={}".format(spindle, int(words["s"])))
diff --git a/tests/remap/dollar-argspec/test.ini b/tests/remap/dollar-argspec/test.ini
new file mode 100644
index 0000000000..36abfcbc62
--- /dev/null
+++ b/tests/remap/dollar-argspec/test.ini
@@ -0,0 +1,18 @@
+[EMC]
+DEBUG=0
+
+[RS274NGC]
+SUBROUTINE_PATH = .
+LOG_LEVEL=0
+OWORD_NARGS = 1
+REMAP=M500 py=m500 modalgroup=10 argspec=P$
+REMAP=M501 ngc=m501 modalgroup=10 argspec=$
+REMAP=M502 ngc=m502 modalgroup=10 argspec=@P$
+REMAP=M503 py=m503 modalgroup=10 argspec=^$
+
+[TRAJ]
+SPINDLES=3
+
+[PYTHON]
+PATH_PREPEND=.
+TOPLEVEL=toplevel.py
diff --git a/tests/remap/dollar-argspec/test.ngc b/tests/remap/dollar-argspec/test.ngc
new file mode 100644
