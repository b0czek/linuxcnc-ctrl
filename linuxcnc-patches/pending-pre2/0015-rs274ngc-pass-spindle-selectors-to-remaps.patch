--- /dev/null
+++ b/tests/remap/dollar-argspec/test.ngc
@@ -0,0 +1,11 @@
+M500 P0
+M500 P1 $1
+M500 P2 $-1
+M501
+M501 $2
+M502 P7 $1
+S1000
+S2000 $1
+M503
+M503 $1
+M2
