+namespace {
+double *pose_axes(EmcPose &pose, int axis)
+{
+    switch (axis) {
+    case 0: return &pose.tran.x;
+    case 1: return &pose.tran.y;
+    case 2: return &pose.tran.z;
+    case 3: return &pose.a;
+    case 4: return &pose.b;
+    case 5: return &pose.c;
+    case 6: return &pose.u;
+    case 7: return &pose.v;
+    case 8: return &pose.w;
+    default: return nullptr;
+    }
+}
+
+const double *pose_axes(const EmcPose &pose, int axis)
+{
+    return pose_axes(const_cast<EmcPose &>(pose), axis);
+}
+
+int find_tool(const CANON_TOOL_TABLE *table, int last, int toolno,
+              bool random)
+{
+    int spindle = -1;
+    for (int idx = 0; idx <= last; ++idx) {
+        if (table[idx].toolno != toolno) continue;
+        if (idx != 0 || random) return idx;
+        spindle = idx;
+    }
+    return spindle;
+}
+
+bool valid_table(const CANON_TOOL_TABLE *table, int last, bool random)
+{
+    for (int idx = random ? 0 : 1; idx <= last; ++idx) {
+        const auto &entry = table[idx];
+        if (entry.toolno < 0) continue;
+        if (entry.pocketno < 0 || entry.pocketno >= CANON_POCKETS_MAX ||
+            entry.orientation < 0 || entry.orientation > 9 ||
+            !isfinite(entry.diameter) || entry.diameter < 0.0 ||
+            !isfinite(entry.frontangle) || !isfinite(entry.backangle)) return false;
+        for (int axis = 0; axis < 9; ++axis) {
+            if (!isfinite(*pose_axes(entry.offset, axis)) ||
+                !isfinite(*pose_axes(entry.wear_offset, axis))) return false;
+        }
+        for (int other = idx + 1; other <= last; ++other) {
+            if (table[other].toolno < 0) continue;
+            if (table[other].toolno == entry.toolno ||
+                (random && table[other].pocketno == entry.pocketno)) return false;
+        }
+    }
+    return true;
+}
+}
