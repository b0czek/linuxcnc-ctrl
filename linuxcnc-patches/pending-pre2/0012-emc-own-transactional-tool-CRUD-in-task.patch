+int Task::emcToolUpdate(const EMC_TOOL_UPDATE &update)
+{
+    const char *comment_end = static_cast<const char *>(
+        memchr(update.comment, '\0', sizeof(update.comment)));
+    const size_t comment_length = comment_end
+        ? static_cast<size_t>(comment_end - update.comment)
+        : sizeof(update.comment);
+    if (!tooltable_filename || update.toolno <= 0 ||
+        (update.fields & ~0xff) ||
+        update.orientation < 0 || update.orientation > 9 ||
+        update.offset_axes & ~0x1ff || update.wear_offset_axes & ~0x1ff ||
+        !comment_end ||
+        memchr(update.comment, '\n', comment_length) ||
+        memchr(update.comment, '\r', comment_length)) return -1;
+    if ((update.fields & EMC_TOOL_UPDATE_DIAMETER) &&
+        (!isfinite(update.diameter) || update.diameter < 0.0)) return -1;
+    if ((update.fields & EMC_TOOL_UPDATE_FRONTANGLE) && !isfinite(update.frontangle)) return -1;
+    if ((update.fields & EMC_TOOL_UPDATE_BACKANGLE) && !isfinite(update.backangle)) return -1;
+    for (int axis = 0; axis < 9; ++axis) {
+        if ((update.offset_axes & (1 << axis)) &&
+            !isfinite(*pose_axes(update.offset, axis))) return -1;
+        if ((update.wear_offset_axes & (1 << axis)) &&
+            !isfinite(*pose_axes(update.wear_offset, axis))) return -1;
+    }
+
+    CANON_TOOL_TABLE previous[CANON_POCKETS_MAX];
+    CANON_TOOL_TABLE table[CANON_POCKETS_MAX];
+    int previous_last = 0;
+    if (tooldata_snapshot(previous, &previous_last)) return -1;
+    memcpy(table, previous, sizeof(table));
+    int last = previous_last;
+    int idx = find_tool(table, last, update.toolno, random_toolchanger);
+    const bool creating = idx < 0;
+    if (creating && !(update.fields & EMC_TOOL_UPDATE_POCKET)) return -1;
+
+    int destination = idx;
+    if (update.fields & EMC_TOOL_UPDATE_POCKET) {
+        if (update.pocket <= 0 || update.pocket >= CANON_POCKETS_MAX) return -1;
+        for (int other = 1; other <= last; ++other) {
+            if (other != idx && table[other].toolno >= 0 &&
+                table[other].pocketno == update.pocket) return -1;
+        }
+        const bool active = update.toolno == emcioStatus.tool.toolInSpindle ||
+                            idx == 0 || idx == emcioStatus.tool.pocketPrepped ||
+                            (iocontrol_data.tool_prepare && idx == iocontrol_data.tool_prep_index) ||
+                            iocontrol_data.tool_change;
+        if (!creating && table[idx].pocketno != update.pocket && active) return -1;
+        if (random_toolchanger) {
+            destination = update.pocket;
+            if (destination != idx && table[destination].toolno >= 0) return -1;
+            if (!creating && destination != idx && active) return -1;
+        }
+    }
+    if (creating && !random_toolchanger) {
+        destination = -1;
+        for (int candidate = 1; candidate <= last; ++candidate) {
+            if (table[candidate].toolno < 0) { destination = candidate; break; }
+        }
+        if (destination < 0) destination = last + 1;
+    }
+    const bool random_spindle_update =
+        random_toolchanger && !creating && idx == 0 && destination == 0;
+    if (destination < 0 || destination >= CANON_POCKETS_MAX ||
+        (destination == 0 && !random_spindle_update)) return -1;
+
+    CANON_TOOL_TABLE entry = creating ? tooldata_entry_init() : table[idx];
+    entry.toolno = update.toolno;
+    if (update.fields & EMC_TOOL_UPDATE_POCKET) entry.pocketno = update.pocket;
+    for (int axis = 0; axis < 9; ++axis) {
+        if (update.offset_axes & (1 << axis))
+            *pose_axes(entry.offset, axis) = *pose_axes(update.offset, axis);
+        if (update.wear_offset_axes & (1 << axis))
+            *pose_axes(entry.wear_offset, axis) = *pose_axes(update.wear_offset, axis);
+    }
+    if (update.fields & EMC_TOOL_UPDATE_DIAMETER) entry.diameter = update.diameter;
+    if (update.fields & EMC_TOOL_UPDATE_FRONTANGLE) entry.frontangle = update.frontangle;
+    if (update.fields & EMC_TOOL_UPDATE_BACKANGLE) entry.backangle = update.backangle;
+    if (update.fields & EMC_TOOL_UPDATE_ORIENTATION) entry.orientation = update.orientation;
+    if (update.fields & EMC_TOOL_UPDATE_COMMENT)
+        rtapi_strlcpy(entry.comment, update.comment, sizeof(entry.comment));
+
+    if (!creating && destination != idx) table[idx] = tooldata_entry_init();
+    table[destination] = entry;
+    if (destination > last) last = destination;
+    if (!random_toolchanger && emcioStatus.tool.toolInSpindle == update.toolno)
+        table[0] = entry;
+    if (tooldata_save_snapshot(tooltable_filename, table, last)) {
+        (void)tooldata_save_snapshot(tooltable_filename, previous,
+                                     previous_last);
+        return -1;
+    }
+    if (tooldata_replace(table, last)) {
+        (void)tooldata_save_snapshot(tooltable_filename, previous,
+                                     previous_last);
+        return -1;
+    }
+    return 0;
+}
+
+int Task::emcToolDelete(int toolno)
+{
+    if (!tooltable_filename || toolno <= 0 ||
+        toolno == emcioStatus.tool.toolInSpindle) return -1;
+    CANON_TOOL_TABLE previous[CANON_POCKETS_MAX];
+    CANON_TOOL_TABLE table[CANON_POCKETS_MAX];
+    int previous_last = 0;
+    if (tooldata_snapshot(previous, &previous_last)) return -1;
+    memcpy(table, previous, sizeof(table));
+    int last = previous_last;
+    const int idx = find_tool(table, last, toolno, random_toolchanger);
+    if (idx <= 0 || idx == emcioStatus.tool.pocketPrepped ||
