 } //tooldata_find_index_for_tool()
+
+int tooldata_snapshot(CANON_TOOL_TABLE *table, int *last_index)
+{
+    if (!the_table || !table || !last_index) return -1;
+    memcpy(table, the_table, CANON_POCKETS_MAX * sizeof(*table));
+    *last_index = CANON_POCKETS_MAX - 1;
+    return 0;
+}
+
+int tooldata_replace(const CANON_TOOL_TABLE *table, int last_index)
+{
+    if (!the_table || !table || last_index < 0 ||
+        last_index >= CANON_POCKETS_MAX) return -1;
+    memcpy(the_table, table, CANON_POCKETS_MAX * sizeof(*table));
+    return 0;
+}
