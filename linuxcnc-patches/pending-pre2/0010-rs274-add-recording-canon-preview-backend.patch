+}
+
+void RELOAD_TOOLDATA() {}
+void CLAMP_AXIS(CANON_AXIS) {}
+void UNCLAMP_AXIS(CANON_AXIS) {}
+void COMMENT(const char *) {}
+void MESSAGE(char *) {}
