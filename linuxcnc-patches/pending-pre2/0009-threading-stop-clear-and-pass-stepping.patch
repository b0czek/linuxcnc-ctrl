diff --git a/src/emc/motion/control.c b/src/emc/motion/control.c
index 0a5d550480..160c2dcd2c 100644
--- a/src/emc/motion/control.c
+++ b/src/emc/motion/control.c
@@ -1993,12 +1993,11 @@ static void output_to_hal(void)
     /*
      * Alternate trajectory planners only provide the established tpPause()
      * interface.  Treat a completed fallback pause as a completed Stop.  The
-     * default planner sets stop_tc while an active position-synchronized
-     * segment must finish, so do not complete Stop at an intermediate zero
-     * velocity in that case.
+     * default planner latches stop_target_pending while a selected segment
+     * must finish, so do not complete Stop at an intermediate zero velocity.
      */
     if (emcmotInternal->coord_tp.stopping &&
-            !emcmotInternal->coord_tp.stop_tc &&
+            !emcmotInternal->coord_tp.stop_target_pending &&
             fabs(emcmotStatus->current_vel) < TP_VEL_EPSILON) {
         emcmotStatus->stopped = 1;
     }
@@ -2224,10 +2223,20 @@ static void update_status(void)
     /* check to see if we should pause in order to implement
        single emcmotStatus->stepping */
 
-    if (emcmotStatus->stepping && emcmotInternal->idForStep != emcmotStatus->id) {
-      tpPause(&emcmotInternal->coord_tp);
-      emcmotStatus->stepping = 0;
-      emcmotStatus->paused = 1;
+    if (emcmotStatus->stepping) {
+        TP_STRUCT *tp = &emcmotInternal->coord_tp;
+        bool pass_step_done = tp->stepping_to_pass_clearance &&
+            !tp->step_target_pending;
+        bool line_step_done = !tp->stepping_to_pass_clearance &&
+            emcmotInternal->idForStep != emcmotStatus->id;
+        if (pass_step_done || line_step_done) {
+            tp->step_tc = 0;
+            tp->step_pass_id = 0;
+            tp->stepping_to_pass_clearance = 0;
+            tpPause(tp);
+            emcmotStatus->stepping = 0;
+            emcmotStatus->paused = 1;
+        }
     }
     // State Tags handling
     // Get the current executing trajectory component (the "Source of Truth")
