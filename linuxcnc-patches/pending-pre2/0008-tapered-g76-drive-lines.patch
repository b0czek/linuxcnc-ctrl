diff --git a/src/emc/rs274ngc/interp_convert.cc b/src/emc/rs274ngc/interp_convert.cc
index 99f9e6fdb8..373916cfb0 100644
--- a/src/emc/rs274ngc/interp_convert.cc
+++ b/src/emc/rs274ngc/interp_convert.cc
@@ -5659,6 +5659,88 @@ threading_pass(setup_pointer settings, block_pointer block,
     ENABLE_FEED_OVERRIDE();
 }
 
+// Make one threading pass along a tapered XZ drive line.  X coordinates are
+// offset from the drive line just as they are for a cylindrical thread, while
+// compound offsets and entry/exit distances are measured along that line.
+static void
+tapered_threading_pass(setup_pointer settings, block_pointer block,
+	       int boring, double start_x, double start_z,
+	       double end_x, double end_z, double depth, double end_depth,
+	       double start_y, double compound_offset,
+	       double full_compound_offset, double taper_dist,
+	       int entry_taper, int exit_taper, double pitch,
+	       double full_threadheight) {
+    const double drive_dx = end_x - start_x;
+    const double drive_dz = end_z - start_z;
+    const double drive_length = hypot(drive_dx, drive_dz);
+    const double drive_x = drive_dx / drive_length;
+    const double drive_z = drive_dz / drive_length;
+    const double depth_direction = boring ? 1.0 : -1.0;
+    const double drive_pitch = pitch * drive_length / fabs(drive_dz);
+
+    const double pass_start_x = start_x + drive_x * compound_offset;
+    const double pass_start_z = start_z + drive_z * compound_offset;
+    const double pass_end_x = end_x + drive_x *
+	(compound_offset - full_compound_offset);
+    const double pass_end_z = end_z + drive_z *
+	(compound_offset - full_compound_offset);
+    const double cut_start_x = pass_start_x + depth_direction * depth;
+    const double cut_end_x = pass_end_x + depth_direction * depth;
+
+    STRAIGHT_TRAVERSE(block->line_number,
+		      cut_start_x - depth_direction * end_depth,
+		      start_y, pass_start_z, AABBCC); // back
+
+    if(taper_dist && entry_taper) {
+	const double entry_end_x = cut_start_x + drive_x * taper_dist;
+	const double entry_end_z = pass_start_z + drive_z * taper_dist;
+	const double crest_start_x =
+	    cut_start_x - depth_direction * full_threadheight;
+	const double entry_pitch = pitch *
+	    hypot(entry_end_x - crest_start_x,
+		  entry_end_z - pass_start_z) /
+	    fabs(entry_end_z - pass_start_z);
+
+	DISABLE_FEED_OVERRIDE();
+	START_SPEED_FEED_SYNCH(settings->active_spindle, entry_pitch, 0);
+	STRAIGHT_FEED(block->line_number, crest_start_x,
+		      start_y, pass_start_z, AABBCC); // in
+	STRAIGHT_FEED(block->line_number, entry_end_x,
+		      start_y, entry_end_z, AABBCC); // angled in
+	START_SPEED_FEED_SYNCH(settings->active_spindle, drive_pitch, 0);
+    } else {
+	STRAIGHT_TRAVERSE(block->line_number, cut_start_x,
+			  start_y, pass_start_z, AABBCC); // in
+	DISABLE_FEED_OVERRIDE();
+	START_SPEED_FEED_SYNCH(settings->active_spindle, drive_pitch, 0);
+    }
+
+    if(taper_dist && exit_taper) {
+	const double exit_start_x = cut_end_x - drive_x * taper_dist;
+	const double exit_start_z = pass_end_z - drive_z * taper_dist;
+	const double crest_end_x =
+	    cut_end_x - depth_direction * full_threadheight;
+	const double exit_pitch = pitch *
+	    hypot(crest_end_x - exit_start_x,
+		  pass_end_z - exit_start_z) /
+	    fabs(pass_end_z - exit_start_z);
+
+	STRAIGHT_FEED(block->line_number, exit_start_x,
+		      start_y, exit_start_z, AABBCC); // over
+	START_SPEED_FEED_SYNCH(settings->active_spindle, exit_pitch, 0);
+	STRAIGHT_FEED(block->line_number, crest_end_x,
+		      start_y, pass_end_z, AABBCC); // angled out
+    } else {
+	STRAIGHT_FEED(block->line_number, cut_end_x,
+		      start_y, pass_end_z, AABBCC); // over
+    }
+    STOP_SPEED_FEED_SYNCH();
+    STRAIGHT_TRAVERSE(block->line_number,
+		      cut_end_x - depth_direction * end_depth,
+		      start_y, pass_end_z, AABBCC); // out
+    ENABLE_FEED_OVERRIDE();
+}
+
 int Interp::convert_threading_cycle(block_pointer block,
 				    setup_pointer settings,
 				    double end_x, double end_y, double end_z) {
@@ -5666,6 +5748,8 @@ int Interp::convert_threading_cycle(block_pointer block,
 
     CHKS((settings->cutter_comp_side != CUTTER_COMP::OFF),
          (_("Cannot use G76 threading cycle with cutter radius compensation on")));
+    CHKS((block->y_flag),
+	 (_("Cannot move Y axis with G76")));
 
     CHKS((block->i_number == 0),
         (_("In G76, I must not be 0")));
@@ -5705,7 +5789,18 @@ int Interp::convert_threading_cycle(block_pointer block,
     double compound_angle = block->q_number;
     if(compound_angle == -1) compound_angle = 0;
     compound_angle *= M_PIl/180.0;
-    if(end_z > start_z) compound_angle = -compound_angle;
+    const bool alternating_infeed =
+	block->d_flag && block->d_number_float == 1.0;
+
+    const bool tapered_drive_line = block->x_flag;
+    CHKS((tapered_drive_line && end_z == start_z),
+	 (_("In G76, a tapered drive line must have nonzero Z length")));
+
+    // The cylindrical path below historically expresses compound offsets as
+    // signed Z offsets.  The tapered path expresses the same offsets as
+    // distances along the drive line instead.
+    if(!tapered_drive_line && end_z > start_z)
+	compound_angle = -compound_angle;
 
     int spring_cuts = block->h_flag ? block->h_number: 0;
 
@@ -5717,7 +5812,8 @@ int Interp::convert_threading_cycle(block_pointer block,
     double taper_pitch = taper_dist > 0.0?
 	pitch * hypot(taper_dist, full_threadheight)/taper_dist: pitch;
 
-    if(end_z > start_z) taper_dist = -taper_dist;
+    if(!tapered_drive_line && end_z > start_z)
+	taper_dist = -taper_dist;
 
     int taper_flags = block->l_number;
     if(taper_flags < 0) taper_flags = 0;
@@ -5728,25 +5824,49 @@ int Interp::convert_threading_cycle(block_pointer block,
     double depth, zoff;
     int pass = 1;
 
+    const double compound_tangent = tan(compound_angle);
+    const double full_compound_offset = full_threadheight * compound_tangent;
     double target_z = end_z + fabs(k_number) * tan(compound_angle);
 
     depth = start_depth;
-    zoff = (depth - full_dia_depth) * tan(compound_angle);
+    zoff = (depth - full_dia_depth) * compound_tangent;
     while (depth < end_depth) {
-	threading_pass(settings, block, boring, safe_x, depth, end_depth, start_y,
-		       start_z, zoff, taper_dist, entry_taper, exit_taper,
-		       taper_pitch, pitch, full_threadheight, target_z);
+	// Mirror every second roughing pass about the final thread line.  The
+	// remaining-depth offset shrinks to zero, so full-depth and spring
+	// passes always use the same centered final path.
+	if(alternating_infeed && !(pass & 1))
+	    zoff = 2.0 * full_compound_offset - zoff;
+	if(tapered_drive_line) {
+	    tapered_threading_pass(settings, block, boring, start_x, start_z,
+			    end_x, end_z, depth, end_depth, start_y, zoff,
+			    full_compound_offset,
+			    taper_dist, entry_taper, exit_taper, pitch,
+			    full_threadheight);
+	} else {
+	    threading_pass(settings, block, boring, safe_x, depth, end_depth,
+			   start_y, start_z, zoff, taper_dist, entry_taper,
+			   exit_taper, taper_pitch, pitch, full_threadheight,
+			   target_z);
+	}
         depth = full_dia_depth + cut_increment * pow(++pass, 1.0/degression);
-        zoff = (depth - full_dia_depth) * tan(compound_angle);
+        zoff = (depth - full_dia_depth) * compound_tangent;
     }
     // full specified depth now
     depth = end_depth;
-    zoff = (depth - full_dia_depth) * tan(compound_angle);
+    zoff = full_compound_offset;
     // cut at least once -- more if spring cuts.
     for(int i = 0; i<spring_cuts+1; i++) {
-	threading_pass(settings, block, boring, safe_x, depth, end_depth, start_y,
-		       start_z, zoff, taper_dist, entry_taper, exit_taper,
-		       taper_pitch, pitch, full_threadheight, target_z);
+	if(tapered_drive_line) {
+	    tapered_threading_pass(settings, block, boring, start_x, start_z,
+			    end_x, end_z, depth, end_depth, start_y, zoff,
+			    zoff, taper_dist, entry_taper, exit_taper, pitch,
+			    full_threadheight);
+	} else {
+	    threading_pass(settings, block, boring, safe_x, depth, end_depth,
+			   start_y, start_z, zoff, taper_dist, entry_taper,
+			   exit_taper, taper_pitch, pitch, full_threadheight,
+			   target_z);
+	}
     }
     STRAIGHT_TRAVERSE(block->line_number, end_x, end_y, end_z, AABBCC);
     settings->current_x = end_x;
diff --git a/tests/interp/g76-tapered/README b/tests/interp/g76-tapered/README
new file mode 100644
index 0000000000..645af3ae97
--- /dev/null
+++ b/tests/interp/g76-tapered/README
@@ -0,0 +1,8 @@
+Verify that optional G76 X endpoints produce tapered XZ drive lines while
+preserving axial P pitch.  The canonical trace covers absolute and incremental
+endpoints, radius and diameter mode, internal and external threads, both drive
+line slopes, entry/exit taper in both Z directions, compound infeed, and spring
+passes. Compound-infeed coverage verifies fixed-direction D0 and
+alternating-flank D1 on tapered and cylindrical drive lines, plus centered Q0
+paths. Negative tests verify that G76 rejects a Y endpoint, invalid D modes,
+and an ambiguous same-block G96 D word.
