                 tp->step_target_pending = 0;
                 tpPause(tp);
                 if (!tp->step_target_pending) {
                     tp->step_tc = 0;
                     tp->step_pass_id = 0;
-                    tp->stepping_to_pass_clearance = 0;
+                    tp->step_motion_id = 0;
+                    tp->stepping_to_motion_target = 0;
