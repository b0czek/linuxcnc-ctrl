+/* Disable through the normal motion fault path, including already buffered
+ * interpolation. No further interpolation may run in the failing cycle. */
+static void availability_motion_fault(void)
+{
+    tpAbort(&emcmotInternal->coord_tp);
+    axis_jog_abort_all(1);
+    emcmotInternal->availability_motion_error = 1;
+    SET_MOTION_ERROR_FLAG(1);
+    emcmotInternal->enabling = 0;
+    set_operating_mode();
+}
+
+static void set_joint_availability_fault(int n, availability_fault_t fault)
+{
+    availability_release_joint(n, fault);
+    reportError(_("joint %d availability failed (%d)"), n, fault);
+    availability_motion_fault();
+}
+
+static void set_spindle_availability_fault(int n, availability_fault_t fault)
+{
+    availability_release_spindle(n, fault);
+    reportError(_("spindle %d availability failed (%d)"), n, fault);
+    availability_motion_fault();
+}
+
+static bool validate_joint_position(int n)
+{
+    const availability_status_t *a = &emcmotStatus->joint_status[n].availability;
+    const emcmot_joint_t *joint = &joints[n];
+    double feedback = *emcmot_hal_data->joint[n].motor_pos_fb;
+    double expected = a->held_position + joint->backlash_filt + joint->motor_offset;
+    double tolerance = joint->min_ferror;
+    return isfinite(feedback) && isfinite(expected) && isfinite(tolerance) &&
+        tolerance >= 0.0 && fabs(feedback - expected) <= tolerance;
+}
+
+/* The homing request owns this provisional joint-space synchronization. It
+ * gives the normal homing state machine a stationary start at the acquired
+ * hardware position; only successful homing makes the position valid. */
+static bool availability_start_homing(int n)
+{
+    emcmot_joint_t *joint = &joints[n];
+    double motor = *emcmot_hal_data->joint[n].motor_pos_fb;
+    double position = motor - joint->backlash_filt - joint->motor_offset;
+    if (!isfinite(motor) || !isfinite(position)) return false;
+    do_home_joint(n);
+    joint->motor_pos_fb = motor;
+    joint->pos_fb = joint->pos_cmd = joint->coarse_pos = position;
+    joint->free_tp.curr_pos = joint->free_tp.pos_cmd =
+        joint->free_tp.last_pos_cmd = position;
+    joint->free_tp.curr_vel = joint->free_tp.curr_acc =
+        joint->free_tp.curr_jerk = 0.0;
+    joint->free_tp.enable = joint->free_tp.active = 0;
+    joint->vel_cmd = joint->acc_cmd = joint->jerk_cmd = 0.0;
+    joint->ferror = 0.0;
+    SET_JOINT_FERROR_FLAG(joint, 0);
+    SET_JOINT_ACTIVE_FLAG(joint, 1);
+    SET_JOINT_ENABLE_FLAG(joint, GET_MOTION_ENABLE_FLAG());
+    return true;
+}
+
+static void availability_complete_joint(int n)
+{
+    availability_status_t *a = &emcmotStatus->joint_status[n].availability;
+    motion_state_t restore = a->return_motion_state;
+    a->phase = AVAIL_PHASE_IDLE;
+    a->return_motion_state = EMCMOT_MOTION_FREE;
+    a->state = EMCMOT_AVAILABILITY_AVAILABLE;
+    if (restore == EMCMOT_MOTION_COORD) emcmotInternal->coordinating = 1;
+    if (restore == EMCMOT_MOTION_TELEOP) switch_to_teleop_mode();
+}
+
+static void availability_finish_homing(int n)
+{
+    availability_complete_joint(n);
+}
+
+static void process_availability(void)
+{
+    int n;
+    double now = etime();
+    if (!*emcmot_hal_data->enable &&
+        (emcmotInternal->availability_machine_on || GET_MOTION_ENABLE_FLAG()))
+        availability_cancel(1);
+
+    for (n = 0; n < ALL_JOINTS; n++) {
+        availability_status_t *a = &emcmotStatus->joint_status[n].availability;
+        joint_hal_t *hal = &emcmot_hal_data->joint[n];
+        int ack = !!*hal->availability_ack;
+        if (!a->controlled) {
+            a->state = EMCMOT_AVAILABILITY_AVAILABLE;
+        } else switch (a->state) {
+        case EMCMOT_AVAILABILITY_DISABLED:
+            if (ack) set_joint_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_ACK_UNEXPECTED);
+            break;
+        case EMCMOT_AVAILABILITY_ENABLING:
+            if (ack && !*hal->availability_request) {
+                set_joint_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_ACK_STALE_HIGH);
+                break;
+            }
+            if (ack) {
+                if (!get_homed(n) && a->phase == AVAIL_PHASE_RUNTIME_ACK) {
+                    a->return_motion_state = emcmotStatus->motion_state;
+                    emcmotInternal->coordinating = emcmotInternal->teleoperating = 0;
+                    a->state = EMCMOT_AVAILABILITY_HOMING;
+                    a->phase = AVAIL_PHASE_WAIT_FREE;
+                } else {
+                    if (!validate_joint_position(n)) {
+                        set_joint_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_POSITION_MISMATCH);
+                        break;
+                    }
+                    SET_JOINT_ACTIVE_FLAG(&joints[n], 1);
+                    SET_JOINT_ENABLE_FLAG(&joints[n], GET_MOTION_ENABLE_FLAG());
+                    availability_complete_joint(n);
+                }
+            } else if (now - a->transition_started >= a->timeout)
+                set_joint_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_ACQUIRE_TIMEOUT);
+            break;
+        case EMCMOT_AVAILABILITY_HOMING:
+            if (!ack) {
+                set_joint_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_ACK_LOST);
+            } else if (a->phase == AVAIL_PHASE_WAIT_FREE) {
+                if (emcmotStatus->motion_state != EMCMOT_MOTION_FREE) break;
+                if (*emcmot_hal_data->homing_inhibit) {
+                    set_joint_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_HOME_ABORTED);
+                    break;
+                }
+                if (!availability_start_homing(n)) {
+                    set_joint_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_HOME_FAILED);
+                    break;
+                }
+                a->phase = AVAIL_PHASE_WAIT_HOME_START;
+                a->transition_started = now;
+            } else if (a->phase == AVAIL_PHASE_WAIT_HOME_START) {
+                if (get_homing(n)) a->phase = AVAIL_PHASE_WAIT_HOME_FINISH;
+                else if (get_homed(n) && get_home_is_idle(n)) availability_finish_homing(n);
+                else if (now - a->transition_started >= a->timeout)
+                    set_joint_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_HOME_FAILED);
+            } else if (get_home_is_idle(n)) {
+                if (get_homed(n)) availability_finish_homing(n);
+                else set_joint_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_HOME_FAILED);
+            }
+            break;
+        case EMCMOT_AVAILABILITY_AVAILABLE:
+            if (!get_homed(n))
+                set_joint_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_HOME_FAILED);
+            else if (!ack)
+                set_joint_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_ACK_LOST);
+            break;
+        case EMCMOT_AVAILABILITY_DISABLING:
+            if (a->phase == AVAIL_PHASE_WAIT_SETTLED) {
+                if (!ack) {
+                    set_joint_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_ACK_LOST);
+                    break;
+                }
