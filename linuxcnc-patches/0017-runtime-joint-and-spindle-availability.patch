diff --git a/src/emc/motion/command.c b/src/emc/motion/command.c
index c166af652b..a18acd066f 100644
--- a/src/emc/motion/command.c
+++ b/src/emc/motion/command.c
@@ -80,6 +80,38 @@ extern int motion_num_spindles;
 
 static int rehomeAll;
 
+int availability_transition_busy(void)
+{
+    int n;
+    for (n = 0; n < ALL_JOINTS; n++) {
+        availability_state_t state =
+            emcmotStatus->joint_status[n].availability.state;
+        if (state == EMCMOT_AVAILABILITY_ENABLING ||
+            state == EMCMOT_AVAILABILITY_HOMING ||
+            state == EMCMOT_AVAILABILITY_DISABLING) return 1;
+    }
+    for (n = 0; n < emcmotConfig->numSpindles; n++) {
+        availability_state_t state =
+            emcmotStatus->spindle_status[n].availability.state;
+        if (state == EMCMOT_AVAILABILITY_ENABLING ||
+            state == EMCMOT_AVAILABILITY_DISABLING) return 1;
+    }
+    return 0;
+}
+
+STATIC int spindle_range_is_available(int first, int last)
+{
+    int spindle;
+    for (spindle = first; spindle <= last; spindle++) {
+        availability_status_t *availability =
+            &emcmotStatus->spindle_status[spindle].availability;
+        if (availability->controlled &&
+            availability->state != EMCMOT_AVAILABILITY_AVAILABLE)
+            return 0;
+    }
+    return 1;
+}
+
 /* limits_ok() returns 1 if none of the hard limits are set,
    0 if any are set. Called on a linear and circular move. */
 STATIC int limits_ok(void)
@@ -492,6 +524,40 @@ void emcmotCommandHandler_locked(void *arg, long servo_period)
                   return;
             }
         }
+        if (availability_transition_busy()) {
+            switch (emcmotCommand->command) {
+            case EMCMOT_JOG_CONT:
+            case EMCMOT_JOG_INCR:
+            case EMCMOT_JOG_ABS:
+            case EMCMOT_SET_LINE:
+            case EMCMOT_SET_CIRCLE:
+            case EMCMOT_PROBE:
+            case EMCMOT_RIGID_TAP:
+            case EMCMOT_JOINT_HOME:
+                emcmotStatus->commandStatus = EMCMOT_COMMAND_INVALID_COMMAND;
+                return;
+            default: break;
+            }
+        }
+        /* tcSetupState inherits the planner's modal spindle dependency. */
+        switch (emcmotCommand->command) {
+        case EMCMOT_SET_LINE:
+        case EMCMOT_SET_CIRCLE:
+        case EMCMOT_PROBE:
+        case EMCMOT_RIGID_TAP: {
+            int spindle = emcmotInternal->coord_tp.spindle.spindle_num;
+            if (emcmotInternal->coord_tp.synchronized != TC_SYNC_NONE &&
+                (spindle < 0 || spindle >= emcmotConfig->numSpindles ||
+                 !spindle_range_is_available(spindle, spindle))) {
+                reportError(_("cannot admit motion synchronized to unavailable spindle %d"), spindle);
+                emcmotStatus->commandStatus = EMCMOT_COMMAND_INVALID_COMMAND;
+                SET_MOTION_ERROR_FLAG(1);
+                return;
+            }
+            break;
+        }
+        default: break;
+        }
 	switch (emcmotCommand->command) {
 	case EMCMOT_ABORT:
 	    /* abort motion */
@@ -503,6 +569,7 @@ void emcmotCommandHandler_locked(void *arg, long servo_period)
 	       does yet), and if in free mode, it disables the free mode traj
