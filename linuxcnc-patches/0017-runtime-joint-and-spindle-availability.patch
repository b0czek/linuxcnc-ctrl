+/* Availability owns requests and completion, not homing or planner state. */
+static void availability_clear_pending(availability_status_t *a)
+{
+    a->target_available = 0;
+    a->phase = AVAIL_PHASE_IDLE;
+}
+
+void availability_begin(availability_status_t *a, int runtime)
+{
+    a->target_available = 1;
+    a->phase = runtime ? AVAIL_PHASE_RUNTIME_ACK : AVAIL_PHASE_INITIAL_ACK;
+    a->fault = EMCMOT_AVAILABILITY_FAULT_NONE;
+    a->transition_started = etime();
+    /* A fault must first observe ACK low before issuing a fresh request. */
+    a->state = a->state == EMCMOT_AVAILABILITY_FAULT
+        ? EMCMOT_AVAILABILITY_DISABLING : EMCMOT_AVAILABILITY_ENABLING;
+}
+
+void availability_release_joint(int n, availability_fault_t fault)
+{
+    availability_status_t *a = &emcmotStatus->joint_status[n].availability;
+    if (!a->controlled) return;
+    if (a->state == EMCMOT_AVAILABILITY_AVAILABLE ||
+        a->state == EMCMOT_AVAILABILITY_HOMING)
+        a->held_position = joints[n].pos_cmd;
+    availability_clear_pending(a);
+    a->phase = AVAIL_PHASE_CANCEL_HOME;
+    a->fault = fault;
+    a->state = EMCMOT_AVAILABILITY_DISABLING;
+    a->transition_started = etime();
+    hal_set_bool(emcmot_hal_data->joint[n].availability_request, 0);
+    motion_cancel_joint(n);
+}
+
+void availability_begin_joint_release(int n)
+{
+    availability_status_t *a = &emcmotStatus->joint_status[n].availability;
+    /* Release admission has already completed planning. Capture its logical
+     * endpoint while the servo-side settled check drains the final sample. */
+    a->held_position = joints[n].coarse_pos;
+    a->target_available = 0;
+    a->phase = AVAIL_PHASE_WAIT_SETTLED;
+    a->fault = EMCMOT_AVAILABILITY_FAULT_NONE;
+    a->state = EMCMOT_AVAILABILITY_DISABLING;
+    a->transition_started = etime();
+}
+
+void availability_release_spindle(int n, availability_fault_t fault)
+{
+    spindle_status_t *s = &emcmotStatus->spindle_status[n];
+    availability_status_t *a = &s->availability;
+    if (!a->controlled) return;
+    availability_clear_pending(a);
+    a->fault = fault;
+    a->state = EMCMOT_AVAILABILITY_DISABLING;
+    a->transition_started = etime();
+    hal_set_bool(emcmot_hal_data->spindle[n].availability_request, 0);
+    s->state = 0;
+    s->speed = 0;
+    s->brake = 0;
+    s->locked = 0;
+    s->orient_state = EMCMOT_ORIENT_NONE;
+    s->spindle_index_enable = 0;
+    hal_set_bool(emcmot_hal_data->spindle[n].spindle_index_enable, 0);
+    old_motion_index[n] = old_hal_index[n] = 0;
+    hal_set_bool(emcmot_hal_data->spindle[n].spindle_orient, 0);
+    hal_set_bool(emcmot_hal_data->spindle[n].spindle_locked, 0);
+}
+
+void availability_cancel(int all)
+{
+    int n;
+    int initial = emcmotInternal->availability_machine_on;
+    emcmotInternal->availability_machine_on = 0;
+    emcmotInternal->availability_resource = 0;
+    if (initial || all) emcmotInternal->enabling = 0;
+    /* Revoke mode restoration as well as acquisition. */
+    if (all || initial) {
+        emcmotInternal->coordinating = 0;
+        emcmotInternal->teleoperating = 0;
+    }
+    for (n = 0; n < ALL_JOINTS; n++) {
+        availability_status_t *a = &emcmotStatus->joint_status[n].availability;
+        if ((all || initial || a->state == EMCMOT_AVAILABILITY_ENABLING ||
+             a->state == EMCMOT_AVAILABILITY_HOMING || a->target_available) &&
+            (all || initial || a->state != EMCMOT_AVAILABILITY_AVAILABLE))
+            availability_release_joint(n, a->fault);
+    }
+    for (n = 0; n < emcmotConfig->numSpindles; n++) {
+        availability_status_t *a = &emcmotStatus->spindle_status[n].availability;
+        if ((all || initial || a->state == EMCMOT_AVAILABILITY_ENABLING ||
+             a->target_available) &&
+            (all || initial || a->state != EMCMOT_AVAILABILITY_AVAILABLE))
+            availability_release_spindle(n, a->fault);
+    }
+}
+
+/* Disable through the normal motion fault path, including already buffered
+ * interpolation. No further interpolation may run in the failing cycle. */
+static void availability_motion_fault(void)
+{
+    tpAbort(&emcmotInternal->coord_tp);
+    axis_jog_abort_all(1);
+    emcmotInternal->availability_motion_error = 1;
+    SET_MOTION_ERROR_FLAG(1);
+    emcmotInternal->enabling = 0;
+    set_operating_mode();
+}
+
+static void set_joint_availability_fault(int n, availability_fault_t fault)
+{
+    availability_release_joint(n, fault);
+    reportError(_("joint %d availability failed (%d)"), n, fault);
+    availability_motion_fault();
+}
+
+static void set_spindle_availability_fault(int n, availability_fault_t fault)
+{
+    availability_release_spindle(n, fault);
+    reportError(_("spindle %d availability failed (%d)"), n, fault);
+    availability_motion_fault();
+}
+
+static bool validate_joint_position(int n)
+{
+    const availability_status_t *a = &emcmotStatus->joint_status[n].availability;
+    const emcmot_joint_t *joint = &joints[n];
+    double feedback = hal_get_real(emcmot_hal_data->joint[n].motor_pos_fb);
+    double expected = a->held_position + joint->backlash_filt + joint->motor_offset;
+    double tolerance = joint->min_ferror;
+    return isfinite(feedback) && isfinite(expected) && isfinite(tolerance) &&
+        tolerance >= 0.0 && fabs(feedback - expected) <= tolerance;
+}
+
+/* The homing request owns this provisional joint-space synchronization. It
+ * gives the normal homing state machine a stationary start at the acquired
+ * hardware position; only successful homing makes the position valid. */
+static bool availability_start_homing(int n)
+{
+    emcmot_joint_t *joint = &joints[n];
+    double motor = hal_get_real(emcmot_hal_data->joint[n].motor_pos_fb);
+    double position = motor - joint->backlash_filt - joint->motor_offset;
+    if (!isfinite(motor) || !isfinite(position)) return false;
+    do_home_joint(n);
+    joint->motor_pos_fb = motor;
+    joint->pos_fb = joint->pos_cmd = joint->coarse_pos = position;
+    joint->free_tp.curr_pos = joint->free_tp.pos_cmd =
+        joint->free_tp.last_pos_cmd = position;
+    joint->free_tp.curr_vel = joint->free_tp.curr_acc =
+        joint->free_tp.curr_jerk = 0.0;
+    joint->free_tp.enable = joint->free_tp.active = 0;
+    joint->vel_cmd = joint->acc_cmd = joint->jerk_cmd = 0.0;
+    joint->ferror = 0.0;
+    SET_JOINT_FERROR_FLAG(joint, 0);
+    SET_JOINT_ACTIVE_FLAG(joint, 1);
+    SET_JOINT_ENABLE_FLAG(joint, GET_MOTION_ENABLE_FLAG());
+    return true;
+}
+
+static void availability_complete_joint(int n)
+{
+    availability_status_t *a = &emcmotStatus->joint_status[n].availability;
+    a->phase = AVAIL_PHASE_IDLE;
+    a->state = EMCMOT_AVAILABILITY_AVAILABLE;
+}
+
+/* Runs right after do_homing(), so the cycle that ends acquisition homing also
+ * publishes its result. Task's queued home cycle observes homing_active fall
+ * and restores the trajectory mode only once the joint is AVAILABLE. */
+static void finish_availability_homing(void)
+{
+    int n;
+    for (n = 0; n < ALL_JOINTS; n++) {
+        availability_status_t *a = &emcmotStatus->joint_status[n].availability;
+        if (!a->controlled || a->state != EMCMOT_AVAILABILITY_HOMING ||
+            a->phase != AVAIL_PHASE_WAIT_HOME_FINISH || !get_home_is_idle(n))
+            continue;
+        if (get_homed(n)) availability_complete_joint(n);
+        else set_joint_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_HOME_FAILED);
+    }
+}
+
+static void process_availability(void)
+{
+    int n;
+    double now = etime();
+    if (!hal_get_bool(emcmot_hal_data->enable) &&
+        (emcmotInternal->availability_machine_on || GET_MOTION_ENABLE_FLAG()))
+        availability_cancel(1);
+
+    for (n = 0; n < ALL_JOINTS; n++) {
+        availability_status_t *a = &emcmotStatus->joint_status[n].availability;
+        joint_hal_t *hal = &emcmot_hal_data->joint[n];
+        int ack = hal_get_bool(hal->availability_ack);
+        if (!a->controlled) {
+            a->state = EMCMOT_AVAILABILITY_AVAILABLE;
+        } else switch (a->state) {
+        case EMCMOT_AVAILABILITY_DISABLED:
+            if (ack) set_joint_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_ACK_UNEXPECTED);
+            break;
+        case EMCMOT_AVAILABILITY_ENABLING:
+            if (ack && !hal_get_bool(hal->availability_request)) {
+                set_joint_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_ACK_STALE_HIGH);
+                break;
+            }
+            if (ack) {
+                if (!get_homed(n) && a->phase == AVAIL_PHASE_RUNTIME_ACK) {
+                    /* Task homes the joint through its queued home cycle,
+                     * which also owns the FREE dip and mode restoration. */
+                    a->state = EMCMOT_AVAILABILITY_HOMING;
+                    a->phase = AVAIL_PHASE_WAIT_HOME_REQUEST;
+                } else {
+                    if (!validate_joint_position(n)) {
+                        set_joint_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_POSITION_MISMATCH);
+                        break;
+                    }
+                    SET_JOINT_ACTIVE_FLAG(&joints[n], 1);
+                    SET_JOINT_ENABLE_FLAG(&joints[n], GET_MOTION_ENABLE_FLAG());
+                    availability_complete_joint(n);
+                }
+            } else if (now - a->transition_started >= a->timeout)
+                set_joint_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_ACQUIRE_TIMEOUT);
+            break;
+        case EMCMOT_AVAILABILITY_HOMING:
+            if (!ack) {
+                set_joint_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_ACK_LOST);
+            } else if (a->phase != AVAIL_PHASE_WAIT_HOME_FINISH &&
+                       hal_get_bool(emcmot_hal_data->homing_inhibit)) {
+                set_joint_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_HOME_ABORTED);
+            } else if (a->phase == AVAIL_PHASE_WAIT_FREE) {
+                /* Task's home request was accepted; it has dipped motion
+                 * into FREE. Completion is finish_availability_homing(). */
+                if (emcmotStatus->motion_state != EMCMOT_MOTION_FREE) break;
+                if (!availability_start_homing(n)) {
+                    set_joint_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_HOME_FAILED);
+                    break;
+                }
+                a->phase = AVAIL_PHASE_WAIT_HOME_FINISH;
+            }
+            break;
+        case EMCMOT_AVAILABILITY_AVAILABLE:
+            if (!get_homed(n))
+                set_joint_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_HOME_FAILED);
+            else if (!ack)
+                set_joint_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_ACK_LOST);
+            break;
+        case EMCMOT_AVAILABILITY_DISABLING:
+            if (a->phase == AVAIL_PHASE_WAIT_SETTLED) {
+                if (!ack) {
+                    set_joint_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_ACK_LOST);
+                    break;
+                }
+                if (motion_joint_release_state(n) != MOTION_JOINT_RELEASE_READY) {
+                    if (now - a->transition_started >= a->timeout)
+                        set_joint_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_TRANSITION_ABORTED);
+                    break;
+                }
+                /* Cubic points and commanded derivatives are drained. Finish
+                 * the final sampled position at the commanded endpoint. */
+                a->held_position = joints[n].coarse_pos;
+                joints[n].pos_cmd = a->held_position;
+                availability_release_joint(n, EMCMOT_AVAILABILITY_FAULT_NONE);
+            }
+            /* Leave the joint active until the homing engine consumes abort. */
+            if (a->phase == AVAIL_PHASE_CANCEL_HOME) {
+                if (!get_home_is_idle(n)) break;
+                /* Cancellation may stop acquisition homing at a new
+                 * unreferenced location. Keep that result internal while the
+                 * joint remains unavailable. Volatile joints freeze the
+                 * final commanded homing location before invalidating it. */
+                if (a->volatile_home && GET_JOINT_ACTIVE_FLAG(&joints[n]))
+                    a->held_position = joints[n].pos_cmd;
+                joints[n].pos_fb = a->held_position;
+                joints[n].motor_pos_fb = a->held_position +
+                    joints[n].backlash_filt + joints[n].motor_offset;
+                joints[n].vel_cmd = joints[n].acc_cmd = joints[n].jerk_cmd = 0.0;
+                joints[n].free_tp.curr_vel = joints[n].free_tp.curr_acc =
+                    joints[n].free_tp.curr_jerk = 0.0;
+                joints[n].free_tp.enable = joints[n].free_tp.active = 0;
+                SET_JOINT_INPOS_FLAG(&joints[n], 1);
+                if (a->volatile_home && GET_JOINT_ACTIVE_FLAG(&joints[n]))
+                    set_unhomed(n, emcmotStatus->motion_state);
+                SET_JOINT_ACTIVE_FLAG(&joints[n], 0);
+                a->phase = AVAIL_PHASE_IDLE;
+            }
+            if (!ack) {
+                if (a->target_available) {
+                    a->state = EMCMOT_AVAILABILITY_ENABLING;
+                    a->transition_started = now;
+                } else a->state = a->fault ? EMCMOT_AVAILABILITY_FAULT : EMCMOT_AVAILABILITY_DISABLED;
+            } else if (now - a->transition_started >= a->timeout) {
+                availability_clear_pending(a);
+                if (!a->fault) a->fault = EMCMOT_AVAILABILITY_FAULT_RELEASE_TIMEOUT;
+                a->state = EMCMOT_AVAILABILITY_FAULT;
+                reportError(_("joint %d availability release timed out"), n);
+                availability_motion_fault();
+            }
+            break;
+        case EMCMOT_AVAILABILITY_FAULT: break;
+        }
+        hal_set_bool(hal->availability_request, a->controlled && a->target_available &&
+            (a->state == EMCMOT_AVAILABILITY_ENABLING ||
+             a->state == EMCMOT_AVAILABILITY_HOMING || a->state == EMCMOT_AVAILABILITY_AVAILABLE));
+        if (a->controlled && a->phase == AVAIL_PHASE_WAIT_SETTLED)
+            hal_set_bool(hal->availability_request, 1);
+        hal_set_bool(hal->available, a->state == EMCMOT_AVAILABILITY_AVAILABLE);
+        hal_set_sint(hal->availability_state, a->state);
+        hal_set_bool(hal->availability_fault, !!a->fault);
+        hal_set_sint(hal->availability_fault_code, a->fault);
+    }
+    for (n = 0; n < emcmotConfig->numSpindles; n++) {
+        availability_status_t *a = &emcmotStatus->spindle_status[n].availability;
+        spindle_hal_t *hal = &emcmot_hal_data->spindle[n];
+        int ack = hal_get_bool(hal->availability_ack);
+        if (!a->controlled) a->state = EMCMOT_AVAILABILITY_AVAILABLE;
+        else switch (a->state) {
+        case EMCMOT_AVAILABILITY_DISABLED:
+            if (ack) set_spindle_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_ACK_UNEXPECTED);
+            break;
+        case EMCMOT_AVAILABILITY_ENABLING:
+            if (ack && !hal_get_bool(hal->availability_request)) {
+                set_spindle_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_ACK_STALE_HIGH);
+                break;
+            }
+            if (ack) { a->state = EMCMOT_AVAILABILITY_AVAILABLE; a->phase = AVAIL_PHASE_IDLE; }
+            else if (now - a->transition_started >= a->timeout)
+                set_spindle_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_ACQUIRE_TIMEOUT);
+            break;
+        case EMCMOT_AVAILABILITY_AVAILABLE:
+            if (!ack) set_spindle_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_ACK_LOST);
+            break;
+        case EMCMOT_AVAILABILITY_DISABLING:
+            if (!ack) {
+                if (a->target_available) {
+                    a->state = EMCMOT_AVAILABILITY_ENABLING;
+                    a->transition_started = now;
+                } else a->state = a->fault ? EMCMOT_AVAILABILITY_FAULT : EMCMOT_AVAILABILITY_DISABLED;
+            } else if (now - a->transition_started >= a->timeout) {
+                availability_clear_pending(a);
+                if (!a->fault) a->fault = EMCMOT_AVAILABILITY_FAULT_RELEASE_TIMEOUT;
+                a->state = EMCMOT_AVAILABILITY_FAULT;
+                reportError(_("spindle %d availability release timed out"), n);
+                availability_motion_fault();
+            }
+            break;
+        case EMCMOT_AVAILABILITY_HOMING:
+            set_spindle_availability_fault(n, EMCMOT_AVAILABILITY_FAULT_TRANSITION_ABORTED);
+            break;
+        case EMCMOT_AVAILABILITY_FAULT: break;
+        }
+        hal_set_bool(hal->availability_request, a->controlled && a->target_available &&
+            (a->state == EMCMOT_AVAILABILITY_ENABLING || a->state == EMCMOT_AVAILABILITY_AVAILABLE));
+        hal_set_bool(hal->available, a->state == EMCMOT_AVAILABILITY_AVAILABLE);
+        hal_set_sint(hal->availability_state, a->state);
+        hal_set_bool(hal->availability_fault, !!a->fault);
+        hal_set_sint(hal->availability_fault_code, a->fault);
+    }
+    if (emcmotInternal->availability_machine_on) {
+        for (n = 0; n < ALL_JOINTS; n++) {
+            availability_status_t *a = &emcmotStatus->joint_status[n].availability;
+            if (a->controlled && a->fault) { availability_cancel(1); return; }
+        }
+        for (n = 0; n < emcmotConfig->numSpindles; n++) {
+            availability_status_t *a = &emcmotStatus->spindle_status[n].availability;
+            if (a->controlled && a->fault) { availability_cancel(1); return; }
+        }
+        while (emcmotInternal->availability_resource < emcmotConfig->numSpindles) {
+            n = emcmotInternal->availability_resource;
+            availability_status_t *a = &emcmotStatus->spindle_status[n].availability;
+            if (!a->controlled || !a->initial_available || a->state == EMCMOT_AVAILABILITY_AVAILABLE) {
+                emcmotInternal->availability_resource++;
+                continue;
+            }
+            if (a->state == EMCMOT_AVAILABILITY_DISABLED) availability_begin(a, 0);
+            break;
+        }
+        if (emcmotInternal->availability_resource == emcmotConfig->numSpindles) {
+            if (hal_get_bool(emcmot_hal_data->enable)) {
