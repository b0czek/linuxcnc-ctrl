index 0000000000..3e7e61f92e
--- /dev/null
+++ b/tests/runtime-availability/make-fixtures.py
@@ -0,0 +1,34 @@
+#!/usr/bin/env python3
+"""Materialize local *.ini.in cases from a shared base and explicit overrides.
+
+Run in the suite directory (test.sh does this automatically). @unset removes
+an inherited key; all other strings are copied verbatim. Paths remain relative
+to the suite, just as in the original standalone fixtures.
+"""
+import configparser
+from pathlib import Path
+
+
+def read(path):
+    ini = configparser.ConfigParser(interpolation=None)
+    ini.optionxform = str
+    with path.open() as stream:
+        ini.read_file(stream)
+    return ini
+
+
+for template in sorted(Path('.').glob('*.ini.in')):
+    overrides = read(template)
+    ini = read(template.parent / overrides['FIXTURE']['BASE'])
+    overrides.remove_section('FIXTURE')
+    for section in overrides.sections():
+        if not ini.has_section(section):
+            ini.add_section(section)
+        for key, value in overrides[section].items():
+            if value == '@unset':
+                ini.remove_option(section, key)
+            else:
+                ini[section][key] = value
+    with template.with_suffix('').open('w') as stream:
+        stream.write('# Generated by make-fixtures.py; edit the .ini.in case.\n')
+        ini.write(stream)
