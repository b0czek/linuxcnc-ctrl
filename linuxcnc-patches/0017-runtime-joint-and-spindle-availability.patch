@@ -585,6 +658,10 @@ void emcmotCommandHandler_locked(void *arg, long servo_period)
 	    break;
 
 	case EMCMOT_COORD:
+            if (availability_transition_busy()) {
+                emcmotStatus->commandStatus = EMCMOT_COMMAND_INVALID_COMMAND;
+                break;
+            }
