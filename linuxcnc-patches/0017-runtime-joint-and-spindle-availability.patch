@@ -14,6 +14,7 @@
 * Last change: created 30/12/21
 ********************************************************************/
 
+#include <cmath>
 #include <fmt/format.h>
 
 #include "nml_intf/emc.hh"
@@ -91,12 +92,40 @@ static int loadSpindle(int spindle, const IniFile &ini)
     double home_angle = 0.0;
     double increment = ini.findRealV("INCREMENT", spindleSection, 100.0);
 
+    bool availability_control =
+        ini.findBoolV("AVAILABILITY_CONTROL", spindleSection, false);
+    bool initial_availability = true;
+    if (availability_control) {
+        auto configured_initial =
+            ini.findBool("INITIAL_AVAILABILITY", spindleSection);
+        if (!configured_initial) {
+            rcs_print_error("%s: INITIAL_AVAILABILITY is required when "
+                            "AVAILABILITY_CONTROL is enabled\n",
+                            spindleSection.c_str());
+            return -1;
+        }
+        initial_availability = *configured_initial;
+    }
+    double availability_timeout =
+        ini.findRealV("AVAILABILITY_TIMEOUT", spindleSection, 5.0);
+    if (!std::isfinite(availability_timeout) || availability_timeout <= 0.0) {
+        rcs_print_error("%s: AVAILABILITY_TIMEOUT must be greater than zero\n",
+                        spindleSection.c_str());
+        return -1;
+    }
+
     if (0 != emcSpindleSetParams(spindle, fastest_pos, slowest_pos,
                                  slowest_neg, fastest_neg, search_vel,
                                  home_angle, home_sequence, increment)) {
         rcs_print_error("emcSpindleSetParams: failed\n");
         return -1;
     }
+    if (0 != emcSpindleSetAvailabilityConfig(spindle, availability_control,
+                                              initial_availability,
+                                              availability_timeout)) {
+        rcs_print_error("emcSpindleSetAvailabilityConfig: failed\n");
+        return -1;
+    }
     return 0;
 }
 
