diff --git a/src/emc/motion/command.c b/src/emc/motion/command.c
index 8dc79dd..56264d2 100644
--- a/src/emc/motion/command.c
+++ b/src/emc/motion/command.c
@@ -80,6 +80,16 @@ extern int motion_num_spindles;
 
 static int rehomeAll;
 
+/* Task requests acquisition homing through its queued home cycle. */
+static int availability_home_requested(int joint_num)
+{
+    const availability_status_t *a;
+    if (joint_num < 0 || joint_num >= ALL_JOINTS) return 0;
+    a = &emcmotStatus->joint_status[joint_num].availability;
+    return a->controlled && a->state == EMCMOT_AVAILABILITY_HOMING &&
+        a->phase == AVAIL_PHASE_WAIT_HOME_REQUEST;
+}
+
 /* ===== BEGIN PLANNER_SWITCH_DEFER (reversible) =====================================
  * Deferred PLANNER_TYPE switching. Switching 0<->1 mid-motion causes an acceleration
  * discontinuity (the very thing the S-curve planner exists to avoid), so a switch
@@ -115,6 +125,38 @@ void emcmotApplyPendingPlannerType(void)
 }
 /* ===== END PLANNER_SWITCH_DEFER ==================================================== */
 
+int availability_transition_busy(void)
+{
+    int n;
+    for (n = 0; n < ALL_JOINTS; n++) {
+        availability_state_t state =
+            emcmotStatus->joint_status[n].availability.state;
+        if (state == EMCMOT_AVAILABILITY_ENABLING ||
+            state == EMCMOT_AVAILABILITY_HOMING ||
+            state == EMCMOT_AVAILABILITY_DISABLING) return 1;
+    }
+    for (n = 0; n < emcmotConfig->numSpindles; n++) {
+        availability_state_t state =
