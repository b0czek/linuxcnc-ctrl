+                joints[n].pos_fb = a->held_position;
+                joints[n].motor_pos_fb = a->held_position +
+                    joints[n].backlash_filt + joints[n].motor_offset;
+                joints[n].vel_cmd = joints[n].acc_cmd = joints[n].jerk_cmd = 0.0;
+                joints[n].free_tp.curr_vel = joints[n].free_tp.curr_acc =
+                    joints[n].free_tp.curr_jerk = 0.0;
+                joints[n].free_tp.enable = joints[n].free_tp.active = 0;
+                SET_JOINT_INPOS_FLAG(&joints[n], 1);
+                if (a->volatile_home && GET_JOINT_ACTIVE_FLAG(&joints[n]))
