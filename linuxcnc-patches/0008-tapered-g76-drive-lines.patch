+(Test tapered G76 drive lines)
+
+g20 g18 g8
+s100 m3
+
+(basic external, decreasing X)
+g0 x1 z0
+g76 p.1 x.8 z-1 i-.1 j.09 k.1 h0 q0
+
+(basic external, increasing X)
+g0 x.8 z0
+g76 p.1 x1 z-1 i-.1 j.09 k.1 h0 q0
+
+(incremental endpoint)
+g0 x1 z0
+g91
+g76 p.1 x-.2 z-1 i-.1 j.09 k.1 h0 q0
+g90
+
+(diameter mode endpoint and depths)
+g7
+g0 x2 z0
+g76 p.1 x1.6 z-1 i-.2 j.18 k.2 h0 q0
+
+(radius mode endpoint and depths)
+g8
+g0 x1 z0
+g76 p.1 x.8 z-1 i-.1 j.09 k.1 h0 q0
+
+(internal thread)
+g0 x.5 z0
+g76 p.1 x.7 z-1 i.1 j.09 k.1 h0 q0
+
+(entry and exit taper)
+g0 x1 z0
+g76 p.1 x.8 z-1 i-.1 j.09 k.1 h0 q0 e.1 l3
+
+(positive Z entry and exit taper)
+g0 x1 z0
+g76 p.1 x.8 z1 i-.1 j.09 k.1 h0 q0 e.1 l3
+
+(fixed-direction compound infeed)
+g0 x1 z0
+g76 p.1 x.8 z-1 i-.1 j.09 k.1 h0 q30 d0
+
+(alternating-flank compound infeed)
+g0 x1 z0
+g76 p.1 x.8 z-1 i-.1 j.03 k.1 r1 h2 q30 d1
+
+(alternating mode with centered Q0 infeed)
+g0 x1 z0
+g76 p.1 z-1 i-.1 j.03 k.1 r1 h0 q0 d1
+
+(cylindrical alternating-flank compound infeed)
+g0 x1 z0
+g76 p.1 z-1 i-.1 j.03 k.1 r1 h1 q30 d1
+
+(spring passes)
+g0 x1 z0
+g76 p.1 x.8 z-1 i-.1 j.09 k.1 h2 q0
+
+m5
+m2
diff --git a/tests/interp/g76-tapered/test.sh b/tests/interp/g76-tapered/test.sh
new file mode 100644
index 0000000..70f3986
--- /dev/null
+++ b/tests/interp/g76-tapered/test.sh
@@ -0,0 +1,31 @@
+#!/bin/bash
+
+rs274 -g test.ngc | awk '{$1=""; print}'
+result=${PIPESTATUS[0]}
+if (( result != 0 )); then
+    exit "$result"
+fi
+
+# Each invalid program must be rejected with its own message.
+declare -A expected_error=(
+    [invalid-d-fraction.ngc]="In G76, D must be 0 or 1"
+    [invalid-d2.ngc]="In G76, D must be 0 or 1"
+    [invalid-g96-d.ngc]="D cannot select both G76 infeed mode and G96 spindle limit in the same block"
+    [invalid-g96-d-limit.ngc]="D cannot select both G76 infeed mode and G96 spindle limit in the same block"
+    [invalid-y.ngc]="Cannot move Y axis with G76"
+    [invalid-zero-z.ngc]="In G76, a tapered drive line must have nonzero Z length"
+)
+
+for invalid_program in invalid-*.ngc; do
+    message=${expected_error[$invalid_program]}
+    if [[ -z $message ]]; then
+        echo "$invalid_program has no expected error message" >&2
+        exit 1
+    fi
+    output=$(rs274 -g "$invalid_program" 2>&1)
+    if ! grep -qxF "$message" <<< "$output"; then
+        echo "$invalid_program was not rejected with: $message" >&2
+        echo "$output" >&2
+        exit 1
+    fi
+done
