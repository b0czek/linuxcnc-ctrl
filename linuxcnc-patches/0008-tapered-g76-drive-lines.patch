+// Geometry of one threading pass along a tapered XZ drive line.  X coordinates
+// are offset from the drive line just as they are for a cylindrical thread,
+// while compound offsets and entry/exit distances are measured along that line.
+// It is computed once per pass and used both to check every synchronized lead
+// the pass commands and to issue its moves, so the two cannot disagree.
+struct tapered_pass_geometry {
+    double drive_pitch;                 // synchronized lead along the drive line
+    double pass_start_z, pass_end_z;
+    double back_x, out_x;               // clearance before and after the cut
+    double cut_start_x, cut_end_x;      // drive line offset to the pass depth
+    bool entry;                         // tapered entry
+    double crest_start_x, entry_end_x, entry_end_z, entry_pitch;
+    bool exit;                          // tapered exit
+    double exit_start_x, exit_start_z, crest_end_x, exit_pitch;
+};
+
+static tapered_pass_geometry
+tapered_pass(int boring, double start_x, double start_z,
+	     double end_x, double end_z, double depth, double end_depth,
+	     double compound_offset, double full_compound_offset,
+	     double taper_dist, int entry_taper, int exit_taper, double pitch,
+	     double full_threadheight) {
+    tapered_pass_geometry g = {};
+    const double drive_dx = end_x - start_x;
+    const double drive_dz = end_z - start_z;
+    const double drive_length = hypot(drive_dx, drive_dz);
+    const double drive_x = drive_dx / drive_length;
+    const double drive_z = drive_dz / drive_length;
+    const double depth_direction = boring ? 1.0 : -1.0;
+    g.drive_pitch = pitch * drive_length / fabs(drive_dz);
+
+    const double pass_start_x = start_x + drive_x * compound_offset;
+    g.pass_start_z = start_z + drive_z * compound_offset;
+    const double pass_end_x = end_x + drive_x *
+	(compound_offset - full_compound_offset);
+    g.pass_end_z = end_z + drive_z *
+	(compound_offset - full_compound_offset);
+    g.cut_start_x = pass_start_x + depth_direction * depth;
+    g.cut_end_x = pass_end_x + depth_direction * depth;
+    g.back_x = g.cut_start_x - depth_direction * end_depth;
+    g.out_x = g.cut_end_x - depth_direction * end_depth;
+
+    g.entry = taper_dist && entry_taper;
+    if(g.entry) {
+	g.entry_end_x = g.cut_start_x + drive_x * taper_dist;
+	g.entry_end_z = g.pass_start_z + drive_z * taper_dist;
+	g.crest_start_x = g.cut_start_x - depth_direction * full_threadheight;
+	g.entry_pitch = pitch *
+	    hypot(g.entry_end_x - g.crest_start_x,
+		  g.entry_end_z - g.pass_start_z) /
+	    fabs(g.entry_end_z - g.pass_start_z);
+    }
+
+    g.exit = taper_dist && exit_taper;
+    if(g.exit) {
+	g.exit_start_x = g.cut_end_x - drive_x * taper_dist;
+	g.exit_start_z = g.pass_end_z - drive_z * taper_dist;
+	g.crest_end_x = g.cut_end_x - depth_direction * full_threadheight;
+	g.exit_pitch = pitch *
+	    hypot(g.crest_end_x - g.exit_start_x,
+		  g.pass_end_z - g.exit_start_z) /
+	    fabs(g.pass_end_z - g.exit_start_z);
+    }
+    return g;
+}
+
+// Make one threading pass along a tapered XZ drive line.
+static void
+tapered_threading_pass(setup_pointer settings, block_pointer block,
+		       const tapered_pass_geometry &g, double start_y) {
+    STRAIGHT_TRAVERSE(block->line_number, g.back_x,
+		      start_y, g.pass_start_z, AABBCC); // back
+
+    if(g.entry) {
+	DISABLE_FEED_OVERRIDE();
+	START_SPEED_FEED_SYNCH(settings->active_spindle, g.entry_pitch, 0);
+	STRAIGHT_FEED(block->line_number, g.crest_start_x,
+		      start_y, g.pass_start_z, AABBCC); // in
+	STRAIGHT_FEED(block->line_number, g.entry_end_x,
+		      start_y, g.entry_end_z, AABBCC); // angled in
+	START_SPEED_FEED_SYNCH(settings->active_spindle, g.drive_pitch, 0);
+    } else {
+	STRAIGHT_TRAVERSE(block->line_number, g.cut_start_x,
+			  start_y, g.pass_start_z, AABBCC); // in
+	DISABLE_FEED_OVERRIDE();
+	START_SPEED_FEED_SYNCH(settings->active_spindle, g.drive_pitch, 0);
+    }
+
+    if(g.exit) {
+	STRAIGHT_FEED(block->line_number, g.exit_start_x,
+		      start_y, g.exit_start_z, AABBCC); // over
+	START_SPEED_FEED_SYNCH(settings->active_spindle, g.exit_pitch, 0);
+	STRAIGHT_FEED(block->line_number, g.crest_end_x,
+		      start_y, g.pass_end_z, AABBCC); // angled out
+    } else {
+	STRAIGHT_FEED(block->line_number, g.cut_end_x,
+		      start_y, g.pass_end_z, AABBCC); // over
+    }
+    STOP_SPEED_FEED_SYNCH();
+    STRAIGHT_TRAVERSE(block->line_number, g.out_x,
+		      start_y, g.pass_end_z, AABBCC); // out
+    ENABLE_FEED_OVERRIDE();
+}
+
+int Interp::check_tapered_threading_pass(setup_pointer settings,
+					 const tapered_pass_geometry &g) {
+    // Every move the pass makes while synchronized, at the lead it is
+    // commanded with.  The Z advance per revolution of each is the programmed
+    // pitch, but X moves too, and a tapered entry first feeds in along X alone
+    // at the entry lead.  In G96 the spindle speed is bounded by each move's
+    // own smallest radius.
+    struct sync_move {
+	const char *what;
+	double lead, x0, z0, x1, z1;
+    } moves[4];
+    int count = 0;
+    double drive_x0 = g.cut_start_x, drive_z0 = g.pass_start_z;
+    double drive_x1 = g.cut_end_x, drive_z1 = g.pass_end_z;
+
+    if(g.entry) {
+	moves[count++] = {"G76 entry taper", g.entry_pitch,
+			  g.back_x, g.pass_start_z, g.crest_start_x, g.pass_start_z};
+	moves[count++] = {"G76 entry taper", g.entry_pitch,
+			  g.crest_start_x, g.pass_start_z, g.entry_end_x, g.entry_end_z};
+	drive_x0 = g.entry_end_x;
+	drive_z0 = g.entry_end_z;
+    }
+    if(g.exit) {
+	drive_x1 = g.exit_start_x;
+	drive_z1 = g.exit_start_z;
+    }
+    moves[count++] = {"G76 tapered thread", g.drive_pitch,
+		      drive_x0, drive_z0, drive_x1, drive_z1};
+    if(g.exit)
+	moves[count++] = {"G76 exit taper", g.exit_pitch,
+			  g.exit_start_x, g.exit_start_z, g.crest_end_x, g.pass_end_z};
+
+    for(int i = 0; i < count; i++) {
+	const sync_move &m = moves[i];
+	double delta[9] = {m.x1 - m.x0, 0.0, m.z1 - m.z0, 0, 0, 0, 0, 0, 0};
+	CHP(check_spindle_sync_feed(settings, m.lead, m.what, delta,
+				    min_abs_over_range(m.x0, m.x1)));
+    }
+    return INTERP_OK;
+}
