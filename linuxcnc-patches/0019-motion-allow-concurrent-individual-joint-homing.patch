+static void update_homing_active(void)
+{
+    homing_active = sequence_state != HOME_SEQUENCE_IDLE;
+    for (int joint_num = 0; joint_num < all_joints; joint_num++) {
+        if (H[joint_num].home_state != HOME_IDLE) {
+            homing_active = 1;
+            break;
+        }
+    }
+}
+
+static bool finish_homing_cycle(bool beginning_allhomed)
+{
+    bool completed = !beginning_allhomed && get_allhomed();
+    if (completed) {
+        // control.c may switch to teleop immediately, so finish the sequence
+        // before reporting completion; no later sequence tick is guaranteed.
+        sequence_state = HOME_SEQUENCE_IDLE;
+    }
+    update_homing_active();
+    return completed;
+}
