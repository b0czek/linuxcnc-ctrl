+	      get_home_sequence_is_active())) {
+	    // A sequence may need another servo cycle to observe that its joints
+	    // have finished.  Keep completion asserted until it can accept the
+	    // next HOME request.  Independent homes do not use the sequence
+	    // controller and publish their completion immediately.
+	    joint_status->homing = get_homing(joint_num);
 	}
 	joint_status->homed  = get_homed(joint_num);
 	joint_status->pos_cmd = joint->pos_cmd;
