             }
         }
     } else {
-        sequence_state = HOME_SEQUENCE_DO_ONE_JOINT;
+        // Positive sequences only control HOME ALL ordering.  An individual
+        // request runs this joint's state machine independently.
+        H[jno].home_state = HOME_START;
     }
-    H[jno].home_state = HOME_START;
+    homing_active = 1;
 } // do_home_one_joint()
 
