+static bool base_get_home_is_exclusive(int jno) {
+    // a shared home switch, or a limit switch used as the home switch
+    // (possibly wired in series with other joints' limits), can be
+    // tripped by another joint that is homing at the same time
+    if (H[jno].home_flags & HOME_ABSOLUTE_ENCODER) { return 0; }
+    return (H[jno].home_flags & (HOME_IS_SHARED | HOME_IGNORE_LIMITS)) ? 1 : 0;
+}
+
 static bool base_get_home_is_idle(int jno) {
     return H[jno].home_state == HOME_IDLE ? 1 : 0;
 }
