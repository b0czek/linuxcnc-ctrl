 src/emc/motion/control.c         |  19 ++---
 src/emc/motion/homing.c          | 131 +++++++++++++++++--------------
 src/emc/motion/homing.h          |   7 ++
 src/hal/components/homecomp.comp |  17 ++--
 5 files changed, 119 insertions(+), 78 deletions(-)

diff --git a/src/emc/motion/command.c b/src/emc/motion/command.c
index 9d6fb2c..e8a68ce 100644
--- a/src/emc/motion/command.c
+++ b/src/emc/motion/command.c
@@ -1753,10 +1753,29 @@ void emcmotCommandHandler_locked(void *arg, long servo_period)
 	                   joint_num);
                 return;
 	    }
-	    if ( get_homing_is_active() ) {
-	        reportError("Homing not possible until current homing process is finished.\n");
+	    if (joint_num >= 0 && !get_home_is_idle(joint_num)) {
+	        reportError(_("joint %d is already homing"), joint_num);
+	        emcmotStatus->commandStatus = EMCMOT_COMMAND_INVALID_COMMAND;
+	        return;
+	    }
+	    if (get_home_sequence_is_active() ||
+	        (get_homing_is_active() &&
+	         (joint_num < 0 || get_home_sequence(joint_num) < 0))) {
+	        reportError("Homing sequence not possible until current homing process is finished.\n");
+	        emcmotStatus->commandStatus = EMCMOT_COMMAND_INVALID_COMMAND;
 	        return;
 	    }
+	    /* A shared home switch (or a limit used as home) can be tripped
+	       by another joint homing at the same time. */
+	    for (int n = 0; joint_num >= 0 && n < ALL_JOINTS; n++) {
+	        if (n != joint_num && !get_home_is_idle(n) &&
+	            (get_home_is_exclusive(joint_num) || get_home_is_exclusive(n))) {
+	            reportError(_("Cannot home joint %d while joint %d is homing (shared home or limit switch)"),
+	                        joint_num, n);
+	            emcmotStatus->commandStatus = EMCMOT_COMMAND_INVALID_COMMAND;
+	            return;
+	        }
+	    }
 	    if (!GET_MOTION_ENABLE_FLAG()) {
 		break;
 	    }
diff --git a/src/emc/motion/control.c b/src/emc/motion/control.c
index 7f55169..c75c227 100644
--- a/src/emc/motion/control.c
+++ b/src/emc/motion/control.c
@@ -2742,18 +2742,13 @@ static void update_status(void)
 	}
 #endif
 	joint_status->flag = joint->flag;
-	if(!(joint_status->homing && !get_homing(joint_num) && get_homing_is_active())) {
-		// Prevent race condition.
-		// (See also emc/motion/homing.c: base_write_homing_out_pins())
-		// The homing status variable turns false before get_homing_is_active()
-		// turns false. This means that a new homing command on a joint might
-		// fail due to the homing state machine being active while all joints
-		// already are in the 'not homing' state.
-		// Solution:
-		// Do not update the homing status when going from homing --> not homing
-		// and the state machine is still active. The homing status deassertion
-		// must be delayed until the state machine is done.
-		joint_status->homing = get_homing(joint_num);
+	if (!(joint_status->homing && !get_homing(joint_num) &&
+	      get_home_sequence_is_active())) {
+	    // A sequence may need another servo cycle to observe that its joints
+	    // have finished.  Keep completion asserted until it can accept the
+	    // next HOME request.  Independent homes do not use the sequence
+	    // controller and publish their completion immediately.
+	    joint_status->homing = get_homing(joint_num);
 	}
 	joint_status->homed  = get_homed(joint_num);
 	joint_status->pos_cmd = joint->pos_cmd;
