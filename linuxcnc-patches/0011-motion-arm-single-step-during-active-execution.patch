+STATIC TC_STRUCT *tpFindSourceBlockTarget(TP_STRUCT * const tp, int motion_id)
+{
+    TC_STRUCT *target = 0;
+    for (int i = 0; i < tcqLen(&tp->queue); ++i) {
+        TC_STRUCT *candidate = tcqItem(&tp->queue, i);
+        if (!candidate || candidate->id != motion_id) {
+            break;
+        }
+        target = candidate;
+    }
+    return target;
+}
+
+STATIC void tpRestoreStepTarget(TP_STRUCT * const tp)
+{
+    if (tp->step_target_overridden && tp->step_target_pending &&
+            tp->step_tc) {
+        tp->step_tc->term_cond = tp->step_target_term_cond;
+        tp->step_tc->finalvel = tp->step_target_finalvel;
+        tpRunOptimization(tp);
+    }
+    tp->step_target_overridden = 0;
+}
