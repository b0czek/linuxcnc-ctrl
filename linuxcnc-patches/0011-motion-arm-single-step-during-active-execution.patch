+STATIC TC_STRUCT *tpFindSourceBlockTarget(TP_STRUCT * const tp, int motion_id)
+{
+    TC_STRUCT *target = 0;
+    for (int i = 0; i < tcqLen(&tp->queue); ++i) {
+        TC_STRUCT *candidate = tcqItem(&tp->queue, i);
+        if (!candidate || candidate->id != motion_id) {
+            break;
+        }
+        target = candidate;
+    }
+    return target;
+}
+
+STATIC void tpRestoreStepTarget(TP_STRUCT * const tp)
+{
+    if (tp->step_target_overridden && tp->step_target_pending &&
+            tp->step_tc) {
+        tp->step_tc->term_cond = tp->step_target_term_cond;
+        tp->step_tc->finalvel = tp->step_target_finalvel;
+        tpRunOptimization(tp);
+    }
+    tp->step_target_overridden = 0;
+}
+
 int tpPause(TP_STRUCT * const tp)
 {
     if (0 == tp) {
@@ -4580,10 +4608,12 @@ int tpPause(TP_STRUCT * const tp)
     }
 
     if (tp->stopping) {
+        tpRestoreStepTarget(tp);
         tp->step_tc = 0;
         tp->step_target_pending = 0;
         tp->step_pass_id = 0;
-        tp->stepping_to_pass_clearance = 0;
+        tp->step_motion_id = 0;
+        tp->stepping_to_motion_target = 0;
         TC_STRUCT *tc = tcqItem(&tp->queue, 0);
         /*
          * A G76 cut that has passed spindle index, or its explicitly marked
@@ -4630,7 +4660,7 @@ int tpPause(TP_STRUCT * const tp)
             tp->pausing = 1;
         }
     } else if (emcmotStatus->stepping &&
-            tp->stepping_to_pass_clearance) {
+            tp->stepping_to_motion_target) {
         /*
          * EMCMOT_STEP requests default-TP pass targeting through the existing
          * tpPause ABI. Alternate planners leave step_target_pending clear and
@@ -4639,15 +4669,25 @@ int tpPause(TP_STRUCT * const tp)
         int pass_id = tpGetQueuedG76PassId(tp);
         if (pass_id) {
             tp->step_pass_id = pass_id;
+            tp->step_motion_id = 0;
             tp->step_tc = tpFindG76StepTarget(tp, pass_id);
             tp->step_target_pending = 1;
             tp->pausing = 0;
         } else {
-            tp->step_tc = 0;
-            tp->step_target_pending = 0;
+            TC_STRUCT *tc = tcqItem(&tp->queue, 0);
             tp->step_pass_id = 0;
-            tp->stepping_to_pass_clearance = 0;
-            tp->pausing = 1;
+            tp->step_motion_id = tc ? tc->id : 0;
+            tp->step_tc = tpFindSourceBlockTarget(tp, tp->step_motion_id);
+            tp->step_target_pending = tp->step_tc != 0;
+            if (tp->step_tc) {
+                /* Finalize the latched block as an exact runnable boundary. */
+                tp->step_target_term_cond = tp->step_tc->term_cond;
+                tp->step_target_finalvel = tp->step_tc->finalvel;
+                tp->step_target_overridden = 1;
+                tp->step_tc->term_cond = TC_TERM_COND_STOP;
+                tp->step_tc->finalvel = 0.0;
+            }
+            tp->pausing = !tp->step_target_pending;
         }
     } else {
         tp->pausing = 1;
@@ -4660,6 +4700,7 @@ int tpResume(TP_STRUCT * const tp)
     if (0 == tp) {
         return TP_ERR_FAIL;
     }
+    tpRestoreStepTarget(tp);
     tp->pausing = 0;
     tp->stopping = 0;
     tp->stop_sync_run = 0;
@@ -4669,7 +4710,10 @@ int tpResume(TP_STRUCT * const tp)
     tp->step_tc = 0;
