From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dariusz Majnert <dariusz.majnert@gmail.com>
Date: Wed, 26 Aug 2026 20:51:20 +0200
Subject: [PATCH] motion: arm Single Step during active execution

Forward AUTO_STEP to motion while an AUTO program is already running. The default trajectory planner latches the active source block, or the active G76 safe-approach or infeed-thread-clearance unit, and finishes that unit at an exact boundary before pausing.

Keep later prequeued motion from starting, restore temporary exact boundaries when Step is canceled by Resume or Stop, and report single_stepping while an in-flight step remains armed. Cover ordinary multi-move blocks and an active G76 thread with later passes queued.

Ported onto v2.10.0-pre2. The two in-flight scenarios, already present
in the earlier G76 Stop patch's test list, are added here with the
feature and its program.
---
 src/emc/motion/command.c    | 24 +++++++----
 src/emc/motion/control.c    |  9 +++--
 src/emc/task/emctaskmain.cc | 48 +++++++++++-----------
 src/emc/tp/tp.c             | 80 +++++++++++++++++++++++++++++--------
 src/emc/tp/tp_types.h       |  6 ++-
 5 files changed, 116 insertions(+), 51 deletions(-)

diff --git a/src/emc/motion/command.c b/src/emc/motion/command.c
index a8e8ae3..ff48890 100644
--- a/src/emc/motion/command.c
+++ b/src/emc/motion/command.c
@@ -1334,6 +1334,13 @@ void emcmotCommandHandler_locked(void *arg, long servo_period)
 	    /* pause the motion */
 	    /* can happen at any time */
 	    rtapi_print_msg(RTAPI_MSG_DBG, "PAUSE");
+	    if (emcmotStatus->stepping &&
+		    emcmotInternal->coord_tp.stepping_to_motion_target) {
+		/* Pause overrides an armed Step: drop its target, so this is
+		   an ordinary pause instead of re-arming the Step. */
+		tpResume(&emcmotInternal->coord_tp);
+		emcmotStatus->stepping = 0;
+	    }
 	    tpPause(&emcmotInternal->coord_tp);
 	    emcmotStatus->paused = 1;
 	    break;
@@ -1381,26 +1388,29 @@ void emcmotCommandHandler_locked(void *arg, long servo_period)
 	    break;
 
 	case EMCMOT_STEP:
-	    /* resume paused motion through one G76 pass or until id changes */
+	    /* finish the active/next source block or G76 pass, then pause */
 	    /* can happen at any time */
             rtapi_print_msg(RTAPI_MSG_DBG, "STEP");
-            if(emcmotStatus->paused) {
+            if (!emcmotStatus->stepping &&
+                    tpQueueDepth(&emcmotInternal->coord_tp) > 0) {
                 TP_STRUCT *tp = &emcmotInternal->coord_tp;
-                tpResume(tp);
+                if (emcmotStatus->paused) {
+                    tpResume(tp);
+                }
                 emcmotStatus->stepping = 1;
-                tp->stepping_to_pass_clearance = 1;
+                tp->stepping_to_motion_target = 1;
                 tp->step_target_pending = 0;
                 tpPause(tp);
                 if (!tp->step_target_pending) {
                     tp->step_tc = 0;
                     tp->step_pass_id = 0;
-                    tp->stepping_to_pass_clearance = 0;
+                    tp->step_motion_id = 0;
+                    tp->stepping_to_motion_target = 0;
                     emcmotInternal->idForStep = emcmotStatus->id;
                     tpResume(tp);
                 }
-                emcmotStatus->paused = 1;
             } else {
-		reportError(_("MOTION: can't STEP while already executing"));
+		reportError(_("MOTION: can't STEP without queued motion or while already stepping"));
 	    }
 	    break;
 
