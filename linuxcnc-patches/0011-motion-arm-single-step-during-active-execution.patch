     if (MOTION_ID_VALID(tp->spindle.waiting_for_index)) {
         emcmotStatus->spindle_status[
             tp->spindle.spindle_num].spindle_index_enable = 1;
@@ -4689,7 +4733,11 @@ int tpAbort(TP_STRUCT * const tp)
         tp->step_tc = 0;
         tp->step_target_pending = 0;
         tp->step_pass_id = 0;
-        tp->stepping_to_pass_clearance = 0;
+        tp->step_motion_id = 0;
+        tp->stepping_to_motion_target = 0;
+        tp->step_target_term_cond = 0;
+        tp->step_target_finalvel = 0.0;
+        tp->step_target_overridden = 0;
         tpPause(tp);
         tp->aborting = 1;
     }
