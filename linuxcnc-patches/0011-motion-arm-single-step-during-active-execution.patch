 int stepping = 0;
 int steppingWait = 0;
 static int steppedLine = 0;
+static bool inFlightStepArmed = false;
 /*
  * Pass groups delimit commands that are still owned by task. Motion that was
  * already queued before resumable Stop is stepped by TP to its marked G76
@@ -519,6 +520,7 @@ void emcTaskResetSteppingState()
     steppedLine = 0;
     currentPassGroup = 0;
     steppedPassGroup = 0;
+    inFlightStepArmed = false;
 }
 
 // Variables to handle MDI call interrupts
@@ -904,6 +906,22 @@ static void emcTaskStepInterpreter()
     emcStatus->task.task_paused = 1;
 }
 
+static bool emcTaskArmSingleStep()
+{
+    emcStatus->motion.traj.single_stepping = 1;
+    stepping = 1;
+    steppingWait = 0;
+    if (emcStatus->motion.traj.queue == 0) {
+        emcStatus->task.task_paused = 1;
+        return false;
+    }
+
+    inFlightStepArmed = !emcStatus->motion.traj.paused;
+    emcStatus->task.task_paused = !inFlightStepArmed;
+    emcTrajStep();
+    return true;
+}
+
 static void emcTaskStopClear()
 {
     bool was_active = emcStatus &&
@@ -1566,13 +1584,7 @@ static int emcTaskPlan(void)
 		    break;
 
 		case EMC_TASK_PLAN_STEP_TYPE:
-		    emcStatus->motion.traj.single_stepping = 1;
-		    stepping = 1;	// set stepping mode in case it's not
-		    steppingWait = 0;	// clear the wait
-		    if (emcStatus->motion.traj.paused &&
-			emcStatus->motion.traj.queue > 0) {
-			emcTrajStep();
-		    }
+		    emcTaskArmSingleStep();
 		    break;
 
 		    // otherwise we can't handle it
@@ -1646,17 +1658,9 @@ static int emcTaskPlan(void)
 		    break;
 
 		case EMC_TASK_PLAN_STEP_TYPE:
-		    emcStatus->motion.traj.single_stepping = 1;
-		    stepping = 1;
-		    steppingWait = 0;
-		    if (emcStatus->motion.traj.paused &&
-			emcStatus->motion.traj.queue > 0) {
-			// there are pending motions paused; step them
-			emcTrajStep();
-		    } else {
+		    if (!emcTaskArmSingleStep()) {
 			emcStatus->task.interpState = interpResumeState;
 		    }
-		    emcStatus->task.task_paused = 1;
 		    break;
 
 		    // otherwise we can't handle it
@@ -1722,13 +1726,7 @@ static int emcTaskPlan(void)
 		    break;
 
 		case EMC_TASK_PLAN_STEP_TYPE:
-		    emcStatus->motion.traj.single_stepping = 1;
-		    stepping = 1;	// set stepping mode in case it's not
-		    steppingWait = 0;	// clear the wait
-		    if (emcStatus->motion.traj.paused &&
-			emcStatus->motion.traj.queue > 0) {
-			emcTrajStep();
-		    }
+		    emcTaskArmSingleStep();
 		    break;
 
 		    // otherwise we can't handle it
@@ -4102,6 +4100,10 @@ int main(int argc, char *argv[])
 	// update subordinate status
 
 	emcMotionUpdate(&emcStatus->motion);
+	if (inFlightStepArmed && emcStatus->motion.traj.paused) {
