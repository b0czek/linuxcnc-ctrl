+static bool emcTaskArmSingleStep()
+{
+    emcStatus->motion.traj.single_stepping = 1;
+    stepping = 1;
+    steppingWait = 0;
+    if (emcStatus->motion.traj.queue == 0) {
+        emcStatus->task.task_paused = 1;
+        return false;
+    }
+
+    inFlightStepArmed = !emcStatus->motion.traj.paused;
+    emcStatus->task.task_paused = !inFlightStepArmed;
+    emcTrajStep();
+    return true;
