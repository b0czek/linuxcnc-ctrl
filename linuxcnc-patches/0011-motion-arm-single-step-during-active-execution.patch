+/*
+ * The last queued segment of the position-synchronized run at the head of the
+ * queue. Stopping between the moves of one run would leave the axis behind
+ * the turning spindle, so Step, like Stop, ends at the end of the run.
+ */
+STATIC TC_STRUCT *tpFindSyncRunTarget(TP_STRUCT * const tp)
+{
+    TC_STRUCT *target = 0;
+    for (int i = 0; i < tcqLen(&tp->queue); ++i) {
+        TC_STRUCT *candidate = tcqItem(&tp->queue, i);
+        if (!candidate || candidate->synchronized != TC_SYNC_POSITION) {
+            break;
+        }
+        target = candidate;
+    }
+    return target;
+}
+
+STATIC void tpRestoreStepTarget(TP_STRUCT * const tp)
+{
+    if (tp->step_target_overridden) {
+        for (int i = 0; i < tcqLen(&tp->queue); ++i) {
+            TC_STRUCT *tc = tcqItem(&tp->queue, i);
+            if (tc && tc->step_saved) {
+                tc->term_cond = tc->step_saved_term_cond;
+                tc->finalvel = tc->step_saved_finalvel;
+                tc->step_saved = 0;
+            }
+        }
+        tpRunOptimization(tp);
+    }
+    tp->step_target_overridden = 0;
+}
+
+STATIC void tpOverrideStepSegment(TP_STRUCT * const tp, TC_STRUCT * const tc,
+        int term_cond, double finalvel)
+{
+    if (!tc->step_saved) {
+        tc->step_saved = 1;
+        tc->step_saved_term_cond = tc->term_cond;
+        tc->step_saved_finalvel = tc->finalvel;
+    }
+    tc->term_cond = term_cond;
+    tc->finalvel = finalvel;
+    tp->step_target_overridden = 1;
+}
+
+/* Fastest start from which tc can still slow to end_vel within its length. */
+STATIC double tpStepMaxStartVel(TC_STRUCT const * const tc, double end_vel)
+{
+    double acc = tcGetTangentialMaxAccel(tc);
+    double start_vel = pmSqrt(pmSq(end_vel) + 2.0 * acc * tc->target);
+    if (GET_TRAJ_PLANNER_TYPE() == 1) {
+        double jerk = fmin(tc->maxjerk, emcmotStatus->jerk);
+        double scurve_vel;
+        if (findSCurveMaxStartSpeed(tc->target, end_vel, acc, jerk,
+                    &scurve_vel) == 1) {
+            start_vel = fmin(start_vel, scurve_vel);
+        } else {
+            start_vel = end_vel;
+        }
+    }
+    return start_vel;
+}
+
+/*
+ * Queue index where a Single Step armed now stops: the end of the source
+ * block in progress or, when that end is closer than the distance needed to
+ * stop from the current speed within the acceleration (and, for S-curve, jerk)
+ * limits, the first later block end that is far enough. A block end the
+ * planner already brings to rest (an exact stop or the end of the queue) is
+ * always reachable.
+ */
+STATIC int tpFindReachableStepTarget(TP_STRUCT * const tp)
+{
+    int len = tcqLen(&tp->queue);
+    TC_STRUCT *head = tcqItem(&tp->queue, 0);
+    if (!head) {
+        return -1;
+    }
+    double vel = head->currentvel;
+    if (head->blending_next) {
+        TC_STRUCT *next = tcqItem(&tp->queue, 1);
+        if (next) {
+            vel += next->currentvel;
+        }
+    }
+    double dist = tcGetDistanceToGo(head, tp->reverse_run);
+    double acc = tcGetTangentialMaxAccel(head);
+    double jerk = fmin(head->maxjerk, emcmotStatus->jerk);
+    for (int i = 0; i < len; ++i) {
+        TC_STRUCT *tc = tcqItem(&tp->queue, i);
+        if (i > 0) {
+            // A segment already blending in has run part of its length.
+            dist += i == 1 && head->blending_next ?
+                tcGetDistanceToGo(tc, tp->reverse_run) : tc->target;
+            acc = fmin(acc, tcGetTangentialMaxAccel(tc));
+            jerk = fmin(jerk, fmin(tc->maxjerk, emcmotStatus->jerk));
+        }
+        TC_STRUCT *next = tcqItem(&tp->queue, i + 1);
+        if (next && next->id == tc->id) {
+            continue;
+        }
+        // The head's blend into the next segment is under way; an exact
+        // stop at the head's end can no longer be made.
+        if (i == 0 && next && head->blending_next) {
+            continue;
+        }
+        if (!next || tc->term_cond != TC_TERM_COND_TANGENT) {
+            return i;
+        }
+        double stop_dist = GET_TRAJ_PLANNER_TYPE() == 1 ?
+            stoppingDist(vel, head->currentacc, acc, jerk) :
+            pmSq(vel) / (2.0 * acc);
+        // Braking starts in the next servo cycle at the earliest.
+        stop_dist += vel * tp->cycleTime;
+        if (dist >= stop_dist) {
+            return i;
+        }
+    }
+    return len - 1;
+}
+
+/*
+ * Make the chosen block end an exact stop, and lower the end speed of every
+ * segment before it so each can still slow down in time, as tpRunOptimization
+ * does for segments it queues. Returns the target segment.
+ */
+STATIC TC_STRUCT *tpArmReachableStepTarget(TP_STRUCT * const tp)
+{
+    int target = tpFindReachableStepTarget(tp);
+    if (target < 0) {
+        return 0;
+    }
+    TC_STRUCT *step_tc = tcqItem(&tp->queue, target);
+    tpOverrideStepSegment(tp, step_tc, TC_TERM_COND_STOP, 0.0);
+    for (int i = target - 1; i >= 0; --i) {
+        TC_STRUCT *tc = tcqItem(&tp->queue, i);
+        TC_STRUCT *next = tcqItem(&tp->queue, i + 1);
+        if (tc->term_cond != TC_TERM_COND_TANGENT) {
+            continue;
+        }
+        double next_end = next->term_cond == TC_TERM_COND_TANGENT ?
+            next->finalvel : 0.0;
+        double limit = tpStepMaxStartVel(next, next_end);
+        if (limit < tc->finalvel) {
+            tpOverrideStepSegment(tp, tc, tc->term_cond, limit);
+        }
+    }
+    return step_tc;
+}
