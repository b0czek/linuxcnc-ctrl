 }
 
+// The call stack was unwound while this frame's generator was running. Close
+// it now that it has yielded or finished, and return the status of the
+// unwind so that the caller does not continue the unwound call.
+static int finish_unwound_generator(context_pointer frame)
+{
+    int unwind_status = frame->pystuff.impl->close_status;
+
+    frame->pystuff.close_generator(unwind_status);
+    if (unwind_status == INTERP_EXIT)
+        return INTERP_EXIT;
+    return unwind_status > INTERP_MIN_ERROR ? unwind_status : INTERP_ERROR;
+}
+
 // all parameters to/results from Python calls go through the callframe, which looks a bit awkward
 // the reason is not to expose boost.python through the interpreter public interface
 int Interp::pycall(setup_pointer /*settings*/,
@@ -151,13 +164,19 @@ int Interp::pycall(setup_pointer /*settings*/,
 		    bp::handle_exception();
 		    PyErr_Clear();
 		    logPy("pycall: call generator - StopIteration exception");
+		    if (frame->pystuff.impl->close_pending)
+			return finish_unwound_generator(frame);
+		    frame->pystuff.impl->generator_next = bp::object();
+		    frame->pystuff.impl->generator = bp::object();
 		    return INTERP_OK;
 		} else  {
 		    msg = handle_pyerror();
 		    bp::handle_exception();
 		    PyErr_Clear();
 		    logPy("pycall: call generator - exception: %s",msg.c_str());
-		    
+		    if (frame->pystuff.impl->close_pending)
+			(void) finish_unwound_generator(frame);
+
 		    ERS("exception during generator call: %s", msg.c_str());
 		}
 	    } else 
@@ -193,6 +212,7 @@ int Interp::pycall(setup_pointer /*settings*/,
 
 		    // a generator was returned. This must have been the first time call to a handler
 		    // which contains a yield. Extract next() method.
+		    frame->pystuff.impl->generator = retval;
 		    frame->pystuff.impl->generator_next = bp::getattr(retval, "__next__");
 		    // and  call it for the first time.
 		    // Expect execution up to first 'yield INTERP_EXECUTE_FINISH'.
@@ -264,6 +284,11 @@ int Interp::pycall(setup_pointer /*settings*/,
 	bp::handle_exception();
 	PyErr_Clear();
     }
+    if (frame->pystuff.impl->close_pending) {
+	int unwind_status = finish_unwound_generator(frame);
+	if (!py_exception)
+	    return unwind_status;
+    }
     if (py_exception) {
 	ERM("pycall: %s.%s:\n%s", module ? module:"", funcname, msg.c_str());
 	status = INTERP_ERROR;
@@ -298,3 +323,36 @@ pycontext &pycontext::operator=(const pycontext &other) {
     impl = new pycontext_impl(*other.impl);
     return *this;
 }
+
+void pycontext::close_generator(int unwind_status)
+{
+    if (!impl->generator.ptr() || impl->generator.ptr() == Py_None)
+        return;
+
+    // An unwind started from inside the generator itself (a nested
+    // self.execute() that fails or reaches M2/M30) cannot close it while it
+    // runs, and must not drop the references the running call relies on.
+    bp::object running = PyGen_Check(impl->generator.ptr())
+        ? bp::object(impl->generator.attr("gi_running")) : bp::object(false);
+    if (PyObject_IsTrue(running.ptr()) == 1) {
+        impl->close_pending = true;
+        impl->close_status = unwind_status;
+        return;
+    }
+
+    try {
+        impl->generator.attr("close")();
+    } catch (bp::error_already_set &) {
+        std::string msg;
+        if (PyErr_Occurred())
+            msg = handle_pyerror();
+        bp::handle_exception();
+        PyErr_Clear();
+        fprintf(stderr, "error closing aborted Python remap generator: %s\n",
+                msg.c_str());
+    }
+
+    impl->generator_next = bp::object();
+    impl->generator = bp::object();
+    impl->close_pending = false;
+}
diff --git a/src/emc/rs274ngc/interp_python.hh b/src/emc/rs274ngc/interp_python.hh
index 3fcf26b..baedeab 100644
--- a/src/emc/rs274ngc/interp_python.hh
+++ b/src/emc/rs274ngc/interp_python.hh
@@ -10,6 +10,13 @@ struct pycontext_impl {
     int py_return_type;   // type of Python return value - enum retopts 
     double py_returned_double;
     int py_returned_int;
+    // Keep the generator itself so abort can close it and run Python finally
+    // blocks before the remap context is discarded.
+    boost::python::object generator;
+    // The call stack was unwound while the generator was running, so it
+    // could not be closed then. pycall() closes it once control returns.
+    bool close_pending = false;
+    int close_status = 0;
     // generator object next method as returned if Python function contained a yield statement
     boost::python::object generator_next; 
 };
