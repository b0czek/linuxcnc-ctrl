+// The call stack was unwound while this frame's generator was running. Close
+// it now that it has yielded or finished, and return the status of the
+// unwind so that the caller does not continue the unwound call.
+static int finish_unwound_generator(context_pointer frame)
+{
+    int unwind_status = frame->pystuff.impl->close_status;
+
+    frame->pystuff.close_generator(unwind_status);
+    if (unwind_status == INTERP_EXIT)
+        return INTERP_EXIT;
+    return unwind_status > INTERP_MIN_ERROR ? unwind_status : INTERP_ERROR;
+}
+
 // all parameters to/results from Python calls go through the callframe, which looks a bit awkward
 // the reason is not to expose boost.python through the interpreter public interface
 int Interp::pycall(setup_pointer /*settings*/,
@@ -151,13 +164,19 @@ int Interp::pycall(setup_pointer /*settings*/,
 		    bp::handle_exception();
 		    PyErr_Clear();
 		    logPy("pycall: call generator - StopIteration exception");
+		    if (frame->pystuff.impl->close_pending)
+			return finish_unwound_generator(frame);
+		    frame->pystuff.impl->generator_next = bp::object();
+		    frame->pystuff.impl->generator = bp::object();
 		    return INTERP_OK;
 		} else  {
 		    msg = handle_pyerror();
 		    bp::handle_exception();
 		    PyErr_Clear();
 		    logPy("pycall: call generator - exception: %s",msg.c_str());
-		    
+		    if (frame->pystuff.impl->close_pending)
+			(void) finish_unwound_generator(frame);
+
 		    ERS("exception during generator call: %s", msg.c_str());
 		}
 	    } else 
@@ -193,11 +212,24 @@ int Interp::pycall(setup_pointer /*settings*/,
 
 		    // a generator was returned. This must have been the first time call to a handler
 		    // which contains a yield. Extract next() method.
+		    frame->pystuff.impl->generator = retval;
 		    frame->pystuff.impl->generator_next = bp::getattr(retval, "__next__");
 		    // and  call it for the first time.
 		    // Expect execution up to first 'yield INTERP_EXECUTE_FINISH'.
-		    frame->pystuff.impl->py_returned_int = bp::extract<int>(frame->pystuff.impl->generator_next());
-		    frame->pystuff.impl->py_return_type = RET_YIELD;
+		    try {
+			frame->pystuff.impl->py_returned_int = bp::extract<int>(frame->pystuff.impl->generator_next());
+			frame->pystuff.impl->py_return_type = RET_YIELD;
+		    } catch (bp::error_already_set &) {
+			if (!PyErr_ExceptionMatches(PyExc_StopIteration))
+			    throw;
+			// A generator that returns before its first yield ends
+			// normally, as it does after a later one (for example an
+			// executor helper in preview, where nothing is run).
+			PyErr_Clear();
+			frame->pystuff.impl->py_return_type = RET_STOPITERATION;
+			frame->pystuff.impl->generator_next = bp::object();
+			frame->pystuff.impl->generator = bp::object();
+		    }
         } else if (PyUnicode_Check(retval.ptr())) {
 		    // returning a string sets the interpreter error message and aborts
 		    char *msg = bp::extract<char *>(retval);
@@ -264,6 +296,11 @@ int Interp::pycall(setup_pointer /*settings*/,
 	bp::handle_exception();
 	PyErr_Clear();
     }
+    if (frame->pystuff.impl->close_pending) {
+	int unwind_status = finish_unwound_generator(frame);
+	if (!py_exception)
