From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dariusz Majnert <dariusz.majnert@gmail.com>
Date: Wed, 2 Sep 2026 15:31:24 +0200
Subject: [PATCH] fix(spindle): publish modal CSS maximum in status

---
 src/emc/task/emccanon.cc                      | 4 +++-
 src/emc/task/emctaskmain.cc                   | 2 +-
 src/emc/task/taskintf.cc                      | 2 +-
 src/emc/usr_intf/axis/extensions/emcmodule.cc | 1 +
 4 files changed, 6 insertions(+), 3 deletions(-)

diff --git a/src/emc/task/emccanon.cc b/src/emc/task/emccanon.cc
index 513c932..d6e8437 100644
--- a/src/emc/task/emccanon.cc
+++ b/src/emc/task/emccanon.cc
@@ -2868,7 +2868,9 @@ void SPINDLE_RETRACT_TRAVERSE()
 }
 
 void SET_SPINDLE_MODE(int spindle, double css_max) {
-   canon.spindle[spindle].css_maximum = fabs(css_max);
+    canon.spindle[spindle].css_maximum = fabs(css_max);
+    emcStatus->motion.spindle[spindle].css_maximum =
+        canon.spindle[spindle].css_maximum;
 }
 
 template <class MSG=EMC_SPINDLE_ON>
diff --git a/src/emc/task/emctaskmain.cc b/src/emc/task/emctaskmain.cc
index a93574e..5880f9a 100644
--- a/src/emc/task/emctaskmain.cc
+++ b/src/emc/task/emctaskmain.cc
@@ -1084,7 +1084,7 @@ static void emcTaskStopProgress()
         bool spindle_output_active = false;
         for (int s = 0; s < emcStatus->motion.traj.spindles; ++s) {
             const auto &status = emcStatus->motion.spindle[s];
-            bool spindle_running = status.enabled || status.direction != 0;
+            bool spindle_running = status.enabled;
             if (!stop_outputs_saved) {
                 stop_spindles[s].running = spindle_running;
                 stop_spindles[s].speed = status.speed;
diff --git a/src/emc/task/taskintf.cc b/src/emc/task/taskintf.cc
index 3328659..aa63ab4 100644
--- a/src/emc/task/taskintf.cc
+++ b/src/emc/task/taskintf.cc
@@ -2184,7 +2184,7 @@ int emcSpindleUpdate(EMC_SPINDLE_STAT stat[], int num_spindles){
 
     for (s = 0; s < num_spindles; s++){
 		stat[s].spindle_override_enabled = enables & SS_ENABLED;
-		stat[s].enabled = emcmotStatus.spindle_status[s].speed != 0;
+		stat[s].enabled = emcmotStatus.spindle_status[s].state != 0;
 		stat[s].speed = emcmotStatus.spindle_status[s].speed;
 		stat[s].feedback = emcmotStatus.spindle_status[s].spindleSpeedIn * 60.0;
 		stat[s].brake = emcmotStatus.spindle_status[s].brake;
diff --git a/src/emc/usr_intf/axis/extensions/emcmodule.cc b/src/emc/usr_intf/axis/extensions/emcmodule.cc
index 74edfa0..af63368 100644
--- a/src/emc/usr_intf/axis/extensions/emcmodule.cc
+++ b/src/emc/usr_intf/axis/extensions/emcmodule.cc
@@ -1463,6 +1463,7 @@ static PyObject *Stat_spindle_one(pyStatChannel *s, int spindleno) {
     F2("override_enabled", spindle_override_enabled);
     F(speed);
     F(feedback);
+    F2("css_maximum", css_maximum);
     F2("override", spindle_scale);
     F(homed);
     F(orient_state);
