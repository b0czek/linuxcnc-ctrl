From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dariusz Majnert <dariusz.majnert@gmail.com>
Date: Sun, 23 Aug 2026 22:34:37 +0200
Subject: [PATCH] rs274: support the native G-code preview

The native server records previews with its own canon implementation. Two
things it needs have to live in LinuxCNC. The interpreter reports cutter
compensation being switched on and off through the canon calls that already
exist for it, so a recording keeps that state. tool_mmap_user() is safe to
call from several threads and returns early for an existing mapping; it
keeps upstream's record of the mapping descriptor (8c8e048).
---
 src/emc/rs274ngc/interp_convert.cc           |   6 ++
 src/emc/tooldata/tooldata_mmap.cc            |   4 +
 tests/ccomp/lathe-comp/expected              |   4 +
 tests/ccomp/mill-g90g91g92/expected          |   2 +
 tests/ccomp/mill-line-arc-entry/expected     |   2 +
 tests/ccomp/mill-zchanges/expected           |  20 ++++
 tests/interp/cam-nisley/expected             |   2 +
 tests/interp/crazy-paths/expected            | 100 +++++++++++++++++++
 tests/interp/g71-endless-loop_2/expected     |   2 +
 tests/interp/inside-corners/expected         |  12 +++
 tests/interp/inverse-time-with-comp/expected |   6 ++
 11 files changed, 160 insertions(+)

diff --git a/src/emc/rs274ngc/interp_convert.cc b/src/emc/rs274ngc/interp_convert.cc
index 663668a..a823ac5 100644
--- a/src/emc/rs274ngc/interp_convert.cc
+++ b/src/emc/rs274ngc/interp_convert.cc
@@ -2528,6 +2528,7 @@ Called by: convert_cutter_compensation
 
 int Interp::convert_cutter_compensation_off(setup_pointer settings)      //!< pointer to machine settings
 {
+  const bool was_enabled = settings->cutter_comp_side != CUTTER_COMP::OFF;
 #ifdef DEBUG_EMC
   enqueue_COMMENT("interpreter: cutter radius compensation off");
 #endif
@@ -2544,6 +2545,9 @@ int Interp::convert_cutter_compensation_off(setup_pointer settings)      //!< po
   }
   settings->cutter_comp_side = CUTTER_COMP::OFF;
   settings->cutter_comp_firstmove = true;
+  if (was_enabled) {
+    STOP_CUTTER_RADIUS_COMPENSATION();
+  }
   return INTERP_OK;
 }
 
@@ -2652,6 +2656,8 @@ int Interp::convert_cutter_compensation_on(CUTTER_COMP side,     //!< side of pa
   settings->cutter_comp_radius = radius;
   settings->cutter_comp_orientation = orientation;
   settings->cutter_comp_side = side;
+  START_CUTTER_RADIUS_COMPENSATION(
+      side == CUTTER_COMP::LEFT ? CANON_SIDE_LEFT : CANON_SIDE_RIGHT);
   return INTERP_OK;
 }
 
