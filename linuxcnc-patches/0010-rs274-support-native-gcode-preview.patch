@@ -185,6 +186,9 @@ int tool_mmap_creator(EMC_TOOL_STAT const * ptr,int random_toolchanger)
 //typ: milltask, guis (emcmodule,emcsh,...), halui
 int tool_mmap_user()
 {
+    static std::mutex user_mapping_mutex;
+    const std::lock_guard<std::mutex> lock(user_mapping_mutex);
+    if (tool_mmap_base) return 0;
     int fd = open(tool_mmap_fname(),
                   TOOL_MMAP_USER_OPEN_FLAGS, TOOL_MMAP_MODE);
 
