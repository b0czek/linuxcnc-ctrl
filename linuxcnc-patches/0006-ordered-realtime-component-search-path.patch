diff --git a/src/rtapi/rtmod_path.c b/src/rtapi/rtmod_path.c
new file mode 100644
index 0000000..763fe5f
--- /dev/null
+++ b/src/rtapi/rtmod_path.c
@@ -0,0 +1,195 @@
+#include "config.h"
+#include "rtmod_path.h"
+
+#include <dirent.h>
+#include <errno.h>
+#include <limits.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#ifndef EMC2_EXTRA_RTLIB_DIRS
+#define EMC2_EXTRA_RTLIB_DIRS ""
+#endif
+
+static void set_error(char *error, size_t size, const char *format, ...) {
+    va_list ap;
+    if (!error || !size) return;
+    va_start(ap, format);
+    vsnprintf(error, size, format, ap);
+    va_end(ap);
+}
+
+static char *normalize(const char *value) {
+    size_t n;
+    char *copy;
+    if (!value || value[0] != '/') return NULL;
+    copy = strdup(value);
+    if (!copy) return NULL;
+    n = strlen(copy);
+    while (n > 1 && copy[n - 1] == '/') copy[--n] = 0;
+    return copy;
+}
+
+static int append_unique(rtmod_path_t *path, char *dir) {
+    size_t i;
+    char **next;
+    for (i = 0; i < path->count; i++) {
+        if (!strcmp(path->dirs[i], dir)) { free(dir); return 0; }
+    }
+    next = (char **)realloc(path->dirs, (path->count + 1) * sizeof(char *));
+    if (!next) { free(dir); return -1; }
+    path->dirs = next;
+    path->dirs[path->count++] = dir;
+    return 0;
+}
+
+static int parse_list(const char *list, rtmod_path_t *path, int reject_empty,
+                      char *error, size_t error_size) {
+    const char *start = list, *end;
+    if (!list || !*list) {
+        if (reject_empty) set_error(error, error_size, "HAL_RTMOD_PATH must not be empty");
+        return reject_empty ? -1 : 0;
+    }
+    do {
+        char *entry, *norm;
+        size_t len;
+        end = strchr(start, ':');
+        len = end ? (size_t)(end - start) : strlen(start);
+        if (!len) {
+            set_error(error, error_size, "realtime module path contains an empty element");
+            return -1;
+        }
+        entry = (char *)malloc(len + 1);
+        if (!entry) return -1;
+        memcpy(entry, start, len); entry[len] = 0;
+        norm = normalize(entry); free(entry);
+        if (!norm) {
+            set_error(error, error_size, "realtime module directory must be absolute: %.*s", (int)len, start);
+            return -1;
+        }
+        if (append_unique(path, norm)) return -1;
+        start = end ? end + 1 : NULL;
+    } while (start);
+    return 0;
+}
+
+static int trusted_dir(const char *dir) {
+    rtmod_path_t trusted = {0};
+    char combined[PATH_MAX * 2];
+    size_t i;
+    int found = 0;
+    if (EMC2_EXTRA_RTLIB_DIRS[0])
+        snprintf(combined, sizeof(combined), "%s:%s", EMC2_RTLIB_DIR, EMC2_EXTRA_RTLIB_DIRS);
+    else
+        snprintf(combined, sizeof(combined), "%s", EMC2_RTLIB_DIR);
+    if (parse_list(combined, &trusted, 1, NULL, 0)) return 0;
+    for (i = 0; i < trusted.count; i++) if (!strcmp(dir, trusted.dirs[i])) found = 1;
+    rtmod_path_free(&trusted);
+    return found;
+}
+
+int rtmod_path_init(rtmod_path_t *path, const char *env_path,
+                    char *error, size_t error_size) {
+    size_t i;
+    memset(path, 0, sizeof(*path));
+    if (parse_list(env_path ? env_path : EMC2_RTLIB_DIR, path, 1, error, error_size)) goto fail;
+    for (i = 0; i < path->count; i++) {
+        if (!trusted_dir(path->dirs[i])) {
+            set_error(error, error_size, "unauthorized realtime module directory: %s", path->dirs[i]);
+            goto fail;
+        }
+    }
+    return 0;
+fail:
+    rtmod_path_free(path);
+    return -1;
+}
+
+void rtmod_path_free(rtmod_path_t *path) {
+    size_t i;
+    if (!path) return;
+    for (i = 0; i < path->count; i++) free(path->dirs[i]);
+    free(path->dirs); path->dirs = NULL; path->count = 0;
+}
+
+int rtmod_name_valid(const char *name) {
+    return name && *name && !strchr(name, '/') && !strstr(name, "..");
+}
+
+static int contained_file(const char *dir, const char *candidate) {
+    char real_dir[PATH_MAX], real_file[PATH_MAX];
+    size_t n;
+    if (!realpath(dir, real_dir) || !realpath(candidate, real_file)) return 0;
+    n = strlen(real_dir);
+    return !strncmp(real_dir, real_file, n) && real_file[n] == '/';
+}
+
+int rtmod_path_resolve(const rtmod_path_t *path, const char *name,
+                       int core_module, char *result, size_t result_size,
+                       char *error, size_t error_size) {
+    size_t i, count = core_module ? 1 : path->count;
+    struct stat st;
+    if (!rtmod_name_valid(name)) {
+        set_error(error, error_size, "invalid realtime component name '%s'", name ? name : "");
+        return -1;
+    }
+    for (i = 0; i < count; i++) {
+        const char *dir = core_module ? EMC2_RTLIB_DIR : path->dirs[i];
+        int n = snprintf(result, result_size, "%s/%s%s", dir, name, MODULE_EXT);
+        if (n < 0 || (size_t)n >= result_size) {
+            set_error(error, error_size, "realtime module path is too long"); return -1;
+        }
+        if (!stat(result, &st) && S_ISREG(st.st_mode)) {
+            if (!contained_file(dir, result)) {
+                set_error(error, error_size, "realtime module escapes trusted directory: %s", result);
+                return -1;
+            }
+            return 0;
+        }
+    }
+    if (core_module)
+        set_error(error, error_size, "can't find realtime component '%s'; searched: %s", name, EMC2_RTLIB_DIR);
+    else {
+        size_t used = (size_t)snprintf(error, error_size, "can't find realtime component '%s'; searched:", name);
+        for (i = 0; i < path->count && used < error_size; i++)
+            used += (size_t)snprintf(error + used, error_size - used, "%s%s", i ? ":" : " ", path->dirs[i]);
+    }
+    return -1;
+}
+
+int rtmod_path_is_trusted_file(const char *filename, char *module_name,
+                               size_t module_name_size) {
+    char copy[PATH_MAX], *slash, *ext;
+    struct stat st;
+    if (!filename || strlen(filename) >= sizeof(copy)) return 0;
+    strcpy(copy, filename); slash = strrchr(copy, '/');
+    if (!slash || copy[0] != '/' || strstr(filename, "..")) return 0;
+    *slash++ = 0;
+    if (!trusted_dir(copy) || stat(filename, &st) || !S_ISREG(st.st_mode) || !contained_file(copy, filename)) return 0;
+    ext = strstr(slash, MODULE_EXT);
+    if (!ext || ext[strlen(MODULE_EXT)] || ext == slash) return 0;
+    *ext = 0;
+    if (!rtmod_name_valid(slash) || strlen(slash) >= module_name_size) return 0;
+    if ((!strcmp(slash, "rtapi") || !strcmp(slash, "hal_lib")) && strcmp(copy, EMC2_RTLIB_DIR)) return 0;
+    strcpy(module_name, slash);
+    return 1;
+}
+
+int rtmod_path_is_trusted_module(const char *name) {
+    rtmod_path_t trusted = {0};
+    char combined[PATH_MAX * 2], candidate[PATH_MAX], error[256];
+    if (!rtmod_name_valid(name)) return 0;
+    if (EMC2_EXTRA_RTLIB_DIRS[0])
+        snprintf(combined, sizeof(combined), "%s:%s", EMC2_RTLIB_DIR, EMC2_EXTRA_RTLIB_DIRS);
+    else
+        snprintf(combined, sizeof(combined), "%s", EMC2_RTLIB_DIR);
+    if (rtmod_path_init(&trusted, combined, error, sizeof(error))) return 0;
+    if (!rtmod_path_resolve(&trusted, name, 0, candidate, sizeof(candidate), error, sizeof(error))) {
+        rtmod_path_free(&trusted); return 1;
+    }
+    rtmod_path_free(&trusted); return 0;
+}
