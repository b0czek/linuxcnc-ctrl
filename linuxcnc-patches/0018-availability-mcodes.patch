diff --git a/tests/interp/availability-mcodes/execute-status.cc b/tests/interp/availability-mcodes/execute-status.cc
new file mode 100644
index 0000000000..554485e05a
--- /dev/null
+++ b/tests/interp/availability-mcodes/execute-status.cc
@@ -0,0 +1,26 @@
+#include "rs274ngc.hh"
+#include "interp_return.hh"
+#include <cassert>
+#include <cstdlib>
+int _task = 0;
+InterpBase *pinterp;
+int main(int argc, char **argv) {
+    assert(argc == 4);
+    setenv("INI_FILE_NAME", argv[1], 1);
+    auto interp = pinterp = makeInterp();
+    assert(interp->init() == INTERP_OK);
+    assert(interp->open(argv[2]) == INTERP_OK);
+    int finishes = 0;
+    for (int n = 0; n < 100; n++) {
+        int read = interp->read();
+        assert(read == INTERP_OK);
+        int result = interp->execute();
+        if (result == INTERP_EXIT) {
+            assert(finishes == atoi(argv[3]));
+            return 0;
+        }
+        assert(result == INTERP_OK || result == INTERP_EXECUTE_FINISH);
+        if (result == INTERP_EXECUTE_FINISH) finishes++;
+    }
+    abort();
+}
diff --git a/tests/interp/availability-mcodes/execute-status.py b/tests/interp/availability-mcodes/execute-status.py
new file mode 100644
index 0000000000..510677b7fd
--- /dev/null
+++ b/tests/interp/availability-mcodes/execute-status.py
@@ -0,0 +1,26 @@
+#!/usr/bin/env python3
+"""Check actual execute return codes using the production interpreter/canon."""
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+root = Path(os.environ.get('LINUXCNC_TEST_ROOT', Path(__file__).resolve().parents[3]))
+with tempfile.TemporaryDirectory() as directory:
+    binary = str(Path(directory) / 'execute-status')
+    objects = root / 'src/objects/emc'
+    command = [os.environ.get('CXX', 'c++'), 'execute-status.cc',
+               '-I' + str(root / 'include'),
+               str(objects / 'sai/saicanon.o'),
+               str(objects / 'sai/dummyemcstat.o'),
+               str(objects / 'task/taskclass.o'),
+               '-L' + str(root / 'lib'), '-Wl,-rpath,' + str(root / 'lib'),
+               '-lrs274', '-llinuxcnc', '-lnml', '-llinuxcnchal',
+               '-llinuxcncini', '-lpyplugin', '-ltooldata']
+    command += subprocess.check_output(['python3-config', '--embed', '--ldflags'], text=True).split()
+    subprocess.run(command + ['-o', binary], check=True)
+    for ini, program, finishes in [('remap.ini', 'remapped.ngc', '0'),
+                                   ('test.ini', 'valid-joint.ngc', '2'),
+                                   ('test.ini', 'valid-spindle.ngc', '2')]:
+        result = subprocess.run([binary, ini, program, finishes], capture_output=True, text=True)
+        if result.returncode:
+            raise AssertionError(f'{ini} {program}: {result.returncode}\n{result.stdout}\n{result.stderr}')
