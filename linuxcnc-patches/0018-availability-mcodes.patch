+{
+    auto message = std::make_unique<EMC_JOINT_SET_AVAILABILITY>();
+    flush_segments();
+    message->joint = joint;
+    message->available = !!available;
+    interp_list.append(std::move(message));
+}
+
+void SET_SPINDLE_AVAILABILITY(int spindle, int available)
+{
+    auto message = std::make_unique<EMC_SPINDLE_SET_AVAILABILITY>();
+    flush_segments();
+    message->spindle = spindle;
+    message->available = !!available;
+    interp_list.append(std::move(message));
+}
