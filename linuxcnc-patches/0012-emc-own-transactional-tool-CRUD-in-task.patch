+#!/usr/bin/env python3
+"""A table with CRLF line ends, blank lines (CR included) and a
+comment-only line loads whole, and saving it works."""
+
+from common import *
+
+start()
+loaded = tools()
+print("loaded: %s" % sorted(loaded))
+if sorted(loaded) != [1, 2, 3]:
+    fail("tools %s loaded, expected 1, 2 and 3" % sorted(loaded))
+check("T2 zoffset", loaded[2].zoffset, 2.0)
+check("T3 zoffset", loaded[3].zoffset, 3.0)
+for toolno, comment in ((1, "first"), (3, "third")):
+    got = s.toolinfo(toolno)["comment"]
+    if got != comment:
+        fail("T%d comment %r, expected %r" % (toolno, got, comment))
+
+mdi("g10 l1 p2 z5")
+wait_for(lambda: "T2 P2 Z+5.000000" in saved(), "the saved edit")
+print(table())
+if "\r" in table():
+    fail("carriage return saved")
+if "T1 P1 Z+1.000000 ;first" not in saved() or "T3 P3 Z+3.000000 ;third" not in saved():
+    fail("tools lost from the saved table")
+print("*** all checks passed")
+sys.exit(0)
diff --git a/tests/tool-table-load/garbage-ui.py b/tests/tool-table-load/garbage-ui.py
new file mode 100755
index 0000000..89099f9
--- /dev/null
+++ b/tests/tool-table-load/garbage-ui.py
@@ -0,0 +1,56 @@
+#!/usr/bin/env python3
+"""A table file with a line that is not a tool line does not load: the
+operator is told at startup, the machine has no tools, and the file is
+not saved over. A table loaded later lifts that; a reload of the file that
+fails keeps the table in memory but again keeps the file from being saved
+over."""
+
+from common import *
+
+start()
+wait_error("can't load tool table")
+if tools():
+    fail("tools %s loaded from a table that did not load" % sorted(tools()))
+before = table()
+
+print("*** a G10 edit finds no tool and does not touch the file")
+mdi("g10 l1 p1 z5")
+if table() != before:
+    fail("the table file was rewritten:\n" + table())
+
+print("*** with the line fixed and the table reloaded, saving works")
+with open("tool.tbl", "w") as f:
+    f.write("T1 P1 Z+1.000000\nT2 P2 Z+2.000000\n")
+c.load_tool_table()
+c.wait_complete()
+wait_for(lambda: sorted(tools()) == [1, 2], "T1 and T2 after the reload")
+mdi_mode()
+mdi("g10 l1 p1 z5")
+wait_for(lambda: "T1 P1 Z+5.000000" in saved(), "the saved edit")
+
+print("*** a reload that fails keeps the table, and the file is not saved over")
+edited = "T1 P1 Z+5.000000\nT2 P2 Z+2.000000\nT4 P4 Z+4.000000\nnot a tool line\n"
+with open("tool.tbl", "w") as f:
+    f.write(edited)
+c.load_tool_table()
+c.wait_complete()
+mdi_mode()
+mdi("g10 l1 p2 z7")
+if table() != edited:
+    fail("the table file was rewritten:\n" + table())
+check("T2 zoffset after the refused save", tools()[2].zoffset, 2.0)
+if 4 in tools():
+    fail("T4 loaded from a table that did not load")
+
+print("*** fixed and reloaded again, saving works")
+with open("tool.tbl", "w") as f:
+    f.write(edited.replace("not a tool line\n", ""))
+c.load_tool_table()
+c.wait_complete()
+wait_for(lambda: 4 in tools(), "T4 after the reload")
+mdi_mode()
+mdi("g10 l1 p2 z7")
+wait_for(lambda: "T2 P2 Z+7.000000" in saved(), "the saved edit")
+print(table())
+print("*** all checks passed")
+sys.exit(0)
