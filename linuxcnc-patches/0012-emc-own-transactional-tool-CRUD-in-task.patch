diff --git a/tests/tool-table-load/common.py b/tests/tool-table-load/common.py
new file mode 100644
index 0000000..69f291e
--- /dev/null
+++ b/tests/tool-table-load/common.py
@@ -0,0 +1,76 @@
+import linuxcnc
+import linuxcnc_util
+
+import math
+import sys
+import time
+
+c = linuxcnc.command()
+e = linuxcnc.error_channel()
+s = linuxcnc.stat()
+l = linuxcnc_util.LinuxCNC(command=c, status=s, error=e)
+
+
+def fail(msg):
+    print("ERROR: " + msg)
+    sys.exit(1)
+
+
+def check(what, got, expected):
+    print("%s = %.6f (expecting %.6f)" % (what, got, expected))
+    if math.fabs(got - expected) > 1e-6:
+        fail("%s = %f, expected %f" % (what, got, expected))
+
+
+def wait_for(predicate, what, timeout=10):
+    start = time.time()
+    while not predicate():
+        if time.time() - start > timeout:
+            fail("timeout waiting for " + what)
+        time.sleep(0.01)
+        s.poll()
+
+
+def wait_error(text, timeout=10):
+    start = time.time()
+    while time.time() - start < timeout:
+        err = e.poll()
+        if err is None:
+            time.sleep(0.01)
+            continue
+        print("(error channel: %s)" % (err[1],))
+        if text in err[1]:
+            return
+    fail("no error containing '%s'" % text)
+
+
+def tools():
+    s.poll()
+    return {t.id: t for t in s.tool_table[1:] if t.id > 0}
+
+
+def table():
+    with open("tool.tbl", newline="") as f:
+        return f.read()
+
+
+def saved():
+    """The table file's lines, spaces between words normalized."""
+    return [" ".join(line.split()) for line in table().split("\n")]
+
+
+def start():
+    l.wait_for_linuxcnc_startup()
+    c.state(linuxcnc.STATE_ESTOP_RESET)
+    c.state(linuxcnc.STATE_ON)
+    mdi_mode()
+
+
+def mdi_mode():
+    c.mode(linuxcnc.MODE_MDI)
+    c.wait_complete()
+
+
+def mdi(cmd):
+    c.mdi(cmd)
+    c.wait_complete()
