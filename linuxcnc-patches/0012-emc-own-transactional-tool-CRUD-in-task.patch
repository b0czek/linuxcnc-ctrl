+        problem = "it has invalid or duplicate entries";
+    } else if (spindle_tool > 0 &&
+               find_tool(loaded, loaded_last, spindle_tool,
+                         random_toolchanger) < 0) {
+        problem = "it does not have the tool in the spindle";
+    } else if (random_toolchanger && spindle_tool > 0 &&
+               loaded[0].toolno != spindle_tool) {
+        // the file must say where the tools are: the changer moves by it
+        problem = "pocket 0 does not hold the tool in the spindle";
+    }
+    if (problem) {
+        // the table in memory stays. If the configured file now holds
+        // something else, it is not saved over until it loads
+        CANON_TOOL_TABLE current[CANON_POCKETS_MAX];
+        int current_last = 0;
+        const bool unchanged = parsed && !refused_lines &&
+            !tooldata_snapshot(current, &current_last) &&
+            tooldata_tables_match(loaded, loaded_last, current, current_last);
+        if (same_file(file, tooltable_filename)) {
+            if (unchanged) {
+                tooldata_adopt_loaded_file();
+            } else {
+                tooldata_set_refused_lines(true);
