+// A table has just been published. On a random changer the table says which
+// tool is in the spindle; until one has loaded nothing was known, so the
+// first one to load decides, as it would have at startup.
+void Task::tool_table_loaded(void) {
+    const bool first = !have_tool_table;
+    have_tool_table = true;
+    if (!first || !random_toolchanger) return;
+    CANON_TOOL_TABLE tdata;
+    if (tooldata_get(&tdata,0) != IDX_OK) {
+        UNEXPECTED_MSG; return;
+    }
+    emcioStatus.tool.toolInSpindle = tdata.toolno;
+    hal_set_si32(iocontrol_data->tool_number, emcioStatus.tool.toolInSpindle);
