+/* Prepare the entire vector, including interpolators, before committing any
+ * joint. A late invalid solution or interpolation error cannot partially
+ * advance the command vector. The caller owns the motion fault path. */
+static int prepare_joint_targets(const EmcPose *pose, double *positions,
+                                 CUBIC_STRUCT *cubics)
+{
+    int n;
+    KINEMATICS_FORWARD_FLAGS staged_fflags = fflags;
+    for (n = 0; n < NO_OF_KINS_JOINTS; n++)
+        positions[n] = joints[n].coarse_pos;
+    if (kinematicsInverse(pose, positions, &iflags, &staged_fflags) != 0) {
+        reportError(_("kinematicsInverse failed"));
+        return -1;
+    }
+    for (n = 0; n < NO_OF_KINS_JOINTS; n++) {
+        if (!isfinite(positions[n])) {
+            reportError(_("kinematicsInverse gave non-finite joint location on joint %d"), n);
+            return -1;
+        }
+        cubics[n] = joints[n].cubic;
+        if (cubicNeedNextPoint(&cubics[n]) &&
+            cubicAddPoint(&cubics[n], positions[n]) != 0) {
+            reportError(_("joint %d interpolation preparation failed"), n);
+            return -1;
+        }
+    }
+    fflags = staged_fflags;
+    return 0;
+}
+
+/* Keep the definition of a releasable joint with the motion machinery that
+ * owns the planners, interpolators, compensation, and auxiliary motion.
+ * Command admission may accept a joint whose final samples are still
+ * draining; ownership handoff requires the fully ready state. */
+motion_joint_release_state_t motion_joint_release_state(int n)
+{
+    const emcmot_joint_t *joint = &joints[n];
+    const CUBIC_STRUCT *cubic = &joint->cubic;
+
+    if (tpQueueDepth(&emcmotInternal->coord_tp) != 0 ||
+        !GET_MOTION_INPOS_FLAG() || joint->free_tp.active ||
+        get_homing_is_active() || axis_jog_is_active() ||
+        emcmotStatus->probing || emcmotStatus->external_offsets_applied)
+        return MOTION_JOINT_RELEASE_BLOCKED;
+
+    if (!isfinite(joint->vel_cmd) || !isfinite(joint->acc_cmd) ||
+        !isfinite(joint->backlash_corr) || !isfinite(joint->backlash_filt) ||
+        !isfinite(joint->backlash_vel) || joint->kb_jjog_active ||
+        joint->wheel_jjog_active || cubic->x0 != cubic->x3 ||
+        cubic->x1 != cubic->x3 || cubic->x2 != cubic->x3 ||
+        joint->coarse_pos != cubic->x3 || fabs(joint->vel_cmd) > 1e-12 ||
+        fabs(joint->acc_cmd) > 1e-12 ||
+        fabs(joint->backlash_corr - joint->backlash_filt) > 1e-12 ||
+        fabs(joint->backlash_vel) > 1e-12)
+        return MOTION_JOINT_RELEASE_DRAINING;
+
+    return MOTION_JOINT_RELEASE_READY;
+}
+
+/* Inhibit immediately; homing still owns its abort state and must run before
+ * the caller deactivates the joint. Never run the homing engine recursively
+ * from command processing. */
+void motion_cancel_joint(int n)
+{
+    SET_JOINT_ENABLE_FLAG(&joints[n], 0);
+    joints[n].free_tp.enable = 0;
+    joints[n].kb_jjog_active = 0;
+    joints[n].wheel_jjog_active = 0;
+    do_cancel_homing(n);
+}
