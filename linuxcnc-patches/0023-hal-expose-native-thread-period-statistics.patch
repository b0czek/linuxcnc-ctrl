+    period_stats[3] = (struct period_stat_param){"period-max", &new->maximum_period_ns};
+    period_stats[4] = (struct period_stat_param){"jitter", &new->current_jitter_ns};
+    period_stats[5] = (struct period_stat_param){"period-avg", &new->average_period_ns};
+    period_stats[6] = (struct period_stat_param){"jitter-avg", &new->average_jitter_ns};
+    period_stats[7] = (struct period_stat_param){"jitter-max", &new->maximum_jitter_ns};
+    period_stats[8] = (struct period_stat_param){"exec-avg", &new->average_execution_ns};
+    period_stats[9] = (struct period_stat_param){"exec-max", &new->maximum_execution_ns};
+    period_counts[0] = (struct period_count_param){"outlier-q", &new->jitter_over_quarter_period_count};
+    period_counts[1] = (struct period_count_param){"outlier-h", &new->jitter_over_half_period_count};
+    period_counts[2] = (struct period_count_param){"outlier-at", &new->last_jitter_over_quarter_period_sample};
+    period_counts[3] = (struct period_count_param){"missed", &new->deadline_misses};
+    period_counts[4] = (struct period_count_param){"samples", &new->sample_count};
