index 5cf2078..667f4be 100644
--- a/docs/src/hal/basic-hal.adoc
+++ b/docs/src/hal/basic-hal.adoc
@@ -383,6 +383,29 @@ These allow you to scope the execution time of a component.
 
 `tmax` is a read/write parameter so the user can set it to 0 to get rid of the first time initialization on the function's execution time.
 
+[[sec:hal-thread-parameters]]
+== HAL Thread Parameters
+
+(((HAL Thread Parameters)))
+Each realtime thread measures the interval between the starts of consecutive
+cycles and publishes the results as parameters named after the thread, for
+example `servo-thread.period-max`.
+All times are in nanoseconds.
+
+[horizontal]
+`.period-target` (sint, RO):: Configured period.
+`.period-last`, `.period-min`, `.period-max`, `.period-avg` (sint, RO):: Latest, shortest, longest and average measured interval.
+`.jitter`, `.jitter-avg`, `.jitter-max` (sint, RO):: Latest, average and largest absolute difference between the measured interval and the configured period.
+`.exec-avg`, `.exec-max` (sint, RO):: Average and longest time to run the thread's functions.
+`.outlier-q`, `.outlier-h` (sint, RO):: Number of intervals whose jitter was at least a quarter or a half of the period.
+`.outlier-at` (sint, RO):: Value of `samples` at the latest quarter-period outlier.
+`.missed` (sint, RO):: Number of intervals longer than two periods.
+`.samples` (sint, RO):: Number of measured intervals.
+`.stats-reset` (bool, RW):: Set to true to clear the statistics. The thread clears them, and this parameter, at the start of its next cycle.
+
+The first cycle and intervals during which threads were stopped are not measured.
+Thread names longer than 41 characters leave no room for the parameter suffixes, so such threads are created without statistics and a warning is logged.
+
 [[sec:hal-logic-components]]
 == Basic Logic Components
 
diff --git a/src/hal/hal_lib.c b/src/hal/hal_lib.c
index 0839355..2820c07 100644
--- a/src/hal/hal_lib.c
+++ b/src/hal/hal_lib.c
@@ -2093,6 +2093,72 @@ int hal_export_funct(const char *name, void (*funct) (void *, long),
     return 0;
 }
 
+/* Parameter name suffixes of the period statistics, indexed by
+   enum hal_period_stat. */
+static const char *const period_stat_names[HAL_PERIOD_STAT_COUNT] = {
+    [HAL_PERIOD_STAT_PERIOD_TARGET] = "period-target",
+    [HAL_PERIOD_STAT_PERIOD_LAST]   = "period-last",
+    [HAL_PERIOD_STAT_PERIOD_MIN]    = "period-min",
+    [HAL_PERIOD_STAT_PERIOD_MAX]    = "period-max",
+    [HAL_PERIOD_STAT_JITTER]        = "jitter",
+    [HAL_PERIOD_STAT_PERIOD_AVG]    = "period-avg",
+    [HAL_PERIOD_STAT_JITTER_AVG]    = "jitter-avg",
+    [HAL_PERIOD_STAT_JITTER_MAX]    = "jitter-max",
+    [HAL_PERIOD_STAT_EXEC_AVG]      = "exec-avg",
+    [HAL_PERIOD_STAT_EXEC_MAX]      = "exec-max",
+    [HAL_PERIOD_STAT_OUTLIER_Q]     = "outlier-q",
+    [HAL_PERIOD_STAT_OUTLIER_H]     = "outlier-h",
+    [HAL_PERIOD_STAT_OUTLIER_AT]    = "outlier-at",
+    [HAL_PERIOD_STAT_MISSED]        = "missed",
+    [HAL_PERIOD_STAT_SAMPLES]       = "samples",
+};
+#define PERIOD_STATS_RESET_NAME "stats-reset"
+
+/* Create the period statistic parameters of a thread. Returns 0 when they
+   were created, 1 when the thread name leaves no room for their suffixes,
+   or a negative error code. */
+static int create_period_stat_params(hal_thread_t *thread)
+{
+    size_t longest_suffix = strlen(PERIOD_STATS_RESET_NAME);
+    int i, retval;
+
+    for (i = 0; i < HAL_PERIOD_STAT_COUNT; i++) {
+        if (strlen(period_stat_names[i]) > longest_suffix)
+            longest_suffix = strlen(period_stat_names[i]);
+    }
+    /* "<thread>.<suffix>"; ".period-target" is the longest at 14
+       characters, so thread names of up to HAL_NAME_LEN - 14 = 41
+       characters receive statistics. */
+    if (strlen(thread->name) + 1 + longest_suffix > HAL_NAME_LEN) {
+        rtapi_print_msg(RTAPI_MSG_WARN,
+            "HAL: thread '%s' name is too long for period statistics\n",
+            thread->name);
+        return 1;
+    }
+
+    thread->period_stats.value[HAL_PERIOD_STAT_PERIOD_TARGET] = thread->period;
+    for (i = 0; i < HAL_PERIOD_STAT_COUNT; i++) {
+        if ((retval = hal_param_new_sint(thread->comp_id, HAL_RO,
+                &(thread->period_stat_params[i]),
+                thread->period_stats.value[i],
+                "%s.%s", thread->name, period_stat_names[i])) < 0) {
+            rtapi_print_msg(RTAPI_MSG_ERR,
+                "HAL: ERROR: fail to create param '%s.%s'\n",
+                thread->name, period_stat_names[i]);
+            return retval;
+        }
+    }
+    if ((retval = hal_param_new_bool(thread->comp_id, HAL_RW,
+            &(thread->period_stats_reset), 0,
+            "%s." PERIOD_STATS_RESET_NAME, thread->name)) < 0) {
+        rtapi_print_msg(RTAPI_MSG_ERR,
+            "HAL: ERROR: fail to create param '%s." PERIOD_STATS_RESET_NAME "'\n",
+            thread->name);
+        return retval;
+    }
+    return 0;
+}
+
 int hal_create_thread(const char *name, unsigned long period_nsec)
 {
     int next, cmp, prev_priority;
@@ -2269,6 +2335,12 @@ int hal_create_thread(const char *name, unsigned long period_nsec)
         return retval;
     }
 
+    // A name too long for the statistics still creates the thread.
+    if ((retval = create_period_stat_params(new)) < 0) {
+        return retval;
+    }
+    new->period_stats_published = (retval == 0);
+
     hal_ready(new->comp_id);
 
     rtapi_print_msg(RTAPI_MSG_DBG, "HAL: thread created\n");
@@ -3187,6 +3259,7 @@ static void thread_task(void *arg)
     hal_funct_entry_t *funct_root, *funct_entry;
     long long int start_time, end_time;
     long long int thread_start_time;
+    int recorded_sample;
 
     thread = arg;
     while (1) {
@@ -3210,6 +3283,8 @@ static void thread_task(void *arg)
                 funct_entry = SHMPTR(funct_entry->links.next);
             }
             rtapi_task_self_resync();
+            /* the init cycle and the resync are not a measured interval */
+            thread->period_stats.previous_start_ns = 0;
             thread->init_done = 1;
             /* drain the list now that the init pass is complete */
             funct_entry = SHMPTR(funct_root->links.next);
@@ -3227,6 +3302,14 @@ static void thread_task(void *arg)
 	    start_time = rtapi_get_time();
 	    end_time = start_time;
 	    thread_start_time = start_time;
+	    recorded_sample = 0;
+	    if (thread->period_stats_published) {
+	        if (hal_get_bool(thread->period_stats_reset)) {
+	            hal_period_stats_clear(&thread->period_stats);
+	            hal_set_bool(thread->period_stats_reset, 0);
+	        }
+	        recorded_sample = hal_period_stats_record_start(&thread->period_stats, thread_start_time);
+	    }
 	    /* run thru function list */
 	    while (funct_entry != funct_root) {
 		/* call the function */
@@ -3254,6 +3337,20 @@ static void thread_task(void *arg)
 	        hal_set_si32(thread->maxtime, runtime);
 	    }
             hal_set_sint(thread->threadbeat, ++thread->beatcnt);
+	    if (thread->period_stats_published) {
+	        int i;
+	        if (recorded_sample) {
+	            hal_period_stats_record_execution(&thread->period_stats,
+	                end_time - thread_start_time);
+	        }
+	        for (i = 0; i < HAL_PERIOD_STAT_COUNT; i++) {
+	            hal_set_sint(thread->period_stat_params[i],
+	                thread->period_stats.value[i]);
+	        }
+	    }
+	} else {
+	    /* intervals while threads are stopped are not measured */
+	    thread->period_stats.previous_start_ns = 0;
 	}
 	/* wait until next period */
 	rtapi_wait();
@@ -3613,6 +3710,7 @@ static hal_thread_t *alloc_thread_struct(void)
     }
     if (p) {
 	/* make sure it's empty */
+	memset(p, 0, sizeof(*p));
 	p->next_ptr = 0;
 	p->period = 0;
 	p->priority = 0;
diff --git a/src/hal/hal_period_stats.h b/src/hal/hal_period_stats.h
new file mode 100644
index 0000000..f38db05
--- /dev/null
+++ b/src/hal/hal_period_stats.h
@@ -0,0 +1,118 @@
+#ifndef HAL_PERIOD_STATS_H
+#define HAL_PERIOD_STATS_H
+
+/* Thread period statistics, measured by the HAL thread task and published
+   as <thread>.<suffix> parameters by hal_lib.c. This header only does the
+   arithmetic on plain values, so it can be used from a kernel module and
+   tested without HAL. Times are in nanoseconds. */
+
+#include <rtapi_stdint.h>
+
+enum hal_period_stat {
+    HAL_PERIOD_STAT_PERIOD_TARGET,
+    HAL_PERIOD_STAT_PERIOD_LAST,
+    HAL_PERIOD_STAT_PERIOD_MIN,
+    HAL_PERIOD_STAT_PERIOD_MAX,
+    HAL_PERIOD_STAT_JITTER,
+    HAL_PERIOD_STAT_PERIOD_AVG,
+    HAL_PERIOD_STAT_JITTER_AVG,
+    HAL_PERIOD_STAT_JITTER_MAX,
+    HAL_PERIOD_STAT_EXEC_AVG,
+    HAL_PERIOD_STAT_EXEC_MAX,
+    HAL_PERIOD_STAT_OUTLIER_Q,
+    HAL_PERIOD_STAT_OUTLIER_H,
+    HAL_PERIOD_STAT_OUTLIER_AT,
+    HAL_PERIOD_STAT_MISSED,
+    HAL_PERIOD_STAT_SAMPLES,
+    HAL_PERIOD_STAT_COUNT
+};
+
+typedef struct {
+    rtapi_sint value[HAL_PERIOD_STAT_COUNT];
+    rtapi_s64 previous_start_ns;    /* 0: no interval start to measure from */
+    rtapi_u64 period_sum_ns;
+    rtapi_u64 jitter_sum_ns;
+    rtapi_u64 execution_sum_ns;
+} hal_period_stats_t;
+
+/* Clear everything except the configured period. The next interval is
+   measured from the next start, not from the one before the clear. */
+static inline void hal_period_stats_clear(hal_period_stats_t *stats)
+{
+    int i;
+
+    for (i = 0; i < HAL_PERIOD_STAT_COUNT; i++) {
+        if (i != HAL_PERIOD_STAT_PERIOD_TARGET)
+            stats->value[i] = 0;
+    }
+    stats->previous_start_ns = 0;
+    stats->period_sum_ns = 0;
+    stats->jitter_sum_ns = 0;
+    stats->execution_sum_ns = 0;
+}
+
+static inline void hal_period_stats_saturating_increment(rtapi_sint *value)
+{
+    if (*value < RTAPI_SINT_MAX)
+        (*value)++;
+}
+
+/* Record the start of a cycle. Returns nonzero when the interval since the
+   previous start was measured, so the cycle's execution time is recorded
+   too. */
+static inline int hal_period_stats_record_start(hal_period_stats_t *stats,
+                                                rtapi_s64 start_ns)
+{
+    rtapi_sint *value = stats->value;
+    rtapi_u64 period = value[HAL_PERIOD_STAT_PERIOD_TARGET];
+    rtapi_u64 actual_period, jitter;
+    int recorded = 0;
+
+    if (stats->previous_start_ns > 0 && start_ns >= stats->previous_start_ns) {
+        actual_period = start_ns - stats->previous_start_ns;
+        jitter = actual_period > period
+            ? actual_period - period : period - actual_period;
+        value[HAL_PERIOD_STAT_PERIOD_LAST] = actual_period;
+        value[HAL_PERIOD_STAT_JITTER] = jitter;
+        if (value[HAL_PERIOD_STAT_SAMPLES] == 0 ||
+                actual_period < (rtapi_u64)value[HAL_PERIOD_STAT_PERIOD_MIN])
+            value[HAL_PERIOD_STAT_PERIOD_MIN] = actual_period;
+        if (actual_period > (rtapi_u64)value[HAL_PERIOD_STAT_PERIOD_MAX])
+            value[HAL_PERIOD_STAT_PERIOD_MAX] = actual_period;
+        if (jitter > (rtapi_u64)value[HAL_PERIOD_STAT_JITTER_MAX])
+            value[HAL_PERIOD_STAT_JITTER_MAX] = jitter;
+        hal_period_stats_saturating_increment(&value[HAL_PERIOD_STAT_SAMPLES]);
+        recorded = 1;
+        stats->period_sum_ns += actual_period;
+        stats->jitter_sum_ns += jitter;
+        value[HAL_PERIOD_STAT_PERIOD_AVG] =
+            stats->period_sum_ns / (rtapi_u64)value[HAL_PERIOD_STAT_SAMPLES];
+        value[HAL_PERIOD_STAT_JITTER_AVG] =
+            stats->jitter_sum_ns / (rtapi_u64)value[HAL_PERIOD_STAT_SAMPLES];
+        if (jitter >= (period + 3) / 4) {
+            hal_period_stats_saturating_increment(&value[HAL_PERIOD_STAT_OUTLIER_Q]);
+            value[HAL_PERIOD_STAT_OUTLIER_AT] = value[HAL_PERIOD_STAT_SAMPLES];
+        }
+        if (jitter >= (period + 1) / 2)
+            hal_period_stats_saturating_increment(&value[HAL_PERIOD_STAT_OUTLIER_H]);
+        if (actual_period > period * 2)
+            hal_period_stats_saturating_increment(&value[HAL_PERIOD_STAT_MISSED]);
+    }
+    stats->previous_start_ns = start_ns;
+    return recorded;
+}
+
+/* Record the execution time of a cycle whose start was recorded. */
+static inline void hal_period_stats_record_execution(hal_period_stats_t *stats,
+                                                     rtapi_u64 execution_ns)
+{
+    rtapi_sint *value = stats->value;
+
+    if (execution_ns > (rtapi_u64)value[HAL_PERIOD_STAT_EXEC_MAX])
+        value[HAL_PERIOD_STAT_EXEC_MAX] = execution_ns;
+    stats->execution_sum_ns += execution_ns;
+    value[HAL_PERIOD_STAT_EXEC_AVG] =
+        stats->execution_sum_ns / (rtapi_u64)value[HAL_PERIOD_STAT_SAMPLES];
+}
+
+#endif
