diff --git a/tests/thread-period-stats/README b/tests/thread-period-stats/README
new file mode 100644
index 0000000000..dd01becf7f
--- /dev/null
+++ b/tests/thread-period-stats/README
@@ -0,0 +1,4 @@
+Period statistics use fixed short suffixes. A 41-character thread name is the
+longest that holds them within HAL_NAME_LEN; a longer valid name still creates
+its thread, without statistics. The sample counter is a 64-bit decimal HAL
+parameter and advances after the thread starts.
diff --git a/tests/thread-period-stats/checkresult b/tests/thread-period-stats/checkresult
new file mode 100755
index 0000000000..26d2ded04d
--- /dev/null
+++ b/tests/thread-period-stats/checkresult
@@ -0,0 +1,29 @@
+#!/usr/bin/env python3
+import sys
+
+samples = {"servo-thread.samples": [], "period-statistics-boundary-thread-name-41.samples": []}
+resets = {"servo-thread.stats-reset": False, "period-statistics-boundary-thread-name-41.stats-reset": False}
+unpublished = []
+with open(sys.argv[1], encoding="utf-8") as output:
+    for line in output:
+        fields = line.split()
+        if len(fields) < 5:
+            continue
+        if fields[-1] in samples:
+            if fields[1] != "s64" or fields[2] != "RO":
+                raise SystemExit("sample counter has an unexpected type")
+            samples[fields[-1]].append(int(fields[-2], 0))
+        if fields[-1] in resets:
+            resets[fields[-1]] = fields[1] == "bit" and fields[2] == "RW"
+        if fields[-1].startswith("period-statistics-boundary-thread-name-41x."):
+            unpublished.append(fields[-1])
+
+if not all(resets.values()):
+    raise SystemExit("thread reset parameter was not published")
+for name, observed in samples.items():
+    if len(observed) != 2 or observed[0] != 0 or observed[1] <= 0:
+        raise SystemExit("sample counter did not advance after thread start: " + name)
+if any(name not in ("period-statistics-boundary-thread-name-41x.time", "period-statistics-boundary-thread-name-41x.tmax") for name in unpublished):
+    raise SystemExit("statistics published for a name that cannot hold them: " + str(unpublished))
+if "period-statistics-boundary-thread-name-41x.tmax" not in unpublished:
+    raise SystemExit("thread with a long name was not created")
