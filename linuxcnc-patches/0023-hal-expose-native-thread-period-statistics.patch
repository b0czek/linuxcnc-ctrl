diff --git a/src/hal/hal_period_stats.h b/src/hal/hal_period_stats.h
new file mode 100644
index 0000000000..51daf69621
--- /dev/null
+++ b/src/hal/hal_period_stats.h
@@ -0,0 +1,89 @@
+#ifndef HAL_PERIOD_STATS_H
+#define HAL_PERIOD_STATS_H
+
+#include <rtapi_limits.h>
+#include "hal.h"
+#include "hal_priv.h"
+
+static inline void hal_period_stats_clear(hal_thread_t *thread)
+{
+    thread->last_period_ns = 0;
+    thread->minimum_period_ns = 0;
+    thread->maximum_period_ns = 0;
+    thread->current_jitter_ns = 0;
+    thread->average_period_ns = 0;
+    thread->average_jitter_ns = 0;
+    thread->maximum_jitter_ns = 0;
+    thread->average_execution_ns = 0;
+    thread->maximum_execution_ns = 0;
+    thread->jitter_over_quarter_period_count = 0;
+    thread->jitter_over_half_period_count = 0;
+    thread->last_jitter_over_quarter_period_sample = 0;
+    thread->deadline_misses = 0;
+    thread->sample_count = 0;
+    thread->period_sum_ns = 0;
+    thread->jitter_sum_ns = 0;
+    thread->execution_sum_ns = 0;
+    thread->previous_period_start_ns = 0;
+    thread->period_stats_reset = 0;
+}
+
+static inline int hal_period_stats_record_start(hal_thread_t *thread,
+                                                 long long start_ns)
+{
+    unsigned long long actual_period, jitter, average;
+    int recorded = 0;
+
+    if (thread->period_stats_reset) hal_period_stats_clear(thread);
+    if (thread->previous_period_start_ns > 0 &&
+            start_ns >= thread->previous_period_start_ns) {
+        actual_period = start_ns - thread->previous_period_start_ns;
+        jitter = actual_period > (unsigned long long)thread->period
+            ? actual_period - thread->period : thread->period - actual_period;
+        thread->last_period_ns = actual_period > UINT_MAX ? UINT_MAX : actual_period;
+        thread->current_jitter_ns = jitter > UINT_MAX ? UINT_MAX : jitter;
+        if (thread->minimum_period_ns == 0 ||
+                actual_period < thread->minimum_period_ns)
+            thread->minimum_period_ns = thread->last_period_ns;
+        if (actual_period > thread->maximum_period_ns)
+            thread->maximum_period_ns = thread->last_period_ns;
+        if (jitter > thread->maximum_jitter_ns)
+            thread->maximum_jitter_ns = thread->current_jitter_ns;
+        if (thread->sample_count < LLONG_MAX)
+            thread->sample_count++;
+        recorded = 1;
+        thread->period_sum_ns += actual_period;
+        thread->jitter_sum_ns += jitter;
+        average = thread->period_sum_ns / thread->sample_count;
+        thread->average_period_ns = average > UINT_MAX ? UINT_MAX : average;
+        average = thread->jitter_sum_ns / thread->sample_count;
+        thread->average_jitter_ns = average > UINT_MAX ? UINT_MAX : average;
+        if (jitter >= ((unsigned long long)thread->period + 3) / 4) {
+            if (thread->jitter_over_quarter_period_count < LLONG_MAX)
+                thread->jitter_over_quarter_period_count++;
+            thread->last_jitter_over_quarter_period_sample = thread->sample_count;
+        }
+        if (jitter >= ((unsigned long long)thread->period + 1) / 2 &&
+                thread->jitter_over_half_period_count < LLONG_MAX)
+            thread->jitter_over_half_period_count++;
+        if (actual_period > (unsigned long long)thread->period * 2 &&
+                thread->deadline_misses < LLONG_MAX)
+            thread->deadline_misses++;
+    }
+    thread->previous_period_start_ns = start_ns;
+    return recorded;
+}
+
+static inline void hal_period_stats_record_execution(hal_thread_t *thread,
+                                                     unsigned long long execution_ns)
+{
+    unsigned long long average;
+
+    if (execution_ns > thread->maximum_execution_ns)
+        thread->maximum_execution_ns = execution_ns > UINT_MAX ? UINT_MAX : execution_ns;
+    thread->execution_sum_ns += execution_ns;
+    average = thread->execution_sum_ns / thread->sample_count;
+    thread->average_execution_ns = average > UINT_MAX ? UINT_MAX : average;
+}
+
+#endif
