+    hal_bit_t period_stats_reset;
+    long long previous_period_start_ns;
+    unsigned long long period_sum_ns;
+    unsigned long long jitter_sum_ns;
+    unsigned long long execution_sum_ns;
     hal_list_t funct_list;	/* list of functions to run */
     hal_list_t init_funct_list;	/* list of init functions, run once before first cyclic cycle */
     int init_done;		/* 0 = init pending, 1 = init cycle has executed */
