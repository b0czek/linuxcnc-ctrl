+    if (stop_mist) {
+        emcCoolantMistOn();
+    }
+    if (stop_flood) {
+        emcCoolantFloodOn();
+    }
+    for (int s = 0; s < emcStatus->motion.traj.spindles; ++s) {
+        stop_spindles[s].restore_wait_at_speed = false;
+        if (stop_spindles[s].running) {
+            stop_spindles[s].restore_seq = emcSpindleStopRestoreSeq(s);
