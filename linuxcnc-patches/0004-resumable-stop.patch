+/*
+ * While Stop is in progress, queued commands that only add to the coordinated
+ * motion queue may still be issued: the planner holds whatever Stop does not
+ * let finish, and a synchronized run or a latched G76 pass may need its
+ * remaining segments. Every other command (spindle, coolant, I/O, dwell, tool
+ * change, homing, program end, a G76 pass-group fence ...) waits until after
+ * Resume, so that it neither runs behind the output state Stop records and
+ * restores nor runs out of program order.
+ */
+static bool emcTaskStopAllowsIssue(const NMLmsg *cmd)
+{
+    switch (emcStatus->task.stopState) {
+    case EMC_TASK_STOP_STATE::IDLE:
+        return true;
+    case EMC_TASK_STOP_STATE::STOPPING:
+        break;
+    default:
+        return false;
+    }
+    switch (cmd->_type) {
+    case EMC_TRAJ_LINEAR_MOVE_TYPE:
+    case EMC_TRAJ_CIRCULAR_MOVE_TYPE:
+    case EMC_TRAJ_SET_VELOCITY_TYPE:
+    case EMC_TRAJ_SET_ACCELERATION_TYPE:
+    case EMC_TRAJ_SET_TERM_COND_TYPE:
+    case EMC_TRAJ_SET_SPINDLESYNC_TYPE:
+    case EMC_TRAJ_SET_FO_ENABLE_TYPE:
+    case EMC_TRAJ_SET_FH_ENABLE_TYPE:
+    case EMC_TRAJ_SET_SO_ENABLE_TYPE:
+        return true;
+    case EMC_MOTION_SET_DOUT_TYPE:
+        // Synchronized outputs travel with the next queued move.
+        return !reinterpret_cast<const EMC_MOTION_SET_DOUT *>(cmd)->now;
+    case EMC_MOTION_SET_AOUT_TYPE:
+        return !reinterpret_cast<const EMC_MOTION_SET_AOUT *>(cmd)->now;
+    default:
+        return false;
+    }
+}
