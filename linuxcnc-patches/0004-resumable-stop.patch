+
+/*
+ * A second Stop, or a Pause, while Resume is pending cancels it: STARTING
+ * returns to STOPPED with the outputs Resume switched back on off again. The
+ * program stays stopped until the next Resume, Run or Single Step.
+ */
+static void emcTaskStopCancelResume()
+{
+    stop_single_step = false;
+    if (emcStatus->task.stopState == EMC_TASK_STOP_STATE::STARTING) {
+        emcTaskStopDisableSavedOutputs();
+        emcStatus->task.stopState = EMC_TASK_STOP_STATE::STOPPED;
+    }
+}
+
+static void emcTaskStopResume()
+{
+    if (!stop_outputs_saved) {
+        return;
+    }
