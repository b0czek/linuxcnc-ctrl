+/*
+ * What a Stop or Pause waits for. An operation task has already handed to
+ * another subsystem runs to its end before the machine holds, as an M
+ * function runs to its completion signal on other controls, and only then
+ * does Stop switch spindle and coolant off. None of these waits has a
+ * timeout of its own; Abort, E-stop and Machine Off end them.
+ *
+ * A queued G28.2 homing cycle cannot be paused and resumed part way. Motion
+ * is dipped into FREE meanwhile and may report a stopped coordinated planner
+ * long before homing ends. Test the exec state, not homingWaiting: Abort,
+ * E-stop, machine off and mode changes leave that flag set when they end the
+ * wait.
+ */
+static EMC_TASK_HOLD_WAIT emcTaskHoldWait()
+{
+    if (emcStatus->task.execState == EMC_TASK_EXEC::WAITING_FOR_HOMING) {
+        return EMC_TASK_HOLD_WAIT::HOMING;
+    }
+    if (emcStatus->task.execState == EMC_TASK_EXEC::WAITING_FOR_SYSTEM_CMD) {
+        return EMC_TASK_HOLD_WAIT::SYSTEM_COMMAND;
+    }
+    if (emcStatus->io.status == RCS_STATUS::EXEC) {
+        return EMC_TASK_HOLD_WAIT::IO;
+    }
+    return EMC_TASK_HOLD_WAIT::NONE;
+}
+
+static void emcTaskStopProgress()
+{
+    switch (emcStatus->task.stopState) {
+    case EMC_TASK_STOP_STATE::STOPPING: {
+        // Like position-synchronized motion, an operation already under way
+        // runs to its end before Stop is reached.
+        if (emcTaskHoldWait() != EMC_TASK_HOLD_WAIT::NONE ||
+                !emcStatus->motion.traj.stopped) {
+            return;
+        }
+
+        if (!stop_outputs_saved) {
+            stop_mist = emcStatus->io.coolant.mist;
+            stop_flood = emcStatus->io.coolant.flood;
+        }
+        bool spindle_output_active = false;
+        for (int s = 0; s < emcStatus->motion.traj.spindles; ++s) {
+            const auto &status = emcStatus->motion.spindle[s];
+            bool spindle_running = status.enabled || status.direction != 0;
+            if (!stop_outputs_saved) {
+                stop_spindles[s].running = spindle_running;
+                stop_spindles[s].speed = status.speed;
+                stop_spindles[s].css_factor = status.css_factor;
+                stop_spindles[s].css_xoffset = status.css_xoffset;
+                stop_spindles[s].orienting =
+                    status.orient_state == EMCMOT_ORIENT_IN_PROGRESS;
+                if (stop_spindles[s].orienting) {
+                    const auto &request =
+                        active_spindle_orient_requests[s];
+                    stop_spindles[s].orientation =
+                        request.orientation;
+                    stop_spindles[s].orient_mode =
+                        request.mode;
+                    stop_spindles[s].orient_timeout =
+                        request.timeout;
+                }
+            }
+            if (spindle_running ||
+                    status.orient_state == EMCMOT_ORIENT_IN_PROGRESS) {
+                emcSpindleOff(s, EMCMOT_SPINDLE_AT_SPEED_PRESERVE);
+                spindle_output_active = true;
+            }
+        }
+        if (!stop_outputs_saved) {
+            if (stop_mist) {
+                emcCoolantMistOff();
+            }
+            if (stop_flood) {
+                emcCoolantFloodOff();
+            }
+            stop_outputs_saved = true;
+        }
+        if (spindle_output_active) {
+            return;
+        }
+        emcStatus->task.stopState = EMC_TASK_STOP_STATE::STOPPED;
+        return;
+    }
+
+    case EMC_TASK_STOP_STATE::STARTING:
+        for (int s = 0; s < emcStatus->motion.traj.spindles; ++s) {
+            if (stop_spindles[s].orienting) {
+                const auto &status = emcStatus->motion.spindle[s];
+                if (status.orient_state == EMCMOT_ORIENT_FAULTED ||
+                        (stop_spindles[s].orient_deadline > 0.0 &&
+                         etime() >= stop_spindles[s].orient_deadline)) {
+                    emcTaskStopDisableSavedOutputs();
+                    emcStatus->task.stopState = EMC_TASK_STOP_STATE::STOPPED;
+                    emcOperatorError(
+                        "resumed spindle orientation failed on spindle %d",
+                        s);
+                    return;
+                }
+                if (status.orient_state != EMCMOT_ORIENT_COMPLETE) {
+                    return;
+                }
+            }
+        }
+        /*
+         * Motion continues only once every spindle Stop switched off and
+         * Resume switched back on is at speed again, so an interrupted feed
+         * does not restart cutting while the spindle spins up. Like
+         * upstream's own at-speed waits this has no timeout; Stop, Abort,
+         * E-stop and machine off leave STARTING. See
+         * emcSpindleStopRestoreAtSpeed() for why a stale at-speed does not
+         * count.
+         */
+        for (int s = 0; s < emcStatus->motion.traj.spindles; ++s) {
+            if (stop_spindles[s].restore_wait_at_speed &&
+                    !emcSpindleStopRestoreAtSpeed(s,
+                        stop_spindles[s].restore_seq)) {
+                return;
+            }
+        }
+        // Motion refuses a Step with nothing queued (Stop between moves);
+        // resume it instead, and the interpreter steps the next line.
+        if (stop_single_step && emcStatus->motion.traj.queue > 0) {
+            emcTrajStep();
+        } else {
+            emcTrajResume();
+        }
+        emcStatus->task.stopState = EMC_TASK_STOP_STATE::IDLE;
+        emcStatus->task.task_paused = stop_single_step;
+        stop_single_step = false;
+        stop_outputs_saved = false;
+        return;
+
+    default:
+        return;
+    }
+}
