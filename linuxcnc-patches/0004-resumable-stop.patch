+
+static void emcTaskStepInterpreter()
+{
+    emcStatus->motion.traj.single_stepping = 1;
+    stepping = 1;
+    steppingWait = 0;
+    if (emcStatus->motion.traj.queue == 0) {
+        emcStatus->task.interpState = interpResumeState;
+    }
+    emcStatus->task.task_paused = 1;
