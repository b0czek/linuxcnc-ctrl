diff --git a/tests/resumable-stop/test.sh b/tests/resumable-stop/test.sh
new file mode 100755
index 0000000..7c34d26
--- /dev/null
+++ b/tests/resumable-stop/test.sh
@@ -0,0 +1,69 @@
+#!/bin/bash -e
+
+set -o pipefail
+
+if nm -D -u "$EMC2_HOME/rtlib/motmod.so" | grep -q '[[:space:]]tpStop$'; then
+    echo "motmod unexpectedly requires the nonstandard tpStop symbol" >&2
+    exit 1
+fi
+
+scenarios=(
+    idle-rejected
+    ordinary
+    single-step
+    rapid-no-atspeed
+    paused-resume
+    paused-run
+    abort-empty
+    queued-g33
+    g33
+    fperrev
+    g76
+    rigid-tap
+    orientation
+    dwell
+    dwell-atspeed
+    multi-spindle
+    css
+    homing
+    homing-interrupted
+    speed-change-atspeed
+    queued-feed-atspeed
+    g33-chain
+    step-resume-stopping
+)
+
+# test.ini selects the jerk-limited planner. Repeat the scenarios whose
+# unsynchronized motion is most planner dependent with the default
+# trapezoidal planner.
+trapezoidal_scenarios=(
+    ordinary
+    single-step
+    fperrev
+)
+
+scenario_log=$(mktemp)
+trapezoidal_ini=test-trapezoidal.ini
+trap 'rm -f "$scenario_log" "$trapezoidal_ini"' EXIT
+sed 's/^PLANNER_TYPE = 1$/PLANNER_TYPE = 0/' test.ini > "$trapezoidal_ini"
+grep -q '^PLANNER_TYPE = 0$' "$trapezoidal_ini"
+
+run_scenario() {
+    local ini=$1 scenario=$2
+    echo "Running resumable-stop scenario: $scenario ($ini)"
+    : > "$scenario_log"
+    RESUMABLE_STOP_SCENARIO="$scenario" linuxcnc -r "$ini" 2>&1 |
+        tee "$scenario_log"
+    if grep -Eq 'ruckig_plan_(position|velocity): invalid limits|Ruckig (velocity control )?planning failed' "$scenario_log"; then
+        echo "$scenario emitted a Ruckig invalid-limit or planning failure" >&2
+        exit 1
+    fi
+}
+
+for scenario in "${scenarios[@]}"; do
+    run_scenario test.ini "$scenario"
+done
+for scenario in "${trapezoidal_scenarios[@]}"; do
+    run_scenario "$trapezoidal_ini" "$scenario"
+done
+echo "resumable stop scenarios complete"
