+static void emcTaskStopClear()
+{
+    bool was_active = emcStatus &&
+        emcStatus->task.stopState != EMC_TASK_STOP_STATE::IDLE;
+    stop_resume_latched = false;
+    stop_single_step = false;
+    stop_outputs_saved = false;
+    taskExecDelayStopTime = 0.0;
+    for (auto &spindle : stop_spindles) {
+        spindle = {};
+    }
+    if (emcStatus) {
+        emcStatus->task.stopState = EMC_TASK_STOP_STATE::IDLE;
+        if (was_active) {
+            emcStatus->task.task_paused = 0;
+        }
+    }
+}
+
+static void emcTaskStopDisableSavedOutputs()
+{
+    for (int s = 0; s < emcStatus->motion.traj.spindles; ++s) {
+        if (stop_spindles[s].running ||
+                stop_spindles[s].orienting) {
+            emcSpindleOff(s, EMCMOT_SPINDLE_AT_SPEED_PRESERVE);
+        }
+    }
+    if (stop_mist) {
+        emcCoolantMistOff();
+    }
+    if (stop_flood) {
+        emcCoolantFloodOff();
+    }
+}
+
+static void emcTaskStopResume()
+{
+    stop_resume_latched = false;
+    if (!stop_outputs_saved) {
+        return;
+    }
+
+    if (stop_mist) {
+        emcCoolantMistOn();
+    }
+    if (stop_flood) {
+        emcCoolantFloodOn();
+    }
+    for (int s = 0; s < emcStatus->motion.traj.spindles; ++s) {
+        if (stop_spindles[s].running) {
+            emcSpindleOn(s, stop_spindles[s].speed,
+                    stop_spindles[s].css_factor,
+                    stop_spindles[s].css_xoffset,
+                    EMCMOT_SPINDLE_AT_SPEED_PRESERVE);
+        }
+        if (stop_spindles[s].orienting) {
+            emcSpindleOrient(s, stop_spindles[s].orientation,
+                    stop_spindles[s].orient_mode);
+            stop_spindles[s].orient_deadline =
+                stop_spindles[s].orient_timeout > 0.0
+                ? etime() + stop_spindles[s].orient_timeout
+                : 0.0;
+        }
+    }
+    emcStatus->task.stopState = EMC_TASK_STOP_STATE::STARTING;
+}
+
+static void emcTaskStopProgress()
+{
+    switch (emcStatus->task.stopState) {
+    case EMC_TASK_STOP_STATE::STOPPING: {
+        /*
+         * A queued G28.2 homing cycle cannot be paused and resumed part way,
+         * so, like position-synchronized motion, it runs to completion before
+         * Stop is reached. Motion is dipped into FREE meanwhile and may report
+         * a stopped coordinated planner long before homing ends. Test the
+         * exec state, not homingWaiting: Abort, E-stop, machine off and mode
+         * changes leave that flag set when they end the wait.
+         */
+        if (emcStatus->task.execState == EMC_TASK_EXEC::WAITING_FOR_HOMING ||
+                !emcStatus->motion.traj.stopped) {
+            return;
+        }
+
+        if (!stop_outputs_saved) {
+            stop_mist = emcStatus->io.coolant.mist;
+            stop_flood = emcStatus->io.coolant.flood;
+        }
+        bool spindle_output_active = false;
+        for (int s = 0; s < emcStatus->motion.traj.spindles; ++s) {
+            const auto &status = emcStatus->motion.spindle[s];
+            bool spindle_running = status.enabled || status.direction != 0;
+            if (!stop_outputs_saved) {
+                stop_spindles[s].running = spindle_running;
+                stop_spindles[s].speed = status.speed;
+                stop_spindles[s].css_factor = status.css_factor;
+                stop_spindles[s].css_xoffset = status.css_xoffset;
+                stop_spindles[s].orienting =
+                    status.orient_state == EMCMOT_ORIENT_IN_PROGRESS;
+                if (stop_spindles[s].orienting) {
+                    const auto &request =
+                        active_spindle_orient_requests[s];
+                    stop_spindles[s].orientation =
+                        request.orientation;
+                    stop_spindles[s].orient_mode =
+                        request.mode;
+                    stop_spindles[s].orient_timeout =
+                        request.timeout;
+                }
+            }
+            if (spindle_running ||
+                    status.orient_state == EMCMOT_ORIENT_IN_PROGRESS) {
+                emcSpindleOff(s, EMCMOT_SPINDLE_AT_SPEED_PRESERVE);
+                spindle_output_active = true;
+            }
+        }
+        if (!stop_outputs_saved) {
+            if (stop_mist) {
+                emcCoolantMistOff();
+            }
+            if (stop_flood) {
+                emcCoolantFloodOff();
+            }
+            stop_outputs_saved = true;
+        }
+        if (spindle_output_active) {
+            return;
+        }
+        emcStatus->task.stopState = EMC_TASK_STOP_STATE::STOPPED;
+        if (stop_resume_latched) {
+            emcTaskStopResume();
+        }
+        return;
+    }
+
+    case EMC_TASK_STOP_STATE::STARTING:
+        for (int s = 0; s < emcStatus->motion.traj.spindles; ++s) {
+            if (stop_spindles[s].orienting) {
+                const auto &status = emcStatus->motion.spindle[s];
+                if (status.orient_state == EMCMOT_ORIENT_FAULTED ||
+                        (stop_spindles[s].orient_deadline > 0.0 &&
+                         etime() >= stop_spindles[s].orient_deadline)) {
+                    emcTaskStopDisableSavedOutputs();
+                    emcStatus->task.stopState = EMC_TASK_STOP_STATE::STOPPED;
+                    emcOperatorError(
+                        "resumed spindle orientation failed on spindle %d",
+                        s);
+                    return;
+                }
+                if (status.orient_state != EMCMOT_ORIENT_COMPLETE) {
+                    return;
+                }
+            }
+        }
+        if (stop_single_step) {
+            emcTrajStep();
+        } else {
+            emcTrajResume();
+        }
+        emcStatus->task.stopState = EMC_TASK_STOP_STATE::IDLE;
+        emcStatus->task.task_paused = stop_single_step;
+        stop_single_step = false;
+        stop_outputs_saved = false;
+        return;
+
+    default:
+        return;
+    }
+}
