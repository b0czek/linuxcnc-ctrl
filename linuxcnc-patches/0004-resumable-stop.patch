+static void emcTaskResumeInterpreter()
+{
+    if (emcStatus->task.interpState == EMC_TASK_INTERP::PAUSED) {
+        emcStatus->task.interpState = interpResumeState;
+    }
+    emcStatus->motion.traj.single_stepping = 0;
+    stepping = 0;
+    steppingWait = 0;
+}
+
+static void emcTaskStepInterpreter()
+{
+    emcStatus->motion.traj.single_stepping = 1;
+    stepping = 1;
+    steppingWait = 0;
+    // Only a Pause saved interpResumeState; a Stop leaves the interpreter
+    // reading, and restoring a stale state could mark the program finished.
+    if (emcStatus->motion.traj.queue == 0 &&
+            emcStatus->task.interpState == EMC_TASK_INTERP::PAUSED) {
+        emcStatus->task.interpState = interpResumeState;
+    }
+    emcStatus->task.task_paused = 1;
+}
+
+static void emcTaskStopClear()
+{
+    bool was_active = emcStatus &&
+        emcStatus->task.stopState != EMC_TASK_STOP_STATE::IDLE;
+    stop_single_step = false;
+    stop_outputs_saved = false;
+    taskExecDelayStopTime = 0.0;
+    for (auto &spindle : stop_spindles) {
+        spindle = {};
+    }
+    if (emcStatus) {
+        emcStatus->task.stopState = EMC_TASK_STOP_STATE::IDLE;
+        if (was_active) {
+            emcStatus->task.task_paused = 0;
+        }
+    }
+}
+
+static void emcTaskStopDisableSavedOutputs()
+{
+    for (int s = 0; s < emcStatus->motion.traj.spindles; ++s) {
+        if (stop_spindles[s].running ||
+                stop_spindles[s].orienting) {
+            emcSpindleOff(s, EMCMOT_SPINDLE_AT_SPEED_PRESERVE);
+        }
+    }
+    if (stop_mist) {
+        emcCoolantMistOff();
+    }
+    if (stop_flood) {
+        emcCoolantFloodOff();
+    }
