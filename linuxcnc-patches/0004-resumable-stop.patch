+static void emcTaskResumeInterpreter()
+{
+    if (emcStatus->task.interpState == EMC_TASK_INTERP::PAUSED) {
+        emcStatus->task.interpState = interpResumeState;
+    }
+    emcStatus->motion.traj.single_stepping = 0;
+    stepping = 0;
+    steppingWait = 0;
