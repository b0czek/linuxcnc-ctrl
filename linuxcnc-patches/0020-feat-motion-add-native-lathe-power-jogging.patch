diff --git a/src/emc/usr_intf/halui_power_feed.hh b/src/emc/usr_intf/halui_power_feed.hh
new file mode 100644
index 0000000000..c29dd2bdb9
--- /dev/null
+++ b/src/emc/usr_intf/halui_power_feed.hh
@@ -0,0 +1,69 @@
+#pragma once
+
+#include "hal.h"
+#include "nml_intf/emc_nml.hh"
+
+/* HAL sampling and power-feed edges; motion owns the held feed and path. */
+class HaluiPowerFeed {
+    struct Pins {
+        hal_bit_t *xp, *xm, *zp, *zm;
+        hal_float_t *feed, *slope;
+        hal_u32_t *spindle;
+    };
+    Pins *pins = nullptr;
+    bool blocked = false;
+    int previous_x = 0, previous_z = 0;
+    double held_slope = 0;
+    unsigned held_spindle = 0;
+
+public:
+    int export_pins(int id) {
+        pins = static_cast<Pins *>(hal_malloc(sizeof(Pins)));
+        if (!pins) return -1;
+        int result;
+        if ((result = hal_pin_bit_new("halui.power-feed.x.plus", HAL_IN, &pins->xp, id)) < 0 ||
+            (result = hal_pin_bit_new("halui.power-feed.x.minus", HAL_IN, &pins->xm, id)) < 0 ||
+            (result = hal_pin_bit_new("halui.power-feed.z.plus", HAL_IN, &pins->zp, id)) < 0 ||
+            (result = hal_pin_bit_new("halui.power-feed.z.minus", HAL_IN, &pins->zm, id)) < 0 ||
+            (result = hal_pin_float_new("halui.power-feed.per-rev", HAL_IN, &pins->feed, id)) < 0 ||
+            (result = hal_pin_u32_new("halui.power-feed.spindle", HAL_IN, &pins->spindle, id)) < 0 ||
+            (result = hal_pin_float_new("halui.power-feed.taper-slope", HAL_IN, &pins->slope, id)) < 0)
+            return result;
+        *pins->xp = 0;
+        *pins->xm = 0;
+        *pins->zp = 0;
+        *pins->zm = 0;
+        *pins->feed = 0;
+        *pins->slope = 0;
+        *pins->spindle = 0;
+        return 0;
+    }
+
+    void update(bool permitted, int (*send)(RCS_CMD_MSG&)) {
+        if (!pins) return;
+        bool xp = *pins->xp, xm = *pins->xm;
+        bool zp = *pins->zp, zm = *pins->zm;
+        bool held = xp || xm || zp || zm;
+        double slope = *pins->slope;
+        if (!held) blocked = false;
+        if (held && (!permitted || (xp && xm) || (zp && zm) ||
+            ((previous_x || previous_z) &&
+             (slope != held_slope || *pins->spindle != held_spindle))))
+            blocked = true;
+        int x = permitted && !blocked ? int(xp) - int(xm) : 0;
+        int z = permitted && !blocked ? int(zp) - int(zm) : 0;
+        if (x != previous_x || z != previous_z) {
+            EMC_JOG_POWER command;
+            command.x_direction = x;
+            command.z_direction = z;
+            command.feed_per_rev = *pins->feed;
+            command.spindle = *pins->spindle;
+            command.taper_slope = slope;
+            if (send(command) != 0 && (x || z)) blocked = true;
+            held_slope = slope;
+            held_spindle = *pins->spindle;
+        }
+        previous_x = x;
+        previous_z = z;
+    }
+};
