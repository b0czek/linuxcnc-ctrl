diff --git a/src/emc/motion/power_jog.c b/src/emc/motion/power_jog.c
new file mode 100644
index 0000000000..2303950aac
--- /dev/null
+++ b/src/emc/motion/power_jog.c
@@ -0,0 +1,128 @@
+#include <float.h>
+#include <rtapi_math.h>
+#include "power_jog.h"
+#include "mot_priv.h"
+#include "../tp/sp_scurve.h"
+
+void power_jog_abort(power_jog_t *jog, int immediate)
+{
+    if (!power_jog_reserved(jog) ||
+        (jog->phase == POWER_JOG_STOPPING && !immediate)) return;
+    if (jog->phase == POWER_JOG_HELD) jog->neutral_seen = 0;
+    jog->phase = immediate ? POWER_JOG_WAIT_RELEASE : POWER_JOG_STOPPING;
+    if (immediate && jog->neutral_seen) jog->phase = POWER_JOG_IDLE;
+    jog->requested[0] = jog->requested[1] = 0;
+    jog->path.enable = 0;
+    if (immediate) {
+        simple_tp_set_pos(&jog->path, jog->path.curr_pos);
+    }
+}
+
+int power_jog_request(power_jog_t *jog, int x, int z, double feed,
+                      int spindle, double slope)
+{
+    if (!x && !z) {
+        if (jog->phase == POWER_JOG_HELD) power_jog_abort(jog, 0);
+        jog->neutral_seen = 1;
+        if (jog->phase == POWER_JOG_WAIT_RELEASE) jog->phase = POWER_JOG_IDLE;
+        return 0;
+    }
+    if (x < -1 || x > 1 || z < -1 || z > 1 ||
+        !isfinite(slope) || fabs(slope) > 1)
+        return -1;
+    /* A released/cancelled jog must finish stopping before a new press. */
+    if (jog->phase != POWER_JOG_IDLE &&
+        (jog->phase != POWER_JOG_HELD || spindle != jog->spindle ||
+         slope != jog->slope))
+        return -1;
+    if (jog->phase == POWER_JOG_IDLE) {
+        if (!isfinite(feed) || feed <= 0) return -1;
+        jog->feed = feed;
+        jog->slope = slope;
+        jog->spindle = spindle;
+        jog->running[0] = jog->running[1] = 0;
+        simple_tp_set_pos(&jog->path, 0);
+        jog->phase = POWER_JOG_HELD;
+        jog->neutral_seen = 0;
+    }
+    jog->requested[0] = x;
+    jog->requested[1] = z;
+    return 0;
+}
+
+void power_jog_update(power_jog_t *jog, power_jog_axis_t axes[2],
+                     double speed, double override, double period)
+{
+    if (!power_jog_reserved(jog)) return;
+    /* A release can arrive before the first servo update establishes a path. */
+    if (jog->phase == POWER_JOG_STOPPING &&
+        !jog->running[0] && !jog->running[1]) {
+        simple_tp_set_pos(&jog->path, jog->path.curr_pos);
+        jog->phase = jog->neutral_seen ? POWER_JOG_IDLE : POWER_JOG_WAIT_RELEASE;
+        return;
+    }
+    int changed = jog->requested[0] != jog->running[0] ||
+                  jog->requested[1] != jog->running[1];
+    if (changed && jog->path.active) jog->path.enable = 0;
+    if ((changed || !jog->path.enable) && !jog->path.active &&
+        jog->phase == POWER_JOG_HELD) {
+        double x = jog->requested[0], z = jog->requested[1];
+        double norm = sqrt((x*x + z*z) * (1 + jog->slope*jog->slope));
+        jog->direction[0] = (x + jog->slope*z) / norm;
+        jog->direction[1] = (z - jog->slope*x) / norm;
+        for (int i = 0; i < 2; ++i) {
+            jog->origin[i] = axes[i].position;
+            jog->running[i] = jog->requested[i];
+        }
+        simple_tp_set_pos(&jog->path, 0);
+        jog->path.enable = 1;
+    }
+
+    double velocity = DBL_MAX, acceleration = DBL_MAX, jerk = DBL_MAX;
+    double target = DBL_MAX;
+    for (int i = 0; i < 2; ++i) {
+        double d = jog->direction[i], magnitude = fabs(d);
+        if (magnitude < 1e-12) continue;
+        velocity = fmin(velocity, axes[i].velocity / magnitude);
+        acceleration = fmin(acceleration, axes[i].acceleration / magnitude);
+        jerk = fmin(jerk, axes[i].jerk / magnitude);
+        double limit = d > 0 ? axes[i].maximum : axes[i].minimum;
+        target = fmin(target, (limit - jog->origin[i]) / d);
+    }
+    if (!(velocity > 0) || !(acceleration > 0) || target == DBL_MAX) {
+        power_jog_abort(jog, 1);
+        return;
+    }
+    double requested_speed = jog->feed * fabs(speed) * fmax(0, override);
+    if (!isfinite(requested_speed)) {
+        power_jog_abort(jog, 0);
+        requested_speed = 0;
+    }
+    jog->path.max_vel = fmin(velocity, requested_speed);
+    jog->path.max_acc = acceleration;
+    jog->path.max_jerk = jerk;
+    if (jog->path.enable) jog->path.pos_cmd = fmax(0, target);
+    double previous = jog->path.curr_pos;
+    if (GET_TRAJ_PLANNER_TYPE() && jerk > 0.0001) {
+        if (sp_scurve_jog_step(&jog->path, period)) {
+            power_jog_abort(jog, 1);
+            rtapi_print_msg(RTAPI_MSG_ERR, "Power jog: unable to plan scalar path\n");
+        }
+    } else {
+        simple_tp_update_normal(&jog->path, period);
+    }
+    /* An edited limit must never make the planner reverse the held request. */
+    if (jog->path.curr_pos > target || jog->path.curr_pos < previous) {
+        jog->path.curr_pos = fmax(previous, fmin(jog->path.curr_pos, target));
+        power_jog_abort(jog, 1);
+    }
+    for (int i = 0; i < 2; ++i)
+        axes[i].position = jog->origin[i] + jog->direction[i]*jog->path.curr_pos;
+    if (!jog->path.active && (jog->phase == POWER_JOG_STOPPING ||
+        (jog->path.enable && fabs(jog->path.pos_cmd - jog->path.curr_pos) <=
+         TINY_DP(acceleration, period)))) {
+        /* A disabled planner may be stopping to change direction. */
+        jog->phase = (jog->phase == POWER_JOG_STOPPING && jog->neutral_seen) ?
+            POWER_JOG_IDLE : POWER_JOG_WAIT_RELEASE;
+    }
+}
