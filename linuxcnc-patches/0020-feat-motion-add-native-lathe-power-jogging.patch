  * destruction on every call.
  */
 static RuckigPlanner cached_planner = NULL;
+static RuckigPlanner jog_planner = NULL;
 static double cached_cycle_time = 0.0;  /* cycle time used by the current planner */
 
 /**
@@ -96,6 +97,57 @@ static RuckigPlanner get_cached_planner(void) {
     return cached_planner;
 }
 
+int sp_scurve_jog_step(simple_tp_t *tp, double period)
+{
+    RuckigPlanner planner = jog_planner;
+    if (!planner) return -1;
+    ruckig_reset(planner);
+    int moving = tp->enable && tp->max_vel > 0;
+    int result;
+    if (moving) {
+        result = ruckig_plan_position(planner, tp->curr_pos, tp->curr_vel,
+            tp->curr_acc, tp->pos_cmd, 0, 0, 0,
+            tp->max_vel, tp->max_acc, tp->max_jerk);
+    } else {
+        result = ruckig_plan_velocity(planner, tp->curr_vel, tp->curr_acc,
+            0, 0, 0, tp->max_acc, tp->max_jerk);
+    }
+    if (result) return -1;
+    double position, velocity, acceleration, jerk;
+    if (ruckig_at_time(planner, period, &position, &velocity, &acceleration, &jerk))
+        return -1;
+    tp->curr_pos = moving ? position : tp->curr_pos + position;
+    tp->curr_vel = velocity;
+    tp->curr_acc = acceleration;
+    tp->curr_jerk = jerk;
+    tp->active = ruckig_get_duration(planner) > period;
+    return 0;
+}
+
+int sp_scurve_jog_init(double cycle_time)
+{
+    if (jog_planner) return 0;
+    jog_planner = ruckig_create(cycle_time);
+    if (!jog_planner) return -1;
+    ruckig_set_logging(jog_planner, 0);
+    /* Allocate the explicit velocity bound before entering the servo thread. */
+    if (ruckig_plan_velocity(jog_planner, 0, 0, 0, 0, 0, 1, 1)) {
+        ruckig_destroy(jog_planner);
+        jog_planner = NULL;
+        return -1;
+    }
+    ruckig_reset(jog_planner);
+    return 0;
+}
+
+void sp_scurve_jog_cleanup(void)
+{
+    if (jog_planner) {
+        ruckig_destroy(jog_planner);
+        jog_planner = NULL;
+    }
+}
