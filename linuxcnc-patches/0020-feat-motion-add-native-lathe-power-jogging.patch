+#ifndef POWER_JOG_H
+#define POWER_JOG_H
+
+#include "simple_tp.h"
+
+/* One held X/Z request. Feed and geometry belong to the first press. */
+typedef struct {
+    double position, minimum, maximum, velocity, acceleration, jerk;
+} power_jog_axis_t;
+
+typedef enum {
+    POWER_JOG_IDLE,
+    POWER_JOG_HELD,
+    POWER_JOG_STOPPING,
+    POWER_JOG_WAIT_RELEASE
+} power_jog_phase_t;
+
+typedef struct {
+    simple_tp_t path;
+    power_jog_phase_t phase;
+    int neutral_seen, spindle;
+    int requested[2], running[2];
+    double feed, slope, origin[2], direction[2];
+} power_jog_t;
+
+static inline int power_jog_reserved(const power_jog_t *jog)
+{
+    return jog->phase == POWER_JOG_HELD || jog->phase == POWER_JOG_STOPPING;
+}
+
+int power_jog_request(power_jog_t *jog, int x, int z, double feed,
+                      int spindle, double slope);
+void power_jog_abort(power_jog_t *jog, int immediate);
+void power_jog_update(power_jog_t *jog, power_jog_axis_t axes[2],
+                     double speed, double override, double period);
+
+#endif
