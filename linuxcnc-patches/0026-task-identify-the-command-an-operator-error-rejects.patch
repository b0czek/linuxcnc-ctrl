From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dariusz Majnert <dariusz.majnert@gmail.com>
Date: Wed, 25 Nov 2026 12:09:21 +0100
Subject: [PATCH] task: identify the command an operator error rejects

Operator errors carry no command identity, so a client that writes a
command and then reads the error channel cannot tell whether an error
explains why that command was refused or was raised by something else,
such as a running program, motion, or another client's command.

Add command_serial to EMC_OPERATOR_ERROR. While emcTaskPlan() plans or
issues a new command read from the command channel, including the
interpreter errors raised by an MDI line it issues, operator errors carry
that command's serial number. Errors raised elsewhere carry 0: program
readahead, queued MDI and subroutine continuation, execution of queued
interpreter commands, the configured ON_ABORT_COMMAND, motion and IO
faults, and operator messages relayed from the command channel.

The abort handler runs after the abort, machine-off, E-stop, or failure
that triggered it has taken effect, so an error it raises does not mean
the triggering command was refused.
---
 src/emc/nml_intf/emc.cc     |  1 +
 src/emc/nml_intf/emc_nml.hh |  7 ++++++-
 src/emc/task/emctask.cc     |  4 ++++
 src/emc/task/emctaskmain.cc | 17 +++++++++++++++++
 src/emc/task/task.hh        | 18 ++++++++++++++++++
 5 files changed, 46 insertions(+), 1 deletion(-)

diff --git a/src/emc/nml_intf/emc.cc b/src/emc/nml_intf/emc.cc
index 133869b..a6ac0c1 100644
--- a/src/emc/nml_intf/emc.cc
+++ b/src/emc/nml_intf/emc.cc
@@ -1761,6 +1761,7 @@ void EMC_TRAJ_CMD_MSG::update(CMS * /*cms*/)
 void EMC_OPERATOR_ERROR::update(CMS * cms)
 {
     cms->update(error, LINELEN);
+    cms->update(command_serial);
 }
 
 /*
diff --git a/src/emc/nml_intf/emc_nml.hh b/src/emc/nml_intf/emc_nml.hh
index a9fc353..b105d58 100644
--- a/src/emc/nml_intf/emc_nml.hh
+++ b/src/emc/nml_intf/emc_nml.hh
@@ -41,12 +41,17 @@ class EMC_OPERATOR_ERROR:public RCS_CMD_MSG {
   public:
     EMC_OPERATOR_ERROR()
       : RCS_CMD_MSG(EMC_OPERATOR_ERROR_TYPE, sizeof(EMC_OPERATOR_ERROR)),
-        error{}
+        error{},
+        command_serial(0)
     {};
 
     // For internal NML/CMS use only.
     void update(CMS * cms);
     char error[LINELEN];
+    // Serial number of the command-channel command whose handling raised
+    // this error, or 0 when the error was not raised while task planned or
+    // issued a command it read from the command channel.
+    int command_serial;
 };
 
 /**
diff --git a/src/emc/task/emctask.cc b/src/emc/task/emctask.cc
index b6793d2..f378a53 100644
--- a/src/emc/task/emctask.cc
+++ b/src/emc/task/emctask.cc
@@ -865,6 +865,10 @@ int emcTaskUpdate(EMC_TASK_STAT * stat)
 
 int emcAbortCleanup(EMC_ABORT reason, const char *message)
 {
+    // The configured abort handler runs after the abort, state change, or
+    // failure that triggered it has already taken effect, so its errors do
+    // not explain why a command was refused.
+    CommandErrorSerialScope background(0);
     int status = interp.on_abort((int)reason,message);
     if (status > INTERP_MIN_ERROR)
 	print_interp_error(status);
diff --git a/src/emc/task/emctaskmain.cc b/src/emc/task/emctaskmain.cc
index 758ed70..d84d396 100644
--- a/src/emc/task/emctaskmain.cc
+++ b/src/emc/task/emctaskmain.cc
@@ -166,6 +166,8 @@ static int emcTaskIssueCommand(NMLmsg * cmd);
 // pending command to be sent out by emcTaskExecute()
 std::unique_ptr<NMLmsg> emcTaskCommand;
 
+int emcCommandErrorSerial = 0;
+
 // signal handling code to stop main loop
 volatile int done;
 static int emctask_shutdown(void);
@@ -318,6 +320,7 @@ int emcOperatorError(const char *fmt, ...)
 
     // force a NULL at the end for safety
     error_msg.error[LINELEN - 1] = 0;
+    error_msg.command_serial = emcCommandErrorSerial;
 
     // write it
     rcs_print("%s\n", error_msg.error);
@@ -656,6 +659,9 @@ extern int emcTaskMopup();
 
 void readahead_reading(void)
 {
+    // Program and queued MDI execution are not part of the command being
+    // handled in this cycle.
+    CommandErrorSerialScope background(0);
     // While a Stop or Pause holds, only an executor remap polling a request
     // it has started runs, until the request ends; nothing past it is read.
     const bool held =
@@ -840,6 +846,9 @@ void mdi_execute_abort(void)
 
 static void mdi_execute_hook(void)
 {
+    // Program and queued MDI execution are not part of the command being
+    // handled in this cycle.
+    CommandErrorSerialScope background(0);
     if (mdi_execute_wait && emcTaskPlanIsWait()) {
 	// delay reading of next line until all is done
 	if (interp_list.len() == 0 &&
@@ -900,6 +909,9 @@ static void mdi_execute_hook(void)
 
 void readahead_waiting(void)
 {
+    // Program and queued MDI execution are not part of the command being
+    // handled in this cycle.
+    CommandErrorSerialScope background(0);
     if (emcStatus->task.stopState != EMC_TASK_STOP_STATE::IDLE) {
         return;
     }
@@ -1356,6 +1368,11 @@ static int emcTaskPlan(void)
 	return retval;
     }
 
+    // Operator errors raised while planning or issuing a new command explain
+    // why it was refused, so they carry its serial number. Relayed operator
+    // messages above are not about the command that carried them.
+    CommandErrorSerialScope command_errors(type ? emcCommand->serial_number : 0);
+
     if (type == EMC_TASK_PLAN_STOP_TYPE) {
         return emcTaskIssueCommand(emcCommand);
     }
diff --git a/src/emc/task/task.hh b/src/emc/task/task.hh
index 4220b67..010dc97 100644
--- a/src/emc/task/task.hh
+++ b/src/emc/task/task.hh
@@ -65,4 +65,22 @@ int emcTaskPlanCommand(char *cmd);
 
 int emcTaskUpdate(EMC_TASK_STAT * stat);
 
+// Serial number of the command-channel command whose handling raises
+// operator errors, or 0. emcOperatorError() copies it into each error.
+extern int emcCommandErrorSerial;
+
+// Sets the serial carried by operator errors for the lifetime of the scope.
+class CommandErrorSerialScope {
+  public:
+    explicit CommandErrorSerialScope(int serial) : saved(emcCommandErrorSerial) {
+        emcCommandErrorSerial = serial;
+    }
+    ~CommandErrorSerialScope() { emcCommandErrorSerial = saved; }
+    CommandErrorSerialScope(const CommandErrorSerialScope &) = delete;
+    CommandErrorSerialScope &operator=(const CommandErrorSerialScope &) = delete;
+
+  private:
+    int saved;
+};
+
 #endif
