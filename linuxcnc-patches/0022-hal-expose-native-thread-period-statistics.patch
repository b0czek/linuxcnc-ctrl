+#!/bin/sh
+set -eu
+
+test_dir=$(mktemp -d)
+trap 'rm -rf -- "$test_dir"' EXIT
+cc -std=gnu11 -DULAPI -I"$EMC2_HOME/src/hal" -I"$EMC2_HOME/src/rtapi" \
+    -I"$EMC2_HOME/src" -I"$EMC2_HOME/src/include" \
+    -o "$test_dir/arithmetic" arithmetic.c
+"$test_dir/arithmetic"
diff --git a/tests/thread-period-stats/README b/tests/thread-period-stats/README
new file mode 100644
index 0000000000..635e1f6edf
--- /dev/null
+++ b/tests/thread-period-stats/README
@@ -0,0 +1,3 @@
+The period statistics must not prevent a valid 15-character thread name from
+starting. Long thread names use stable, compact suffixes. The sample counter
+is a 64-bit decimal HAL parameter and advances after the thread starts.
diff --git a/tests/thread-period-stats/checkresult b/tests/thread-period-stats/checkresult
new file mode 100755
index 0000000000..52606ccb7b
--- /dev/null
+++ b/tests/thread-period-stats/checkresult
@@ -0,0 +1,20 @@
+#!/usr/bin/env python3
+import sys
+
+samples = {"servo-thread.sample-count": [], "long-thread-123.p14": []}
+resets = {"servo-thread.period-stats-reset": False, "long-thread-123.pr": False}
+with open(sys.argv[1], encoding="utf-8") as output:
+    for line in output:
+        fields = line.split()
+        if len(fields) >= 5 and fields[-1] in samples:
+            if fields[1] != "s64" or fields[2] != "RO":
+                raise SystemExit("sample counter has an unexpected type")
+            samples[fields[-1]].append(int(fields[-2], 0))
+        if len(fields) >= 5 and fields[-1] in resets:
+            resets[fields[-1]] = fields[1] == "bit" and fields[2] == "RW"
+
+if not all(resets.values()):
+    raise SystemExit("thread reset parameter was not published")
+for name, observed in samples.items():
+    if len(observed) != 2 or observed[0] != 0 or observed[1] <= 0:
+        raise SystemExit("sample counter did not advance after thread start: " + name)
