diff --git a/tests/thread-period-stats-arithmetic/arithmetic.c b/tests/thread-period-stats-arithmetic/arithmetic.c
new file mode 100644
index 0000000000..b424f911f7
--- /dev/null
+++ b/tests/thread-period-stats-arithmetic/arithmetic.c
@@ -0,0 +1,81 @@
+#include <assert.h>
+#include <limits.h>
+#include <string.h>
+
+#include "hal_period_stats.h"
+
+int main(void)
+{
+    hal_thread_t thread;
+
+    memset(&thread, 0, sizeof(thread));
+    thread.period = 1000000;
+    thread.target_period_ns = 1000000;
+
+    assert(!hal_period_stats_record_start(&thread, 1000000));
+    assert(thread.sample_count == 0);
+
+    assert(hal_period_stats_record_start(&thread, 2100000));
+    hal_period_stats_record_execution(&thread, 80000);
+    assert(thread.last_period_ns == 1100000);
+    assert(thread.current_jitter_ns == 100000);
+    assert(thread.minimum_period_ns == 1100000);
+    assert(thread.maximum_period_ns == 1100000);
+    assert(thread.jitter_over_quarter_period_count == 0);
+    assert(thread.deadline_misses == 0);
+
+    assert(hal_period_stats_record_start(&thread, 3700000));
+    hal_period_stats_record_execution(&thread, 120000);
+    assert(thread.sample_count == 2);
+    assert(thread.average_period_ns == 1350000);
+    assert(thread.average_jitter_ns == 350000);
+    assert(thread.maximum_jitter_ns == 600000);
+    assert(thread.jitter_over_quarter_period_count == 1);
+    assert(thread.jitter_over_half_period_count == 1);
+    assert(thread.last_jitter_over_quarter_period_sample == 2);
+    assert(thread.average_execution_ns == 100000);
+    assert(thread.maximum_execution_ns == 120000);
+
+    assert(hal_period_stats_record_start(&thread, 6800000));
+    hal_period_stats_record_execution(&thread, 40000);
+    assert(thread.sample_count == 3);
+    assert(thread.last_period_ns == 3100000);
+    assert(thread.minimum_period_ns == 1100000);
+    assert(thread.maximum_period_ns == 3100000);
+    assert(thread.current_jitter_ns == 2100000);
+    assert(thread.average_period_ns == 1933333);
+    assert(thread.average_jitter_ns == 933333);
+    assert(thread.maximum_jitter_ns == 2100000);
+    assert(thread.jitter_over_quarter_period_count == 2);
+    assert(thread.jitter_over_half_period_count == 2);
+    assert(thread.last_jitter_over_quarter_period_sample == 3);
+    assert(thread.deadline_misses == 1);
+    assert(thread.average_execution_ns == 80000);
+    assert(thread.maximum_execution_ns == 120000);
+
+    thread.period_stats_reset = 1;
+    assert(!hal_period_stats_record_start(&thread, 7800000));
+    assert(!thread.period_stats_reset);
+    assert(thread.sample_count == 0);
+    assert(thread.maximum_period_ns == 0);
+    assert(thread.maximum_jitter_ns == 0);
+    assert(thread.maximum_execution_ns == 0);
+    assert(thread.jitter_over_quarter_period_count == 0);
+    assert(thread.deadline_misses == 0);
+    assert(thread.target_period_ns == 1000000);
+
+    assert(hal_period_stats_record_start(&thread, 8800000));
+    hal_period_stats_record_execution(&thread, 60000);
+    assert(thread.sample_count == 1);
+    assert(thread.average_period_ns == 1000000);
+    assert(thread.average_jitter_ns == 0);
+    assert(thread.average_execution_ns == 60000);
+
+    thread.sample_count = UINT_MAX;
+    assert(hal_period_stats_record_start(&thread, 9800000));
+    hal_period_stats_record_execution(&thread, 200000);
+    assert(thread.sample_count == (long long)UINT_MAX + 1);
+    assert(thread.maximum_execution_ns == 200000);
+
+    return 0;
+}
