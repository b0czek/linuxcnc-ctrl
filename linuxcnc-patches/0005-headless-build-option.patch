diff --git a/debian/rules.in b/debian/rules.in
index a7cf564..dee33e7 100644
--- a/debian/rules.in
+++ b/debian/rules.in
@@ -32,6 +32,15 @@ export TIME:=$(shell LANG=C date --date='@$(TIMESTAMP)' '+%T')
 
 kernel_version = @KERNEL_VERSION@
 configure_realtime_arg = @CONFIGURE_REALTIME_ARG@
+# Build profiles: pkg.linuxcnc.headless builds without LinuxCNC's GUIs (run
+# debian/configure with the same DEB_BUILD_PROFILES so the package manifest
+# and dependencies match); nodoc builds neither documentation nor manpages.
+ifneq (,$(filter pkg.linuxcnc.headless,$(DEB_BUILD_PROFILES)))
+configure_profile_args += --disable-gui
+endif
+ifneq (,$(filter nodoc,$(DEB_BUILD_PROFILES)))
+configure_profile_args += --disable-build-documentation --disable-manpages
+endif
 ifeq (,$(filter nodocs,$(DEB_BUILD_OPTIONS)))
 enable_build_documentation = @ENABLE_BUILD_DOCUMENTATION@ \
     --enable-build-documentation-translation
@@ -52,6 +61,7 @@ override_dh_auto_configure:
 	    --mandir=/usr/share/man \
 	    $(configure_realtime_arg) \
 	    $(enable_build_documentation) \
+	    $(configure_profile_args) \
 	    --disable-check-runtime-deps
 
 override_dh_auto_build-arch:
@@ -83,7 +93,9 @@ override_dh_auto_install-arch:
 	DESTDIR=$(DESTDIR) $(MAKE) -C src install-software
 	py3clean .
 
+ifeq (,$(filter pkg.linuxcnc.headless,$(DEB_BUILD_PROFILES)))
 	desktop-file-validate $(shell find debian/extras/ share/applications/ -name *.desktop);
+endif
 
 	# some clean-up
 	rm -f $(DESTDIR)/usr/share/doc/@MAIN_PACKAGE_NAME@/examples/sample-configs/*/*position*.txt
@@ -96,7 +108,12 @@ override_dh_installdocs-arch:
 	# script looks for them, and that's inconvenient to change.
 	dh_installdocs --doc-main-package=@MAIN_PACKAGE_NAME@ --package=@MAIN_PACKAGE_NAME@
 	mkdir -p debian/@MAIN_PACKAGE_NAME@/usr/share/doc/linuxcnc
+ifeq (,$(filter nodoc,$(DEB_BUILD_PROFILES)))
 	mv debian/@MAIN_PACKAGE_NAME@/usr/share/doc/@MAIN_PACKAGE_NAME@/examples debian/@MAIN_PACKAGE_NAME@/usr/share/doc/linuxcnc
+else
+	# dh_installdocs installs no .docs entries under the nodoc build profile.
+	cp -a $(DESTDIR)/usr/share/doc/linuxcnc/examples debian/@MAIN_PACKAGE_NAME@/usr/share/doc/linuxcnc
+endif
 
 	dh_installdocs --doc-main-package=@MAIN_PACKAGE_NAME@ --package=@MAIN_PACKAGE_NAME@-dev
 
@@ -139,6 +156,18 @@ else
 	$(RM) -fr debian/tmp/usr/share/doc/
 endif
 
+override_dh_install:
+	dh_install
+ifneq (,$(filter pkg.linuxcnc.headless,$(DEB_BUILD_PROFILES)))
+	# The headless manifest installs all of usr/bin; halcompile belongs to -dev.
+	rm -f debian/@MAIN_PACKAGE_NAME@/usr/bin/halcompile
+endif
+
+override_dh_installman:
+ifeq (,$(filter nodoc,$(DEB_BUILD_PROFILES)))
+	dh_installman
+endif
