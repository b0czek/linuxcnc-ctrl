-        if tty -s || [ -z "$DISPLAY" ] ; then
+        if tty -s || [ -z "$DISPLAY" ] || [ "$BUILD_GUI" != yes ]; then
             if [ -f "$DEBUG_FILE" ]; then
                 cp "$DEBUG_FILE" "$HOME/linuxcnc_debug.txt"
             else
@@ -343,6 +347,12 @@ if [ -n "$USE_LAST_INIFILE" ]; then
     echo "Using previous INI file: $INIFILE" >> "$PRINT_FILE"
 fi
 
+if [ -z "$INIFILE" ] && [ "$BUILD_GUI" != yes ]; then
+    echo "LinuxCNC was built without a GUI and needs an explicit INI file path." >&2
+    usage >&2
+    exit 2
+fi
+
 if [ -z "$INIFILE" ] ; then
     # nothing specified, get from the user
     # it returns either a path, or nothing at all
