+COMM_TIMEOUT = 4.0
+BASE_PERIOD = 0
+SERVO_PERIOD = 1000000
+
+[TASK]
+TASK = milltask
+CYCLE_TIME = 0.001
+
+[HAL]
+HALFILE = LIB:core_sim.hal
+
+[TRAJ]
+NO_FORCE_HOMING = 1
+COORDINATES = X Z
+LINEAR_UNITS = mm
+ANGULAR_UNITS = degree
+DEFAULT_LINEAR_VELOCITY = 30
+MAX_LINEAR_VELOCITY = 100
+
+[EMCIO]
