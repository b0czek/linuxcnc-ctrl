new file mode 100644
index 0000000..aea66da
--- /dev/null
+++ b/tests/interp/tool-line-length/test.ngc
@@ -0,0 +1,12 @@
+; Tool table lines up to 510 characters load whole; longer ones are refused
+; with an error rather than cut. G43 H applies geometry plus wear, so the
+; applied offset shows every number of a loaded line.
+; test.tbl: T1's line is 510 characters, T2's 511, T3's 600, T4's 521 (a
+; 511-byte read would cut its closing WZ number), T5's ordinary. Each long
+; line ends in WZ, so a cut line would lose or shorten its Z wear.
+g21
+g43 h1
+(debug,T1 510 chars: #5081 #5083)
+g43 h5
+(debug,T5 after the long lines: #5081 #5083)
+m2
diff --git a/tests/interp/tool-line-length/test.sh b/tests/interp/tool-line-length/test.sh
new file mode 100755
index 0000000..0822c76
--- /dev/null
+++ b/tests/interp/tool-line-length/test.sh
@@ -0,0 +1,17 @@
+#!/bin/bash
+# Canon output, then the loader's refusals (stderr), in a stable order.
+rs274 -g test.ngc -t test.tbl 2> err.txt | awk '{$1=""; print}'
+result=${PIPESTATUS[0]}
+grep "longer than" err.txt
+rm -f err.txt
+if (( result != 0 )); then
+    exit "$result"
+fi
+
+# a refused line's tool is not in the table at all
+for missing in missing-t*.ngc; do
+    if rs274 -g "$missing" -t test.tbl >/dev/null 2>&1; then
+        echo "$missing: tool loaded from an over-long line" >&2
+        exit 1
+    fi
+done
