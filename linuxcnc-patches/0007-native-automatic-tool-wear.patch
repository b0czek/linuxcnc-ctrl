+#!/bin/bash
+set -x
+set -e
+
+rm -f sim.var*
+
+# run 1: the longest allowed line loads whole
+linuxcnc -r test.ini
+
+# run 2: a longer line is refused (the db program is told to send one)
+sed -e 's#^DB_PROGRAM = ./db_long.py$#DB_PROGRAM = ./db_long.py long#' base.inc > long.inc
+sed -e 's#^\#INCLUDE base.inc#\#INCLUDE long.inc#' long.ini > long-run.ini
+linuxcnc -r long-run.ini
+rm -f long.inc long-run.ini
