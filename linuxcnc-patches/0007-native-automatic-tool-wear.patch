+VERSION = 1.1
+DEBUG = 0
+
+[DISPLAY]
+DISPLAY = ./run1.py
+LATHE = 1
+
+[RS274NGC]
+PARAMETER_FILE = sim.var
+
+
+[EMCMOT]
