+#!/usr/bin/env python3
+# The 510-character T1 line from the db program loads with every number.
+import sys
+sys.path.insert(0, "../db-g10-offset")
+from dbtest_lib import start_machine, check, fail
+
+(c, s) = start_machine()
+s.poll()
+t1 = [t for t in s.tool_table[1:] if t.id == 1]
+if len(t1) != 1:
+    fail("T1 (a 510-character line) was not loaded")
+check("T1 xoffset", t1[0].xoffset, 1.0)
+check("T1 wzoffset at the end of the line", t1[0].wzoffset, -0.7555555555)
+t2 = [t for t in s.tool_table[1:] if t.id == 2]
+if len(t2) != 1:
+    fail("T2 was not loaded")
+check("T2 wzoffset", t2[0].wzoffset, -0.125)
+sys.exit(0)
