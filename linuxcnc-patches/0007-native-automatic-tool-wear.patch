@@ -0,0 +1,30 @@
+#!/usr/bin/env python3
+# [EMCIO]DB_PROGRAM whose T1 line is exactly 510 characters (the longest
+# allowed), or 600 with the argument "long", which also adds a T3 line of
+# 5000 characters, longer than one pipe packet. The WZ word ends each long
+# line, so a reader that cut a line would cut that number.
+import sys
+
+from tooldb import tooldb_callbacks, tooldb_tools, tooldb_loop
+
+length = 600 if sys.argv[1:] == ["long"] else 510
+
+head = "T1 P1 X+1 Z+2 WX+0.5 D0."
+tail = " WZ-0.7555555555"
+t1 = head + "0" * (length - len(head) - len(tail)) + tail
+assert len(t1) == length
+
+tools = {1: t1, 2: "T2 P2 Z+3 WZ-0.125"}
+if length == 600:
+    head3 = "T3 P3 Z+4 D0."
+    tools[3] = head3 + "0" * (5000 - len(head3) - len(tail)) + tail
+
+def get_tool(tno):
+    return tools[tno]
+
+def ignore(tno, params):
+    pass
+
+tooldb_callbacks(get_tool, ignore, ignore, ignore)
+tooldb_tools(sorted(tools))
+tooldb_loop()
diff --git a/tests/tooldb/db-line-length/long-ui.py b/tests/tooldb/db-line-length/long-ui.py
new file mode 100755
index 0000000..86eb97f
--- /dev/null
+++ b/tests/tooldb/db-line-length/long-ui.py
@@ -0,0 +1,34 @@
+#!/usr/bin/env python3
+# A 600-character T1 line and a 5000-character T3 line (two pipe packets)
+# from the db program are refused, each read to its end:
+# T1 is not in the tool table (not with a number cut short), T2 after it is
+# loaded, and the db program is still in step for the next exchange.
+import sys
+sys.path.insert(0, "../db-g10-offset")
+from dbtest_lib import start_machine, check, fail
+
+import linuxcnc
+
+(c, s) = start_machine()
+s.poll()
+for t in s.tool_table[1:]:
+    if t.id == 1:
+        fail("T1 loaded from a 600-character line: wzoffset=%f" % t.wzoffset)
+    if t.id == 3:
+        fail("T3 loaded from a 5000-character line: wzoffset=%f" % t.wzoffset)
+print("ok: the 600- and 5000-character lines were refused")
+t2 = [t for t in s.tool_table[1:] if t.id == 2]
+if len(t2) != 1:
+    fail("T2, after the refused line, was not loaded")
+check("T2 wzoffset", t2[0].wzoffset, -0.125)
+
+# a G10 notifies the db program and reads its reply: out of step, this
+# would read leftovers of the refused line instead
+c.mdi("G10 L1 P2 Z4")
+c.wait_complete()
+s.poll()
+if s.state != linuxcnc.RCS_DONE:
+    fail("G10 L1 after the refused line failed: state %d" % s.state)
+t2 = [t for t in s.tool_table[1:] if t.id == 2]
+check("T2 zoffset after G10 L1", t2[0].zoffset, 4.0)
+sys.exit(0)
