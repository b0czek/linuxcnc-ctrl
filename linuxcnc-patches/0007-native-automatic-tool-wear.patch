+MAX_LIMIT = 300.0
+MAX_VELOCITY = 100
+MAX_ACCELERATION = 1000.0
+
+[JOINT_0]
+TYPE = LINEAR
+HOME = 0.0
+MAX_VELOCITY = 100
+MAX_ACCELERATION = 1000.0
+MIN_LIMIT = -300.0
+MAX_LIMIT = 300.0
+FERROR = 1.0
+MIN_FERROR = 0.25
+HOME_SEQUENCE = 0
+
+[AXIS_Z]
+MIN_LIMIT = -300.0
+MAX_LIMIT = 300.0
+MAX_VELOCITY = 100
+MAX_ACCELERATION = 1000.0
+
+[JOINT_1]
+# Y, not used on the lathe
+TYPE = LINEAR
+HOME = 0.0
+MAX_VELOCITY = 100
+MAX_ACCELERATION = 1000.0
+HOME_SEQUENCE = 0
+
+[JOINT_2]
+TYPE = LINEAR
+HOME = 0.0
+MAX_VELOCITY = 100
+MAX_ACCELERATION = 1000.0
+MIN_LIMIT = -300.0
+MAX_LIMIT = 300.0
+FERROR = 1.0
+MIN_FERROR = 0.25
+HOME_SEQUENCE = 0
