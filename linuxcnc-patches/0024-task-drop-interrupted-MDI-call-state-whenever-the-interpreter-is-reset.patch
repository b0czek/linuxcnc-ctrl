diff --git a/src/emc/task/emctaskmain.cc b/src/emc/task/emctaskmain.cc
index 9097f40..7176809 100644
--- a/src/emc/task/emctaskmain.cc
+++ b/src/emc/task/emctaskmain.cc
@@ -798,10 +798,18 @@ interpret_again:
 		}		// if interp len is less than max
 }
 
-static void mdi_execute_abort(void)
+static void mdi_execute_drop_queue(void)
 {
-    int queued_mdi_commands;
+    int queued_mdi_commands = mdi_execute_queue.len();
+    if (queued_mdi_commands > 0) {
+        rcs_print("mdi_execute_abort: dropping %d queued MDI commands\n", queued_mdi_commands);
+    }
+    mdi_execute_queue.clear();
+    emcStatus->task.queuedMDIcommands = 0;
+}
 
+void mdi_execute_abort(void)
+{
     // XXX: Reset needed?
     if (mdi_execute_wait || mdi_execute_next)
         emcTaskPlanReset();
@@ -809,16 +817,22 @@ static void mdi_execute_abort(void)
     mdi_execute_wait = 0;
     mdi_execute_next = 0;
 
-    queued_mdi_commands = mdi_execute_queue.len();
-    if (queued_mdi_commands > 0) {
-        rcs_print("mdi_execute_abort: dropping %d queued MDI commands\n", queued_mdi_commands);
-    }
-    mdi_execute_queue.clear();
-    emcStatus->task.queuedMDIcommands = 0;
+    mdi_execute_drop_queue();
 
     emcStatus->task.interpState = EMC_TASK_INTERP::IDLE;
 }
 
+// Drop every MDI command the interpreter has not read yet: the queue, and
+// what mdi_execute_hook() already moved from it towards execution.
+static void mdi_execute_drop_unread(void)
+{
+    mdi_execute_drop_queue();
+    interp_list.remove_type(EMC_TASK_PLAN_EXECUTE_TYPE);
+    if (emcTaskCommand && emcTaskCommand->_type == EMC_TASK_PLAN_EXECUTE_TYPE) {
+        emcTaskCommand = NULL;
+    }
+}
+
 static void mdi_execute_hook(void)
 {
     if (mdi_execute_wait && emcTaskPlanIsWait()) {
@@ -3196,7 +3210,23 @@ static int emcTaskIssueCommand(NMLmsg * cmd)
 	break;
 
     case EMC_TASK_PLAN_INIT_TYPE:
+	// MDI commands not read yet were written for the modal state this
+	// discards, so they never run.
+	mdi_execute_drop_unread();
+	// Re-initializing the interpreter drops any call an interrupted MDI
+	// command is still inside of. A command already read keeps running and
+	// keeps its interpreter state, including one that returned
+	// INTERP_EXECUTE_FINISH outside a call (G38.n, M66, M6, G28.2).
+	if (mdi_execute_next || mdi_execute_level >= 0) {
+	    mdi_execute_abort();
+	    emcStatus->task.command[0] = 0;
+	}
 	retval = emcTaskPlanInit();
+	// emcTaskPlanInit() clears the wait; mdi_execute_hook() needs it to see
+	// that command finish
+	if (mdi_execute_wait) {
+	    emcTaskPlanSetWait();
+	}
 	if (retval > INTERP_MIN_ERROR) {
 	    retval = -1;
 	}
