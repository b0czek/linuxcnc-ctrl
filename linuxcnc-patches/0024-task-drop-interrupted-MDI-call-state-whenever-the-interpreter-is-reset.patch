     pass_group = 0;
 }
 
+int NML_INTERP_LIST::remove_type(int type)
+{
+    int removed = 0;
+    for (auto it = linked_list.begin(); it != linked_list.end();) {
+        if (it->command->_type == type) {
+            it = linked_list.erase(it);
+            removed++;
+        } else {
+            ++it;
+        }
+    }
+    return removed;
+}
+
 void NML_INTERP_LIST::print()
 {
     rcs_print("NML_INTERP_LIST::print(): list size=%lu\n", linked_list.size());
