diff --git a/tests/remap/mdi-remap-abort/remap.py b/tests/remap/mdi-remap-abort/remap.py
new file mode 100644
index 0000000..b616b52
--- /dev/null
+++ b/tests/remap/mdi-remap-abort/remap.py
@@ -0,0 +1,9 @@
+import emccanon
+from interpreter import INTERP_EXECUTE_FINISH
+
+
+def m401(self, **words):
+    # Keep the remap mid-execution: dwell, wait for it to finish, repeat.
+    while True:
+        emccanon.DWELL(0.05)
+        yield INTERP_EXECUTE_FINISH
diff --git a/tests/remap/mdi-remap-abort/test-ui.py b/tests/remap/mdi-remap-abort/test-ui.py
new file mode 100755
index 0000000..b6c86ff
--- /dev/null
+++ b/tests/remap/mdi-remap-abort/test-ui.py
@@ -0,0 +1,290 @@
+#!/usr/bin/env python3
+#
+# Interrupt an MDI command whose remap is mid-execution in every way that
+# resets the interpreter without an operator abort (E-stop, machine off,
+# interpreter re-init, mode change), then bring the machine back and check
+# that task is still alive and MDI still works.
+
+import os
+import sys
+import time
+
+import linuxcnc
+
+c = linuxcnc.command()
+s = linuxcnc.stat()
+
+
+def fail(msg):
+    print("FAIL: %s" % msg)
+    sys.exit(1)
+
+
+def task_alive():
+    for pid in os.listdir("/proc"):
+        if not pid.isdigit():
+            continue
+        try:
+            with open("/proc/%s/comm" % pid) as f:
+                if f.read().strip() == "milltask":
+                    return True
+        except OSError:
+            pass
+    return False
+
+
+def wait_for(cond, what, timeout=10.0):
+    start = time.time()
+    while time.time() - start < timeout:
+        s.poll()
+        if cond():
+            return
+        time.sleep(0.02)
+    if not task_alive():
+        fail("milltask died (waiting for %s)" % what)
+    fail("timeout waiting for %s: task_state=%d mode=%d interp_state=%d "
+         "exec_state=%d call_level=%d" % (what, s.task_state, s.task_mode,
+         s.interp_state, s.exec_state, s.call_level))
+
+
+def set_state(state, reported=None):
+    c.state(state)
+    c.wait_complete()
+    if reported is None:
+        reported = state
+    wait_for(lambda: s.task_state == reported, "task state %d" % reported)
+
+
+def set_mode(mode):
+    c.mode(mode)
+    c.wait_complete()
+    wait_for(lambda: s.task_mode == mode, "task mode %d" % mode)
+
+
+def machine_on():
+    set_state(linuxcnc.STATE_ESTOP_RESET)
+    set_state(linuxcnc.STATE_ON)
+
+
+def estop():
+    set_state(linuxcnc.STATE_ESTOP)
+    machine_on()
+
+
+def machine_off():
+    # task reports a machine that is out of E-stop but off as ESTOP_RESET
+    set_state(linuxcnc.STATE_OFF, linuxcnc.STATE_ESTOP_RESET)
+    set_state(linuxcnc.STATE_ON)
+
+
+def plan_init():
+    c.reset_interpreter()
+    c.wait_complete()
+
+
+def plan_init_received():
+    # for a command that keeps task busy: wait_complete() would wait it out
+    c.reset_interpreter()
+    serial = c.serial
+    wait_for(lambda: s.echo_serial_number >= serial,
+             "interpreter re-init to be received")
+
+
+def mode_auto():
+    set_mode(linuxcnc.MODE_AUTO)
+    set_mode(linuxcnc.MODE_MDI)
+
+
+target = [0.0]
+
+
+def check_mdi_works(name):
+    # The machine may have dropped out of MDI mode; select it as a GUI would,
+    # then give task's main loop time to act on any stale MDI state.
+    set_mode(linuxcnc.MODE_MDI)
+    time.sleep(0.5)
+    if not task_alive():
+        fail("%s: milltask died" % name)
+    target[0] = 1.0 if target[0] != 1.0 else 2.0
+    c.mdi("G0 X%.1f" % target[0])
+    c.wait_complete()
+    wait_for(lambda: abs(s.position[0] - target[0]) < 1e-6
+             and s.interp_state == linuxcnc.INTERP_IDLE,
+             "%s: MDI G0 X%.1f" % (name, target[0]))
+    if not task_alive():
+        fail("%s: milltask died" % name)
+
+
+def scenario(name, code, interrupt):
+    set_mode(linuxcnc.MODE_MDI)
+    c.mdi(code)
+    wait_for(lambda: s.interp_state != linuxcnc.INTERP_IDLE,
+             "%s: %s to start" % (name, code))
+    # M400 waits for 3 s, M401 until interrupted; make sure it is waiting.
+    time.sleep(0.3)
+    s.poll()
+    if s.interp_state == linuxcnc.INTERP_IDLE:
+        fail("%s: %s is not waiting inside its remap" % (name, code))
+    # An MDI command sent meanwhile is queued behind the waiting remap; the
+    # interrupt drops it together with the remap's call.
+    c.mdi("G0 X5")
+    wait_for(lambda: s.queued_mdi_commands == 1,
+             "%s: G0 X5 to be queued behind %s" % (name, code))
+    interrupt()
+    # Check before set_mode: selecting a mode clears the queue by itself.
+    s.poll()
+    if s.queued_mdi_commands != 0:
+        fail("%s: %d queued MDI commands survived"
+             % (name, s.queued_mdi_commands))
+    if s.command != "":
+        fail("%s: interrupted command still reported: %r" % (name, s.command))
+    set_mode(linuxcnc.MODE_MDI)
+    time.sleep(0.5)
+    s.poll()
+    if abs(s.position[0] - target[0]) > 1e-6:
+        fail("%s: queued G0 X5 ran (X=%.4f)" % (name, s.position[0]))
+    check_mdi_works(name)
+    print("%s: ok" % name, flush=True)
+
+
+def plain_move_reset():
+    # Re-initializing the interpreter during an ordinary MDI move, with no
+    # interrupted call, leaves the move running and the MDI command active
+    # until the move ends.
+    set_mode(linuxcnc.MODE_MDI)
+    end = target[0] + 4.0
+    c.mdi("G1 X%.1f F120" % end)
+    wait_for(lambda: s.current_vel > 0.0, "plain MDI move to start")
+    # task stays busy until the move ends, so do not wait for completion
+    c.reset_interpreter()
+    serial = c.serial
+    wait_for(lambda: s.echo_serial_number >= serial,
+             "interpreter re-init to be received")
+    if abs(s.position[0] - end) < 0.5:
+        fail("plain MDI move ended before the interpreter re-init")
+    start = time.time()
+    while abs(s.position[0] - end) > 1e-6:
+        if time.time() - start > 10.0:
+            fail("plain MDI move did not end after the interpreter re-init "
+                 "(X=%.4f interp_state=%d)" % (s.position[0], s.interp_state))
+        if s.interp_state == linuxcnc.INTERP_IDLE:
+            fail("interpreter re-init during a plain MDI move reported "
+                 "IDLE while moving (X=%.4f)" % s.position[0])
+        time.sleep(0.02)
+        s.poll()
+    wait_for(lambda: s.interp_state == linuxcnc.INTERP_IDLE
+             and s.exec_state == linuxcnc.EXEC_DONE,
+             "plain MDI move to finish after interpreter re-init")
+    target[0] = end
+    check_mdi_works("plain move interpreter re-init")
+    print("plain move interpreter re-init: ok")
+
+
+def queued_reset(name, during_move):
+    # A command is queued only while task is busy with an earlier one; the
+    # block below keeps its move on the interp list behind the dwell. What is
+    # queued was written for the modal state the re-init discards (here G91),
+    # so none of it may run after the re-init. Once the move is issued the
+    # first queued command is already task's pending command.
+    set_mode(linuxcnc.MODE_MDI)
+    end = target[0] + 4.0
+    c.mdi("G91")
+    c.wait_complete()
+    c.mdi("G4 P0.5 G1 X4 F120")
+    wait_for(lambda: s.exec_state == linuxcnc.EXEC_WAITING_FOR_DELAY,
+             "%s: dwell to start" % name)
+    c.mdi("G0 X1")
+    c.mdi("G0 X1")
+    wait_for(lambda: s.queued_mdi_commands == 2,
+             "%s: G0 X1 to be queued" % name)
+    if during_move:
+        wait_for(lambda: s.current_vel > 0.0 and s.queued_mdi_commands == 1,
+                 "%s: move to start" % name)
+    plan_init_received()
+    s.poll()
+    if s.queued_mdi_commands != 0:
+        fail("%s: %d queued MDI commands survived"
+             % (name, s.queued_mdi_commands))
+    start = time.time()
+    while abs(s.position[0] - end) > 1e-6:
+        if time.time() - start > 10.0:
+            fail("%s: move did not reach X%.1f (X=%.4f)"
+                 % (name, end, s.position[0]))
+        if s.interp_state == linuxcnc.INTERP_IDLE:
+            fail("%s: IDLE while moving (X=%.4f)" % (name, s.position[0]))
+        time.sleep(0.02)
+        s.poll()
+    wait_for(lambda: s.interp_state == linuxcnc.INTERP_IDLE
+             and s.exec_state == linuxcnc.EXEC_DONE,
+             "%s: move to finish" % name)
+    time.sleep(0.5)
+    s.poll()
+    if abs(s.position[0] - end) > 1e-6:
+        fail("%s: a dropped command ran (X=%.4f, expected %.4f)"
+             % (name, s.position[0], end))
+    target[0] = end
+    check_mdi_works(name)
+    print("%s: ok" % name, flush=True)
+
+
+def execute_finish_reset(name, code, busy_for, end=None):
+    # These commands return INTERP_EXECUTE_FINISH without entering a call. A
+    # re-init leaves them running: still reported, not IDLE, and finished
+    # normally, with what was queued behind them dropped.
+    set_mode(linuxcnc.MODE_MDI)
+    c.mdi(code)
+    wait_for(lambda: s.interp_state != linuxcnc.INTERP_IDLE,
+             "%s: to start" % name)
+    time.sleep(0.2)
+    c.mdi("G0 X5")
+    wait_for(lambda: s.queued_mdi_commands == 1,
+             "%s: G0 X5 to be queued" % name)
+    plan_init_received()
+    s.poll()
+    if s.queued_mdi_commands != 0:
+        fail("%s: %d queued MDI commands survived"
+             % (name, s.queued_mdi_commands))
+    start = time.time()
+    while time.time() - start < busy_for:
+        s.poll()
+        if s.interp_state == linuxcnc.INTERP_IDLE:
+            fail("%s: reported IDLE while running" % name)
+        if s.command != code:
+            fail("%s: active command is %r" % (name, s.command))
+        time.sleep(0.02)
+    wait_for(lambda: s.interp_state == linuxcnc.INTERP_IDLE
+             and s.exec_state == linuxcnc.EXEC_DONE,
+             "%s: to finish" % name)
+    wait_for(lambda: s.command == "", "%s: active command to clear" % name)
+    if end is not None:
+        target[0] = end
+    time.sleep(0.3)
+    s.poll()
+    if abs(s.position[0] - target[0]) > 1e-6:
+        fail("%s: X=%.4f, expected %.4f" % (name, s.position[0], target[0]))
+    check_mdi_works(name)
+    print("%s: ok" % name, flush=True)
+
+
+wait_for(lambda: s.task_state == linuxcnc.STATE_ESTOP, "task to start")
+machine_on()
+set_mode(linuxcnc.MODE_MDI)
+check_mdi_works("startup")
+
+for code in ("M400", "M401"):
+    scenario("%s E-stop" % code, code, estop)
+    scenario("%s machine off" % code, code, machine_off)
+    scenario("%s interpreter re-init" % code, code, plan_init)
+    scenario("%s mode change" % code, code, mode_auto)
+
+plain_move_reset()
+queued_reset("queue re-init during dwell", False)
+queued_reset("queue re-init during move", True)
+execute_finish_reset("M66 interpreter re-init", "M66 P0 L3 Q2", 0.8)
+probe_end = target[0] + 3.0
+execute_finish_reset("G38.3 interpreter re-init",
+                     "G38.3 X%.1f F120" % probe_end, 0.5, probe_end)
+
+print("all scenarios passed")
+set_state(linuxcnc.STATE_ESTOP)
+sys.exit(0)
