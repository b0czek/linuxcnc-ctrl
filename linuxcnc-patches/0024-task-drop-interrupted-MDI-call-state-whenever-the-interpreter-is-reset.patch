diff --git a/src/emc/task/emctask.cc b/src/emc/task/emctask.cc
index 5a1e60e..67edc9b 100644
--- a/src/emc/task/emctask.cc
+++ b/src/emc/task/emctask.cc
@@ -282,6 +282,10 @@ int emcTaskAbort()
 	}
     }
 
+    // the reset above unwound any call an interrupted MDI command was
