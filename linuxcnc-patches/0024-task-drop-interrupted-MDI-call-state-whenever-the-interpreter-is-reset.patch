diff --git a/src/emc/task/emctaskmain.cc b/src/emc/task/emctaskmain.cc
index 154c362..72e16f1 100644
--- a/src/emc/task/emctaskmain.cc
+++ b/src/emc/task/emctaskmain.cc
@@ -776,7 +776,7 @@ interpret_again:
 		}		// if interp len is less than max
 }
 
-static void mdi_execute_abort(void)
+void mdi_execute_abort(void)
 {
     int queued_mdi_commands;
 
@@ -3097,6 +3097,9 @@ static int emcTaskIssueCommand(NMLmsg * cmd)
 	break;
 
     case EMC_TASK_PLAN_INIT_TYPE:
+	// re-initializing the interpreter drops any call an interrupted MDI
+	// command is still inside of
+	mdi_execute_abort();
 	retval = emcTaskPlanInit();
 	if (retval > INTERP_MIN_ERROR) {
 	    retval = -1;
